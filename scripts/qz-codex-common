#!/usr/bin/env bash

QZ_CODEX_COMMON_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
source "$QZ_CODEX_COMMON_DIR/qz-env"

_qz_http_bootstrap() {
  # HTTP bootstrap: fetch model catalog and client config from the QuantZhai proxy,
  # then write a local CODEX_HOME config.toml and model catalog JSON file.
  #
  # This is the only bootstrap path — for localhost and remote hosts alike.
  # QZ_CODEX_REMOTE is no longer required; HTTP is always used.
  #
  # Requirements:
  #   QZ_PROXY_HOST / QZ_PROXY_PORT — proxy address (127.0.0.1 for local)
  #   CODEX_HOME (optional)         — defaults to $HOME/.qz-codex/codex-home
  #
  # Never writes API key values; env_key field is the key NAME only.
  # Catalog write is atomic: temp file + mv, no replacement on error.
  # qz-codex does not call POST /qz/models/refresh — it is a read-only client.

  local proxy_url="http://$QZ_PROXY_HOST:$QZ_PROXY_PORT"

  # 1. Fetch /qz/codex/client-config
  local _cfg_body
  if ! _cfg_body=$(curl -fsS "$proxy_url/qz/codex/client-config" 2>/dev/null); then
    printf 'qz-codex: QuantZhai appears to be down.\n' >&2
    printf '  Tried: %s/qz/codex/client-config\n' "$proxy_url" >&2
    printf '  Start the QuantZhai proxy/service, then retry.\n' >&2
    return 1
  fi

  # 2. Parse and validate; extract fields as tab-separated values.
  #    The last field is a "stale" flag (1/0) used to decide if we should
  #    POST /qz/codex/model-catalog/refresh before downloading.
  local _fields
  _fields=$(printf '%s' "$_cfg_body" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    if not d.get('ok'):
        print('ERROR: server ok=false', file=sys.stderr); sys.exit(1)
    if d.get('schema') != 'qz.codex.client_config.v1':
        print('ERROR: unexpected schema', file=sys.stderr); sys.exit(1)
    p = d.get('provider', {})
    mc = d.get('model_catalog', {})
    freshness = mc.get('freshness') or {}
    stale_flag = '1' if freshness.get('stale') else '0'
    refresh_url = mc.get('refresh_url', '')
    vals = [
        d.get('model_provider', ''),
        p.get('name', ''),
        p.get('base_url', ''),
        p.get('wire_api', ''),
        p.get('env_key', ''),
        mc.get('url', ''),
        mc.get('local_filename', 'qwenzhai-models.json'),
        stale_flag,
        refresh_url,
    ]
    if not all([vals[0], vals[2], vals[5]]):
        print('ERROR: missing required fields', file=sys.stderr); sys.exit(1)
    print('\t'.join(vals))
except json.JSONDecodeError:
    print('ERROR: invalid JSON response', file=sys.stderr); sys.exit(1)
" 2>&1) || {
    printf 'qz-codex: client config parse error: %s\n' "${_fields#ERROR: }" >&2
    return 1
  }
  if [[ "$_fields" == ERROR:* ]]; then
    printf 'qz-codex: client config error: %s\n' "${_fields#ERROR: }" >&2
    return 1
  fi

  local _model_provider _provider_name _base_url _wire_api _env_key _catalog_url _catalog_filename _stale_flag _refresh_url
  IFS=$'\t' read -r _model_provider _provider_name _base_url _wire_api _env_key _catalog_url _catalog_filename _stale_flag _refresh_url \
    <<< "$_fields"

  # 2a. If the server-side generated catalog is stale and auto-refresh is
  # enabled, POST the explicit refresh endpoint and re-fetch client-config.
  # QZ_CODEX_REFRESH_CATALOG defaults to 1; set 0 to suppress.  Catalog
  # refresh is metadata-only — it does not call backend select/restart.
  local _auto_refresh="${QZ_CODEX_REFRESH_CATALOG:-1}"
  if [[ "$_stale_flag" == "1" && "$_auto_refresh" == "1" ]]; then
    if [[ -n "$_refresh_url" ]]; then
      if ! curl -fsS -X POST -H 'Content-Type: application/json' -d '{}' "$_refresh_url" -o /dev/null 2>/dev/null; then
        printf 'qz-codex: warning: catalog refresh POST failed; continuing with stale catalog.\n' >&2
        printf '  Tried: %s\n' "$_refresh_url" >&2
      else
        # Re-fetch client-config so the catalog mtime/sha update propagate.
        _cfg_body=$(curl -fsS "$proxy_url/qz/codex/client-config" 2>/dev/null) || true
      fi
    fi
  fi

  # 3. Resolve CODEX_HOME — client-local state, never server var/codex-home
  if [[ -z "${CODEX_HOME:-}" ]]; then
    CODEX_HOME="$HOME/.qz-codex/codex-home"
  fi
  mkdir -p "$CODEX_HOME/model-catalogs" "$CODEX_HOME/sqlite"

  # 4. Fetch model catalog (atomic: write to temp file, validate, then mv)
  local _catalog_file="$CODEX_HOME/model-catalogs/$_catalog_filename"
  local _catalog_tmp="${_catalog_file}.tmp.$$"

  if ! curl -fsS "$_catalog_url" -o "$_catalog_tmp" 2>/dev/null; then
    rm -f "$_catalog_tmp"
    printf 'qz-codex: The Codex model catalog is not available on the QuantZhai server.\n' >&2
    printf '  Tried: %s\n' "$_catalog_url" >&2
    printf '  Run: curl -X POST %s/qz/models/refresh\n' "$proxy_url" >&2
    printf '  Then retry.\n' >&2
    return 1
  fi

  if ! python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sys.exit(0 if isinstance(d, dict) else 1)
except Exception:
    sys.exit(1)
" "$_catalog_tmp" 2>/dev/null; then
    rm -f "$_catalog_tmp"
    printf 'qz-codex: fetched catalog is not a valid JSON object; not replacing existing catalog\n' >&2
    return 1
  fi

  mv "$_catalog_tmp" "$_catalog_file"

  # 5. Write/patch local config.toml with server values (atomic write).
  #    Only env_key name is written; never the key value.
  #    Values are TOML-safe escaped via json.dumps (handles quotes, backslashes, etc.).
  local _config_toml="$CODEX_HOME/config.toml"
  local _config_toml_tmp="${_config_toml}.tmp.$$"

  if [[ -f "$_config_toml" && ! -f "${_config_toml}.pre-qz-remote.bak" ]]; then
    cp "$_config_toml" "${_config_toml}.pre-qz-remote.bak"
  fi

  if ! python3 - "$_config_toml" "$_config_toml_tmp" \
      "$_model_provider" "$_provider_name" "$_base_url" \
      "$_wire_api" "$_env_key" "$_catalog_file" <<'PY'
import json, re, sys
from pathlib import Path

def toml_str(s):
    # json.dumps produces TOML-safe double-quoted strings: backslash and
    # double-quote are escaped; control characters are escaped.
    return json.dumps(str(s))

src         = Path(sys.argv[1])  # existing config.toml to read (may not exist)
dst_tmp     = Path(sys.argv[2])  # temp file to write (bash will mv to final path)
provider    = sys.argv[3]
name        = sys.argv[4]
base_url    = sys.argv[5]
wire_api    = sys.argv[6]
env_key     = sys.argv[7]        # key NAME only — never the key value
catalog     = sys.argv[8]

existing = ""
if src.is_file():
    try:
        existing = src.read_text(encoding="utf-8")
    except Exception:
        existing = ""

# Remove managed top-level keys we will rewrite
existing = re.sub(r'^\s*(model_provider|model_catalog_json)\s*=\s*.*$\n?', '', existing, flags=re.MULTILINE).strip()

# Remove any existing [model_providers.<provider>] block we manage
existing = re.sub(
    r'\[model_providers\.' + re.escape(provider) + r'\].*?(?=\[|\Z)',
    '', existing, flags=re.DOTALL,
).strip()

header = f'model_provider = {toml_str(provider)}\nmodel_catalog_json = {toml_str(catalog)}\n'
block  = (
    f'\n[model_providers.{provider}]\n'
    f'name = {toml_str(name)}\n'
    f'base_url = {toml_str(base_url)}\n'
    f'wire_api = {toml_str(wire_api)}\n'
    f'env_key = {toml_str(env_key)}\n'
)

parts = [header]
if existing:
    parts.append('\n' + existing)
parts.append(block)

dst_tmp.parent.mkdir(parents=True, exist_ok=True)
dst_tmp.write_text(''.join(parts).rstrip('\n') + '\n', encoding='utf-8')
PY
  then
    rm -f "$_config_toml_tmp"
    printf 'qz-codex: failed to generate config.toml content\n' >&2
    return 1
  fi

  if ! mv "$_config_toml_tmp" "$_config_toml" 2>/dev/null; then
    rm -f "$_config_toml_tmp"
    printf 'qz-codex: failed to install config.toml\n' >&2
    return 1
  fi

  # 6. Export env vars for the Codex CLI launcher
  export CODEX_HOME
  export CODEX_SQLITE_HOME="$CODEX_HOME/sqlite"
  export CODEX_OSS_BASE_URL="http://$QZ_PROXY_HOST:$QZ_PROXY_PORT"
  export LOCAL_QWEN_API_KEY="${LOCAL_QWEN_API_KEY:-local}"
  export QZ_CODEX_MODEL_PROVIDER="${QZ_CODEX_MODEL_PROVIDER:-$_model_provider}"
}

qz_prepare_codex_home() {
  # qz-codex always bootstraps via HTTP from the QuantZhai proxy.
  # QuantZhai proxy is the authority; qz-codex is a read-only client launcher.
  # QZ_CODEX_REMOTE is no longer required — HTTP is always the path.
  _qz_http_bootstrap
  return $?
}

qz_resolve_codex_profile() {
  local profile="${1:-medium}"
  # Use the model currently loaded in the proxy so the benchmark always
  # targets whatever is actually running, not a hardcoded slug.
  QZ_CODEX_MODEL="$(qz_proxy_loaded_model)"
  if [[ -z "$QZ_CODEX_MODEL" ]]; then
    QZ_CODEX_MODEL="Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-IQ4_NL"
  fi
  QZ_CODEX_EXTRA_ARGS=()
  if [[ -n "${QZ_CODEX_MODEL_PROVIDER:-}" ]]; then
    QZ_CODEX_EXTRA_ARGS+=(-c "model_provider=\"$QZ_CODEX_MODEL_PROVIDER\"")
  fi
  # Profile names are reasoning effort levels on the loaded model.
  case "$profile" in
    low|medium|high|xhigh) QZ_CODEX_EXTRA_ARGS+=(-c "model_reasoning_effort=\"$profile\"") ;;
    *) QZ_CODEX_EXTRA_ARGS+=(-c "model_reasoning_effort=\"medium\"") ;;
  esac
  export QZ_CODEX_MODEL
}

qz_exec_model_from_args() {
  # Extract the model value from exec subcommand arguments.
  # Handles: -m MODEL, --model MODEL, --model=MODEL, -p PROFILE, --profile=PROFILE
  local pending=0
  for arg in "$@"; do
    if [[ "$pending" -eq 1 ]]; then
      printf '%s' "$arg"
      return 0
    fi
    case "$arg" in
      -m|--model|-p|--profile) pending=1 ;;
      --model=*)               printf '%s' "${arg#--model=}"; return 0 ;;
      --profile=*)             printf '%s' "${arg#--profile=}"; return 0 ;;
      --)                      return 0 ;;
    esac
  done
  return 0
}

qz_codex_exec_preflight() {
  # Args: REQUESTED
  # Returns:
  #   0 — requested matches active backend model; proceed
  #   1 — mismatch and auto-select disabled (error printed)
  #   2 — auto-select attempted but failed or returned mismatch
  #   3 — proxy unreachable / /qz/model/status fetch failed
  #
  # When QZ_CODEX_AUTO_SELECT_MODEL=1 and there is a mismatch, POSTs
  # /qz/model/select-and-restart with source=qz_codex and re-checks before
  # returning.  No fallback to /v1/models visibility-only logic.
  local requested="$1"
  local autoselect="${QZ_CODEX_AUTO_SELECT_MODEL:-0}"
  local timeout="${QZ_CODEX_READY_TIMEOUT:-300}"
  REQUESTED="$requested" AUTOSELECT="$autoselect" READY_TIMEOUT="$timeout" \
    python3 - "$QZ_PROXY_HOST" "$QZ_PROXY_PORT" <<'PY'
import json, os, sys, urllib.request, urllib.error

host = sys.argv[1]
port = sys.argv[2]
requested = (os.environ.get("REQUESTED") or "").strip()
autoselect = (os.environ.get("AUTOSELECT") or "").strip().lower() in ("1", "true", "yes", "on")
try:
    timeout = float(os.environ.get("READY_TIMEOUT") or "300")
except Exception:
    timeout = 300.0


def fetch_status():
    url = "http://{}:{}/qz/model/status".format(host, port)
    try:
        with urllib.request.urlopen(url, timeout=3.0) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception as exc:
        print("qz-codex: GET /qz/model/status failed: {}".format(exc), file=sys.stderr)
        return None


def active_match(data, req):
    if not isinstance(data, dict):
        return False
    if data.get("selected_model_ready") is not True:
        return False
    loaded = (data.get("backend_loaded_model") or "").strip()
    sk = (data.get("selected_key") or "").strip()
    sbid = (data.get("selected_backend_id") or "").strip()
    mismatch = bool(data.get("selected_loaded_mismatch", False))
    candidates = set()
    if loaded:
        candidates.add(loaded.lower())
    if not mismatch:
        if sk:
            candidates.add(sk.lower())
        if sbid:
            candidates.add(sbid.lower())
    return req.lower() in candidates


def print_mismatch(data, req):
    selected = ""
    loaded = ""
    source = ""
    ready = False
    admission = ""
    if isinstance(data, dict):
        selected = data.get("selected_key") or data.get("selected_backend_id") or ""
        loaded = data.get("backend_loaded_model") or ""
        source = data.get("selected_source") or ""
        ready = data.get("selected_model_ready")
        admission = data.get("request_admission_state") or ""
    selected = selected or "<none>"
    loaded = loaded or "<none>"
    source = source or "<none>"
    e = sys.stderr
    print("qz-codex: requested model {} is not the active backend model.".format(req), file=e)
    print("  Active selected model: {}".format(selected), file=e)
    print("  Backend loaded model:  {}".format(loaded), file=e)
    print("  Selected source:       {}".format(source), file=e)
    print("  Selected ready:        {}".format(ready), file=e)
    if admission:
        print("  Admission state:       {}".format(admission), file=e)
    print("", file=e)
    print("Set QZ_CODEX_AUTO_SELECT_MODEL=1 to let qz-codex select/restart automatically,", file=e)
    print("or call the proxy endpoint manually:", file=e)
    print("  curl -sS -X POST -H 'Content-Type: application/json' \\", file=e)
    body = json.dumps({"model": req}, separators=(",", ":"))
    print("       -d '{}' \\".format(body), file=e)
    print("       http://{}:{}/qz/model/select-and-restart".format(host, port), file=e)


def print_failure_detail(data, req):
    """Print classified failure context + rollback info to stderr."""
    if not isinstance(data, dict):
        return
    e = sys.stderr
    last_result = data.get("last_load_result") or ""
    last_error = data.get("last_load_error") or ""
    last_error_type = data.get("last_load_error_type") or ""
    failed_candidate = (
        data.get("failed_candidate_key")
        or data.get("failed_candidate_backend_id")
        or ""
    )
    last_good = data.get("last_good_key") or data.get("last_good_backend_id") or ""
    rollback = bool(data.get("rollback_performed"))
    if last_result == "failed":
        print("qz-codex: requested model failed to load.", file=e)
        if last_error_type:
            print("  last_load_error_type: {}".format(last_error_type), file=e)
        if failed_candidate:
            print("  failed_candidate:     {}".format(failed_candidate), file=e)
        if last_error:
            print("  last_load_error:      {}".format(last_error), file=e)
        if rollback and last_good:
            print("  rolled back to last_good: {}".format(last_good), file=e)
        elif last_good:
            print("  last_good (available): {}".format(last_good), file=e)
        else:
            print("  last_good:            <none — pick a smaller model and retry>", file=e)
        rec = data.get("recommended_recovery_action")
        if rec:
            print("  recommended_recovery_action: {}".format(rec), file=e)


def post_select_and_restart(req):
    url = "http://{}:{}/qz/model/select-and-restart".format(host, port)
    payload = json.dumps({"model": req, "source": "qz_codex"}).encode("utf-8")
    request_obj = urllib.request.Request(
        url,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request_obj, timeout=timeout) as response:
            raw = response.read().decode("utf-8")
            return json.loads(raw), response.status, None
    except urllib.error.HTTPError as exc:
        try:
            data = json.loads(exc.read().decode("utf-8"))
        except Exception:
            data = None
        return data, exc.code, str(exc)
    except Exception as exc:
        return None, None, str(exc)


data = fetch_status()
if data is None:
    sys.exit(3)

if active_match(data, requested):
    sys.exit(0)

if not autoselect:
    print_mismatch(data, requested)
    sys.exit(1)

print("qz-codex: QZ_CODEX_AUTO_SELECT_MODEL=1; posting /qz/model/select-and-restart for {}".format(requested), file=sys.stderr)
new_data, status, err = post_select_and_restart(requested)
if status is None or (isinstance(status, int) and status >= 400) or new_data is None:
    msg = err or ((new_data or {}).get("error") if isinstance(new_data, dict) else None) or "unknown"
    print("qz-codex: /qz/model/select-and-restart failed (HTTP {}): {}".format(status, msg), file=sys.stderr)
    if isinstance(new_data, dict):
        print_failure_detail(new_data, requested)
    sys.exit(2)

if not isinstance(new_data, dict):
    print("qz-codex: /qz/model/select-and-restart returned unexpected response (HTTP {})".format(status), file=sys.stderr)
    sys.exit(2)

if active_match(new_data, requested):
    sys.exit(0)

print("qz-codex: /qz/model/select-and-restart returned but {} is still not the active model.".format(requested), file=sys.stderr)
print_failure_detail(new_data, requested)
print_mismatch(new_data, requested)
sys.exit(2)
PY
}

qz_proxy_loaded_model() {
  # Primary truth source: /qz/control-plane (qz.control_plane.status.v1).
  # Prefers Codex-visible profile ID (models.selected) over backend identity.
  # Falls back to /qz/status parser if control-plane is unavailable or schema mismatch.
  python3 - "$QZ_PROXY_HOST" "$QZ_PROXY_PORT" <<'PY'
import json
import sys
import urllib.request

host, port = sys.argv[1], sys.argv[2]

# --- Primary: /qz/control-plane ---
url = "http://{}:{}/qz/control-plane".format(host, port)
try:
    with urllib.request.urlopen(url, timeout=2.0) as response:
        payload = json.loads(response.read().decode("utf-8"))
    if isinstance(payload, dict) and payload.get("schema") == "qz.control_plane.status.v1":
        m = payload.get("models") or {}
        b = payload.get("backend") or {}
        # A. Codex-visible model/profile identity
        for key in ("selected", "selected_backend_id"):
            value = m.get(key)
            if isinstance(value, str) and value.strip():
                print(value.strip())
                sys.exit(0)
        # B. Backend loaded model as last resort
        loaded = b.get("loaded_model")
        if isinstance(loaded, str) and loaded.strip():
            print(loaded.strip())
            sys.exit(0)
        sys.exit(0)  # control-plane responded; no value to print
except Exception:
    pass  # fall through to legacy path

# --- Legacy fallback: /qz/status ---
url = "http://{}:{}/qz/status".format(host, port)
try:
    with urllib.request.urlopen(url, timeout=2.0) as response:
        payload = json.loads(response.read().decode("utf-8"))
except Exception:
    sys.exit(0)

backend = payload.get("backend") if isinstance(payload, dict) else {}
if not isinstance(backend, dict):
    sys.exit(0)

for key in ("selected_key", "selected_backend_id", "loaded_model"):
    value = backend.get(key)
    if isinstance(value, str) and value.strip():
        print(value.strip())
        break
PY
}
