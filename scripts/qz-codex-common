#!/usr/bin/env bash

QZ_CODEX_COMMON_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
source "$QZ_CODEX_COMMON_DIR/qz-env"

qz_prepare_codex_home() {
  mkdir -p \
    "$QZ_VAR_DIR/codex-home/model-catalogs" \
    "$QZ_VAR_DIR/codex-home/sqlite" \
    "$QZ_VAR_DIR/logs" \
    "$QZ_VAR_DIR/run" \
    "$QZ_VAR_DIR/captures" \
    "$QZ_VAR_DIR/benchmarks"

  if [[ ! -f "$QZ_ROOT/var/codex-home/config.toml" ]]; then
    cp "$QZ_ROOT/config/example/codex-config.toml" "$QZ_ROOT/var/codex-home/config.toml"
  fi

  # The proxy is the sole authority for model/catalog state.
  # POST /qz/models/refresh triggers the proxy to rescan models and regenerate
  # the Codex catalog file. qz-codex requires a reachable QuantZhai proxy;
  # there is no local scan fallback.
  local proxy_url="http://$QZ_PROXY_HOST:$QZ_PROXY_PORT"
  local _refresh_body
  if _refresh_body=$(curl -fsS -X POST "$proxy_url/qz/models/refresh" 2>/dev/null); then
    # Parse proxy-owned response to confirm the catalog artifact was updated.
    # Rules (in priority order):
    #   new schema: ok==true AND catalog_updated==true  -> success
    #   new schema: ok==true AND catalog_updated==false -> failure (artifact not regenerated)
    #   new schema: ok==false                           -> failure
    #   compat:     codex_catalog_updated==true         -> success (pre-slice-4 response)
    #   old format: HTTP 200 without any schema fields  -> treat as success (backwards compat)
    local _catalog_ok
    _catalog_ok=$(printf '%s' "$_refresh_body" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    # New schema: require both ok==true and catalog_updated==true.
    if 'catalog_updated' in d:
        ok = d.get('ok', True)
        updated = d.get('catalog_updated', False)
        print('true' if (ok and updated) else 'false')
    elif 'ok' in d:
        # ok present but no catalog_updated: check compat field
        ok = d['ok']
        updated = bool(d.get('codex_catalog_updated', False))
        print('true' if (ok and updated) else 'false')
    elif 'codex_catalog_updated' in d:
        # Pre-slice-4 response: only codex_catalog_updated available
        print('true' if d['codex_catalog_updated'] else 'false')
    else:
        # Unknown old format: HTTP 200 assumed success for backwards compat
        print('true')
except Exception:
    print('true')
" 2>/dev/null || echo true)
    if [[ "$_catalog_ok" != "true" ]]; then
      local _err
      _err=$(printf '%s' "$_refresh_body" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    parts = [p for p in [d.get('error'), d.get('reason')] if p]
    if not parts:
        if 'catalog_updated' in d and not d.get('catalog_updated'):
            parts = ['Codex catalog file was not regenerated']
    print(', '.join(parts) if parts else 'catalog refresh failed')
except Exception:
    print('catalog refresh failed')
" 2>/dev/null || echo "catalog refresh failed")
      printf 'qz-codex: proxy catalog refresh failed: %s\n' "$_err" >&2
      return 1
    fi
    : # proxy owns catalog; continue
  else
    printf 'qz-codex: proxy catalog refresh failed.\n' >&2
    printf '\n' >&2
    printf '  qz-codex requires a reachable QuantZhai proxy to own model/catalog state.\n' >&2
    printf '  POST %s/qz/models/refresh did not succeed.\n' "$proxy_url" >&2
    printf '\n' >&2
    printf '  Solutions:\n' >&2
    printf '    Start the proxy:  scripts/qz-proxy\n' >&2
    printf '    Start the stack:  scripts/qz-up\n' >&2
    printf '\n' >&2
    printf '  qz-codex does not need to run on the same machine as llama.cpp,\n' >&2
    printf '  but it does need a reachable QuantZhai proxy at:\n' >&2
    printf '    %s\n' "$proxy_url" >&2
    printf '\n' >&2
    # Show compact control-plane facts to help diagnose the issue.
    python3 - "$QZ_PROXY_HOST" "$QZ_PROXY_PORT" <<'PY' >&2 2>/dev/null || true
import json, sys, urllib.request
host, port = sys.argv[1], sys.argv[2]
url = "http://{}:{}/qz/control-plane".format(host, port)
try:
    with urllib.request.urlopen(url, timeout=2.0) as r:
        d = json.loads(r.read().decode())
    if not isinstance(d, dict) or d.get("schema") != "qz.control_plane.status.v1":
        print("  /qz/control-plane: unexpected response (old proxy?)")
        sys.exit(0)
    ri = d.get("readiness", {})
    m = d.get("models", {})
    hints = d.get("operator_hints", [])
    print("  /qz/control-plane: proxy_ready={}  catalog_ready={}  models={}  backend_reachable={}".format(
        ri.get("proxy_ready"), ri.get("catalog_ready"),
        m.get("count", 0), ri.get("backend_reachable")))
    for hint in hints[:1]:
        print("  hint: " + str(hint)[:100])
except Exception as e:
    print("  /qz/control-plane: unreachable ({})".format(e))
PY
    printf '\n' >&2
    return 1
  fi

  export CODEX_HOME="$QZ_ROOT/var/codex-home"
  export CODEX_SQLITE_HOME="$CODEX_HOME/sqlite"
  export CODEX_OSS_BASE_URL="http://$QZ_PROXY_HOST:$QZ_PROXY_PORT"
  export LOCAL_QWEN_API_KEY="${LOCAL_QWEN_API_KEY:-local}"

  QZ_CODEX_MODEL_PROVIDER="${QZ_CODEX_MODEL_PROVIDER:-$(python3 - "$QZ_ROOT/var/codex-home/config.toml" <<'PY'
import re
import sys
from pathlib import Path

for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    if line.lstrip().startswith("["):
        break
    match = re.match(r'\s*model_provider\s*=\s*"([^"]+)"', line)
    if match:
        print(match.group(1))
        break
PY
)}"
  export QZ_CODEX_MODEL_PROVIDER
}

qz_resolve_codex_profile() {
  local profile="${1:-medium}"
  # Use the model currently loaded in the proxy so the benchmark always
  # targets whatever is actually running, not a hardcoded slug.
  QZ_CODEX_MODEL="$(qz_proxy_loaded_model)"
  if [[ -z "$QZ_CODEX_MODEL" ]]; then
    QZ_CODEX_MODEL="Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-IQ4_NL"
  fi
  QZ_CODEX_EXTRA_ARGS=()
  if [[ -n "${QZ_CODEX_MODEL_PROVIDER:-}" ]]; then
    QZ_CODEX_EXTRA_ARGS+=(-c "model_provider=\"$QZ_CODEX_MODEL_PROVIDER\"")
  fi
  # Profile names are reasoning effort levels on the loaded model.
  case "$profile" in
    low|medium|high|xhigh) QZ_CODEX_EXTRA_ARGS+=(-c "model_reasoning_effort=\"$profile\"") ;;
    *) QZ_CODEX_EXTRA_ARGS+=(-c "model_reasoning_effort=\"medium\"") ;;
  esac
  export QZ_CODEX_MODEL
}

qz_exec_model_from_args() {
  # Extract the model value from exec subcommand arguments.
  # Handles: -m MODEL, --model MODEL, --model=MODEL, -p PROFILE, --profile=PROFILE
  local pending=0
  for arg in "$@"; do
    if [[ "$pending" -eq 1 ]]; then
      printf '%s' "$arg"
      return 0
    fi
    case "$arg" in
      -m|--model|-p|--profile) pending=1 ;;
      --model=*)               printf '%s' "${arg#--model=}"; return 0 ;;
      --profile=*)             printf '%s' "${arg#--profile=}"; return 0 ;;
      --)                      return 0 ;;
    esac
  done
  return 0
}

qz_proxy_loaded_model() {
  # Primary truth source: /qz/control-plane (qz.control_plane.status.v1).
  # Prefers Codex-visible profile ID (models.selected) over backend identity.
  # Falls back to /qz/status parser if control-plane is unavailable or schema mismatch.
  python3 - "$QZ_PROXY_HOST" "$QZ_PROXY_PORT" <<'PY'
import json
import sys
import urllib.request

host, port = sys.argv[1], sys.argv[2]

# --- Primary: /qz/control-plane ---
url = "http://{}:{}/qz/control-plane".format(host, port)
try:
    with urllib.request.urlopen(url, timeout=2.0) as response:
        payload = json.loads(response.read().decode("utf-8"))
    if isinstance(payload, dict) and payload.get("schema") == "qz.control_plane.status.v1":
        m = payload.get("models") or {}
        b = payload.get("backend") or {}
        # A. Codex-visible model/profile identity
        for key in ("selected", "selected_backend_id"):
            value = m.get(key)
            if isinstance(value, str) and value.strip():
                print(value.strip())
                sys.exit(0)
        # B. Backend loaded model as last resort
        loaded = b.get("loaded_model")
        if isinstance(loaded, str) and loaded.strip():
            print(loaded.strip())
            sys.exit(0)
        sys.exit(0)  # control-plane responded; no value to print
except Exception:
    pass  # fall through to legacy path

# --- Legacy fallback: /qz/status ---
url = "http://{}:{}/qz/status".format(host, port)
try:
    with urllib.request.urlopen(url, timeout=2.0) as response:
        payload = json.loads(response.read().decode("utf-8"))
except Exception:
    sys.exit(0)

backend = payload.get("backend") if isinstance(payload, dict) else {}
if not isinstance(backend, dict):
    sys.exit(0)

for key in ("selected_key", "selected_backend_id", "loaded_model"):
    value = backend.get(key)
    if isinstance(value, str) and value.strip():
        print(value.strip())
        break
PY
}
