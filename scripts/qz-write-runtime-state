#!/usr/bin/env python3
"""Record a QuantZhai launcher event to the OperationalStore.

Called by scripts/qz-up at each startup phase
(requested, backend-started, proxy-started, backend-healthy, etc.).

The legacy var/run/qz-runtime-state.json file is no longer written.
Runtime status authority: GET /qz/control-plane
Startup event history:    GET /qz/config/effective (operational_store section)
"""

import argparse
import json
import os
import sys
import time
import urllib.request
from pathlib import Path
from typing import Any

_REPO_ROOT = Path(__file__).resolve().parents[1]
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))
try:
    from proxy.qz_operational_store import OperationalStore as _OperationalStore
    _STORE_CLS = _OperationalStore
except ImportError:
    _STORE_CLS = None  # type: ignore


SCHEMA = 1


def parse_context(value: Any, default: int | None = None) -> int | None:
    if value is None or isinstance(value, bool):
        return default
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        return int(value)
    text = str(value).strip().lower()
    if not text:
        return default
    multiplier = 1
    if text.endswith("k"):
        multiplier = 1024
        text = text[:-1]
    elif text.endswith("m"):
        multiplier = 1024 * 1024
        text = text[:-1]
    elif text.endswith("g"):
        multiplier = 1024 * 1024 * 1024
        text = text[:-1]
    try:
        return int(float(text) * multiplier)
    except Exception:
        return default


def env_int(name: str, default: int | None = None) -> int | None:
    return parse_context(os.environ.get(name), default)


def fetch_json(url: str, timeout: float = 1.0) -> dict[str, Any]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            data = json.loads(response.read().decode("utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def proxy_base_url() -> str:
    host = os.environ.get("QZ_PROXY_HOST", "127.0.0.1")
    port = os.environ.get("QZ_PROXY_PORT", "18180")
    return f"http://{host}:{port}"


def _get_previous_model_from_store() -> str:
    """Read the last effective_model from OperationalStore, or '' on any failure."""
    if _STORE_CLS is None:
        return ""
    try:
        store = _STORE_CLS.from_env()
        if not store.enabled:
            return ""
        if not store.init():
            return ""
        fact = store.get_runtime_fact("effective_model")
        store.close()
        if isinstance(fact, dict):
            return fact.get("model", "") or ""
    except Exception:
        pass
    return ""


def base_state(phase: str, source: str) -> dict[str, Any]:
    context = env_int("QZ_CONTEXT", 262144)
    return {
        "schema": SCHEMA,
        "phase": phase,
        "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "updated_ts": time.time(),
        "source": {
            "context": source,
            "model": "env",
            "backend": "env",
        },
        "requested": {
            "profile": os.environ.get("QZ_PROFILE", ""),
            "model": os.environ.get("QZ_MODEL_KEY", ""),
            "context": context,
        },
        "effective": {
            "model": os.environ.get("QZ_MODEL_KEY", ""),
            "context": context,
            "parallel": env_int("QZ_PARALLEL"),
            "batch": env_int("QZ_BATCH"),
            "ubatch": env_int("QZ_UBATCH"),
            "threads": env_int("QZ_THREADS"),
            "thread_batch": env_int("QZ_THREAD_BATCH"),
            "tensor_split": os.environ.get("QZ_TENSOR_SPLIT", ""),
            "main_gpu": os.environ.get("QZ_MAIN_GPU", ""),
            "cache_ram_mib": env_int("QZ_CACHE_RAM"),
            "cache_reuse": env_int("QZ_CACHE_REUSE"),
            "kv_key": os.environ.get("QZ_KV_KEY", ""),
            "kv_value": os.environ.get("QZ_KV_VALUE", ""),
            "reasoning_budget": env_int("QZ_REASONING_BUDGET"),
        },
        "backend": {
            "url": f"http://{os.environ.get('QZ_SERVER_HOST', '127.0.0.1')}:{os.environ.get('QZ_SERVER_PORT', '18084')}",
            "healthy": False,
            "loaded": False,
            "loaded_model": "",
            "load_state": "unconfirmed",
            "health_status": None,
        },
        "proxy": {
            "url": proxy_base_url(),
            "healthy": False,
        },
        "notes": [],
    }


def merge_proxy_status(state: dict[str, Any]) -> None:
    status = fetch_json(proxy_base_url() + "/qz/status", timeout=3.0)
    if not status:
        status = fetch_json(proxy_base_url() + "/qz/telemetry/state", timeout=1.0)
    if not status:
        return

    state.setdefault("proxy", {})["healthy"] = True
    state["source"]["proxy"] = "proxy"

    runtime = status.get("runtime") if isinstance(status.get("runtime"), dict) else status
    backend = status.get("backend") if isinstance(status.get("backend"), dict) else {}
    load = status.get("load") if isinstance(status.get("load"), dict) else {}

    selected_value = runtime.get("selected")
    selected = ""
    if isinstance(selected_value, dict):
        selected = (
            selected_value.get("key")
            or selected_value.get("backend_id")
            or selected_value.get("filename")
            or ""
        )
    elif selected_value:
        selected = str(selected_value)
    selected = (
        selected
        or runtime.get("selected_backend_id")
        or backend.get("selected_key")
        or backend.get("selected_backend_id")
        or ""
    )
    if selected:
        state["effective"]["model"] = selected
        state["source"]["model"] = "proxy"

    context = parse_context(
        runtime.get("backend_context_length")
        or backend.get("backend_context_length")
        or runtime.get("selected_context_length")
        or backend.get("selected_context_length"),
        None,
    )
    if context:
        state["effective"]["context"] = context
        state["source"]["context"] = "proxy"

    loaded = runtime.get("loaded_model") or backend.get("loaded_model") or ""
    loaded_count = runtime.get("loaded_count") or backend.get("loaded_count") or 0
    load_state = runtime.get("load_state") or load.get("state") or backend.get("selected_state") or "unknown"
    health_status = runtime.get("health_status")
    if health_status is None and isinstance(status.get("health"), dict):
        health_status = status["health"].get("status")

    state["backend"].update({
        "healthy": health_status == 200 or bool(runtime.get("ready")) or bool(status.get("ready")),
        "loaded": bool(loaded) or load_state in {"ready", "loaded"},
        "loaded_model": loaded,
        "loaded_count": loaded_count,
        "load_state": load_state,
        "health_status": health_status,
    })


def _write_to_store(state: dict[str, Any]) -> None:
    """Write runtime event + facts to OperationalStore.

    Non-fatal: any failure is silently swallowed.
    When disabled, this is a complete no-op.
    """
    if _STORE_CLS is None:
        return
    try:
        store = _STORE_CLS.from_env()
        if not store.enabled:
            return
        if not store.init():
            return
        phase = state.get("phase", "unknown")
        store.record_startup_event(
            phase=phase,
            payload=state,
            source="launcher",
        )
        eff = state.get("effective") or {}
        req = state.get("requested") or {}
        backend = state.get("backend") or {}
        proxy_ = state.get("proxy") or {}
        for key, value in (
            ("current_phase",   {"phase": phase}),
            ("requested_model", {"model": req.get("model", ""), "profile": req.get("profile", ""), "context": req.get("context")}),
            ("effective_model", {"model": eff.get("model", ""), "context": eff.get("context")}),
            ("backend_status",  {"url": backend.get("url", ""), "healthy": bool(backend.get("healthy")), "loaded": bool(backend.get("loaded")), "loaded_model": backend.get("loaded_model", "")}),
            ("proxy_status",    {"url": proxy_.get("url", ""), "healthy": bool(proxy_.get("healthy"))}),
        ):
            store.record_runtime_fact(key, value, provenance="launcher")
        store.close()
    except Exception:
        pass


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Record a QuantZhai launcher event to the OperationalStore. "
            "Runtime status: GET /qz/control-plane. "
            "Event history: GET /qz/config/effective (operational_store section)."
        )
    )
    parser.add_argument("--phase", default="manual", help="startup phase label")
    parser.add_argument("--source", default="env", help="source label for requested values")
    parser.add_argument("--merge-proxy", action="store_true", help="merge live proxy status when reachable")
    parser.add_argument("--backend-healthy", action="store_true", help="mark backend health as confirmed")
    parser.add_argument("--proxy-healthy", action="store_true", help="mark proxy health as confirmed")
    parser.add_argument("--print", dest="print_state", action="store_true", help="print state dict")
    args = parser.parse_args()

    state = base_state(args.phase, args.source)
    if args.backend_healthy:
        state["backend"]["healthy"] = True
        state["backend"]["health_status"] = 200
        state["source"]["backend"] = "health"
    if args.proxy_healthy:
        state["proxy"]["healthy"] = True
    if args.merge_proxy:
        merge_proxy_status(state)

    # Carry forward effective model from OperationalStore when env doesn't provide one.
    if state["effective"].get("model") in (None, ""):
        old_model = _get_previous_model_from_store()
        if old_model:
            state["effective"]["model"] = old_model
            state["source"]["model"] = "previous"

    _write_to_store(state)

    if args.print_state:
        print(json.dumps(state, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
