#!/usr/bin/env python3
"""Operator review CLI for BrainCase candidate StateRecords.

Commands:
  list                     List candidate records awaiting review.
  inspect <id>             Show full details of a record.
  promote <id>             Promote a candidate to active/renderable (or active/internal).
  reject <id>              Retire a candidate as rejected.
  retention-report         Dry-run retention policy evaluation (no DB writes).
  prune --dry-run          Alias for retention-report filtered to retire candidates.

Promotion is NOT model-facing. Only the operator can promote candidates.
No model tool can call these commands.
retention-report and prune --dry-run are read-only (no DB mutation).
prune --apply retires records whose retention decision is action=retire.
  Uses retire_state_record(). Records revision history. No raw DELETE.

Usage examples:
  scripts/qz-braincase-review list
  scripts/qz-braincase-review list --memory-domain coding --limit 20 --json
  scripts/qz-braincase-review inspect rec_cand_123_abc
  scripts/qz-braincase-review promote rec_cand_123_abc
  scripts/qz-braincase-review promote rec_cand_123_abc --visibility internal --reason "Confirmed by ops"
  scripts/qz-braincase-review promote rec_cand_123_abc --dry-run
  scripts/qz-braincase-review reject rec_cand_123_abc --reason "Not needed"
  scripts/qz-braincase-review reject rec_cand_123_abc --dry-run
  scripts/qz-braincase-review retention-report
  scripts/qz-braincase-review retention-report --memory-domain coding --status candidate --json
  scripts/qz-braincase-review retention-report --action retire --limit 50
  scripts/qz-braincase-review prune --dry-run
  scripts/qz-braincase-review prune --dry-run --memory-domain coding --retention ephemeral
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

_REPO = Path(__file__).resolve().parents[1]
if str(_REPO) not in sys.path:
    sys.path.insert(0, str(_REPO))

import time as _time

from proxy.qz_braincase_db import BrainCaseDB, default_db_path
from proxy.qz_braincase_review import (
    inspect_candidate_record,
    list_candidate_records,
    promote_candidate_record,
    reject_candidate_record,
    retention_report_records,
    apply_retention_prune,
)
from proxy.qz_braincase_retention import load_default_retention_policy


# ---------------------------------------------------------------------------
# DB helpers
# ---------------------------------------------------------------------------

def _open_db(db_path_str: str | None) -> BrainCaseDB:
    if db_path_str:
        path = Path(db_path_str)
    else:
        path = default_db_path()
    db = BrainCaseDB(path=path, enabled=True)
    if not db.init():
        print(f"Error: BrainCaseDB init failed: {db.last_error}", file=sys.stderr)
        sys.exit(1)
    return db


# ---------------------------------------------------------------------------
# list command
# ---------------------------------------------------------------------------

def cmd_list(args: argparse.Namespace) -> int:
    db = _open_db(args.db_path)
    records = list_candidate_records(
        db,
        memory_domain=args.memory_domain or None,
        limit=args.limit,
    )
    db.close()

    if args.json:
        print(json.dumps(records, indent=2))
        return 0

    if not records:
        print("No candidate records found.")
        return 0

    # Human-readable table
    header = f"{'record_id':<40} {'domain':<12} {'tier':<28} {'type':<18} {'imp':>5}"
    print(header)
    print("-" * len(header))
    for r in records:
        claim_preview = (r.get("claim") or "")[:60]
        rid = (r.get("record_id") or "")[:40]
        domain = (r.get("memory_domain") or "")[:12]
        tier = (r.get("tier") or "")[:28]
        rtype = (r.get("record_type") or "")[:18]
        imp = f"{r.get('importance', 0.0):.2f}"
        print(f"{rid:<40} {domain:<12} {tier:<28} {rtype:<18} {imp:>5}")
        if claim_preview:
            print(f"  {claim_preview}")
    print(f"\n{len(records)} candidate(s)")
    return 0


# ---------------------------------------------------------------------------
# inspect command
# ---------------------------------------------------------------------------

def cmd_inspect(args: argparse.Namespace) -> int:
    db = _open_db(args.db_path)
    result = inspect_candidate_record(db, args.record_id)
    db.close()

    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1

    if not result.get("ok"):
        print(f"Error: {result.get('error')}", file=sys.stderr)
        return 1

    rec = result.get("record", {})
    print(f"record_id   : {rec.get('record_id')}")
    print(f"status      : {rec.get('status')}")
    print(f"visibility  : {rec.get('visibility')}")
    print(f"memory_domain: {rec.get('memory_domain')}")
    print(f"tier        : {rec.get('tier')}")
    print(f"record_type : {rec.get('record_type')}")
    print(f"confidence  : {rec.get('confidence')}")
    print(f"importance  : {rec.get('importance')}")
    print(f"retention   : {rec.get('retention')}")
    print(f"tags        : {rec.get('tags')}")
    print(f"claim       :\n  {rec.get('claim')}")
    print(f"summary     :\n  {rec.get('summary')}")
    meta = rec.get("metadata") or {}
    if isinstance(meta, dict):
        if meta.get("why_it_matters"):
            print(f"why_it_matters: {meta['why_it_matters']}")
        if meta.get("review_note"):
            print(f"review_note : {meta['review_note']}")
    return 0


# ---------------------------------------------------------------------------
# promote command
# ---------------------------------------------------------------------------

def cmd_promote(args: argparse.Namespace) -> int:
    db = _open_db(args.db_path)
    result = promote_candidate_record(
        db,
        args.record_id,
        visibility=args.visibility,
        reason=args.reason or "operator promotion",
        dry_run=args.dry_run,
        allowed_memory_domains=([args.memory_domain] if args.memory_domain else None),
    )
    db.close()

    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1

    if not result.get("ok"):
        print(f"Error promoting {args.record_id}:", file=sys.stderr)
        for e in result.get("errors", []):
            print(f"  {e}", file=sys.stderr)
        return 1

    prefix = "DRY-RUN: would promote" if args.dry_run else "Promoted"
    print(f"{prefix} {args.record_id}")
    print(f"  status     : {result.get('status')}")
    print(f"  visibility : {result.get('visibility')}")
    for w in result.get("warnings", []):
        print(f"  warning    : {w}")
    if result.get("dedup_hint") and result["dedup_hint"] != "no_duplicates":
        print(f"  dedup      : {result['dedup_hint']}")
    if result.get("conflict_hint") and result["conflict_hint"] != "no_conflicts":
        print(f"  conflict   : {result['conflict_hint']}")
    return 0


# ---------------------------------------------------------------------------
# reject command
# ---------------------------------------------------------------------------

def cmd_reject(args: argparse.Namespace) -> int:
    db = _open_db(args.db_path)
    result = reject_candidate_record(
        db,
        args.record_id,
        reason=args.reason or "operator rejected candidate",
        dry_run=args.dry_run,
    )
    db.close()

    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1

    if not result.get("ok"):
        print(f"Error rejecting {args.record_id}:", file=sys.stderr)
        for e in result.get("errors", []):
            print(f"  {e}", file=sys.stderr)
        return 1

    prefix = "DRY-RUN: would reject" if args.dry_run else "Rejected"
    print(f"{prefix} {args.record_id} (status → {result.get('status')})")
    return 0


# ---------------------------------------------------------------------------
# retention-report command (Slice C — dry-run only, no DB writes)
# ---------------------------------------------------------------------------

def _format_age(ms: int | None) -> str:
    if ms is None:
        return "?"
    days = ms // 86_400_000
    hours = (ms % 86_400_000) // 3_600_000
    if days > 0:
        return f"{days}d"
    return f"{hours}h"


def _load_policy(policy_path_str: str | None) -> dict:
    if policy_path_str:
        try:
            data = json.loads(Path(policy_path_str).read_text())
            if isinstance(data, dict):
                return data
        except Exception as exc:
            print(f"Warning: could not load policy from {policy_path_str!r}: {exc}",
                  file=sys.stderr)
    return load_default_retention_policy()


def cmd_retention_report(args: argparse.Namespace) -> int:
    db = _open_db(args.db_path)
    policy = _load_policy(getattr(args, "policy_path", None))
    now_ms = int(_time.time() * 1000)

    report = retention_report_records(
        db,
        now_ms=now_ms,
        policy=policy,
        memory_domain=getattr(args, "memory_domain", None) or None,
        status=getattr(args, "status", None) or None,
        retention=getattr(args, "retention", None) or None,
        action=getattr(args, "action", None) or None,
        limit=getattr(args, "limit", 100),
    )
    db.close()

    if args.json:
        print(json.dumps(report, indent=2))
        return 0 if report.get("ok") else 1

    if not report.get("ok"):
        print(f"Error: {report.get('error')}", file=sys.stderr)
        return 1

    db_label = args.db_path or "(default)"
    counts = report.get("counts", {})
    print("BrainCase retention report (dry-run)")
    print(f"DB: {db_label}")
    print(f"records seen: {report['records_seen']}")
    print(f"returned: {report['records_returned']}")
    print(
        f"counts: keep={counts.get('keep', 0)} "
        f"stale={counts.get('stale', 0)} "
        f"retire={counts.get('retire', 0)}"
    )

    decisions = report.get("decisions", [])
    if decisions:
        print()
        header = f"{'ACTION':<7} {'AGE':<6} {'RETENTION':<10} {'STATUS':<10} {'DOMAIN':<8} {'TIER':<22} {'RECORD_ID':<28} SUMMARY"
        print(header)
        print("-" * min(len(header), 120))
        for d in decisions:
            age = _format_age(d.get("age_since_update_ms"))
            ret = (d.get("retention") or "?")[:9]
            st = (d.get("status") or "?")[:9]
            dom = (d.get("memory_domain") or "?")[:7]
            tier = (d.get("tier") or "?")[:21]
            rid = (d.get("record_id") or "?")[:27]
            summ = (d.get("summary") or "")[:40]
            print(f"{d['action']:<7} {age:<6} {ret:<10} {st:<10} {dom:<8} {tier:<22} {rid:<28} {summ}")
    else:
        print("\nNo records matched.")

    for w in report.get("warnings", []):
        print(f"Warning: {w}", file=sys.stderr)

    return 0


def cmd_prune(args: argparse.Namespace) -> int:
    """Prune subcommand — dry-run preview or explicit --apply retire path."""
    dry_run = getattr(args, "dry_run", False)
    apply_flag = getattr(args, "apply", False)

    if not dry_run and not apply_flag:
        print("Error: Pass --dry-run to preview or --apply to retire eligible records.",
              file=sys.stderr)
        return 1

    if dry_run and apply_flag:
        print("Error: --dry-run and --apply are mutually exclusive.", file=sys.stderr)
        return 1

    db = _open_db(args.db_path)
    policy = _load_policy(getattr(args, "policy_path", None))
    now_ms = int(_time.time() * 1000)
    reason = getattr(args, "reason", None) or "operator retention prune"

    result = apply_retention_prune(
        db,
        now_ms=now_ms,
        policy=policy,
        memory_domain=getattr(args, "memory_domain", None) or None,
        status=getattr(args, "status", None) or None,
        retention=getattr(args, "retention", None) or None,
        limit=getattr(args, "limit", 100),
        reason=reason,
        dry_run=dry_run,
    )
    db.close()

    if args.json:
        print(json.dumps(result, indent=2))
        return 0 if result.get("ok") else 1

    if not result.get("ok"):
        print(f"Error: {result.get('error', 'unknown')}", file=sys.stderr)
        for e in result.get("errors", []):
            print(f"  {e}", file=sys.stderr)
        return 1

    # Dry-run: delegate display to retention-report style output
    if dry_run:
        db_label = args.db_path or "(default)"
        counts = result.get("counts", {})
        print("BrainCase retention prune dry-run")
        print(f"DB: {db_label}")
        print(f"records seen: {result.get('records_seen', 0)}")
        print(f"would retire: {result.get('records_returned', 0)}")
        decisions = result.get("decisions", [])
        if decisions:
            print()
            header = f"{'ACTION':<7} {'AGE':<6} {'RETENTION':<10} {'STATUS':<10} {'DOMAIN':<8} {'TIER':<22} {'RECORD_ID':<28}"
            print(header)
            print("-" * min(len(header), 100))
            for d in decisions:
                age = _format_age(d.get("age_since_update_ms"))
                print(f"{'retire':<7} {age:<6} {(d.get('retention') or ''):<10} "
                      f"{(d.get('status') or ''):<10} {(d.get('memory_domain') or ''):<8} "
                      f"{(d.get('tier') or ''):<22} {(d.get('record_id') or ''):<28}")
        else:
            print("No eligible records found.")
        return 0

    # Apply output
    db_label = args.db_path or "(default)"
    print("BrainCase retention prune apply")
    print(f"DB: {db_label}")
    print(f"retired: {result.get('retired_count', 0)}")
    print(f"skipped: {result.get('skipped_count', 0)}")

    retired = result.get("retired", [])
    if retired:
        print()
        header = f"{'RETIRED':<8} {'RECORD_ID':<36} {'RETENTION':<10} {'WAS_STATUS':<12} {'DOMAIN':<8} {'RULE'}"
        print(header)
        print("-" * min(len(header), 120))
        for r in retired:
            print(f"{'yes':<8} {(r.get('record_id') or ''):<36} "
                  f"{(r.get('retention') or ''):<10} {(r.get('previous_status') or ''):<12} "
                  f"{(r.get('memory_domain') or ''):<8} {r.get('matched_rule') or ''}")

    for w in result.get("warnings", []):
        print(f"Warning: {w}", file=sys.stderr)

    return 0


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> int:
    parser = argparse.ArgumentParser(
        description="Operator review CLI for BrainCase candidate records",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command")

    # list
    p_list = sub.add_parser("list", help="List candidate records")
    p_list.add_argument("--db-path", help="BrainCaseDB path (default: var/qz-state.sqlite3)")
    p_list.add_argument("--memory-domain", help="Filter by memory_domain")
    p_list.add_argument("--limit", type=int, default=50)
    p_list.add_argument("--json", action="store_true")

    # inspect
    p_inspect = sub.add_parser("inspect", help="Inspect a record")
    p_inspect.add_argument("record_id")
    p_inspect.add_argument("--db-path")
    p_inspect.add_argument("--json", action="store_true")

    # promote
    p_promote = sub.add_parser("promote", help="Promote a candidate record")
    p_promote.add_argument("record_id")
    p_promote.add_argument("--db-path")
    p_promote.add_argument("--visibility", choices=["renderable", "internal"],
                           default="renderable")
    p_promote.add_argument("--memory-domain", help="Guard: must match record domain")
    p_promote.add_argument("--reason")
    p_promote.add_argument("--dry-run", action="store_true")
    p_promote.add_argument("--json", action="store_true")

    # reject
    p_reject = sub.add_parser("reject", help="Reject (retire) a candidate record")
    p_reject.add_argument("record_id")
    p_reject.add_argument("--db-path")
    p_reject.add_argument("--reason")
    p_reject.add_argument("--dry-run", action="store_true")
    p_reject.add_argument("--json", action="store_true")

    # retention-report (Slice C — dry-run only)
    p_report = sub.add_parser("retention-report",
                               help="Dry-run retention policy report (no DB writes)")
    p_report.add_argument("--db-path")
    p_report.add_argument("--memory-domain")
    p_report.add_argument("--status", choices=["candidate", "active", "retired", "superseded"])
    p_report.add_argument("--retention", choices=["ephemeral", "session", "project", "durable"])
    p_report.add_argument("--action", choices=["keep", "stale", "retire"])
    p_report.add_argument("--limit", type=int, default=100)
    p_report.add_argument("--policy-path", help="Path to custom retention policy JSON")
    p_report.add_argument("--json", action="store_true")

    # prune (Slice D — dry-run preview or explicit apply)
    p_prune = sub.add_parser("prune",
                              help="Retention policy prune (--dry-run or --apply)")
    p_prune.add_argument("--dry-run", action="store_true",
                         help="Preview what would be retired (no DB writes)")
    p_prune.add_argument("--apply", action="store_true",
                         help="Retire eligible records (uses retire_state_record)")
    p_prune.add_argument("--db-path")
    p_prune.add_argument("--memory-domain")
    p_prune.add_argument("--status", choices=["candidate", "active", "retired", "superseded"])
    p_prune.add_argument("--retention", choices=["ephemeral", "session", "project", "durable"])
    p_prune.add_argument("--limit", type=int, default=100)
    p_prune.add_argument("--policy-path")
    p_prune.add_argument("--reason", help="Reason recorded in retirement revision")
    p_prune.add_argument("--json", action="store_true")

    args = parser.parse_args()

    if args.command == "list":
        return cmd_list(args)
    elif args.command == "inspect":
        return cmd_inspect(args)
    elif args.command == "promote":
        return cmd_promote(args)
    elif args.command == "reject":
        return cmd_reject(args)
    elif args.command == "retention-report":
        return cmd_retention_report(args)
    elif args.command == "prune":
        return cmd_prune(args)
    else:
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
