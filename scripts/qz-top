#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$SCRIPT_DIR/qz-env" ]]; then
  source "$SCRIPT_DIR/qz-env"
fi

set +e
set +u
set +o pipefail 2>/dev/null

python3 - "$@" <<'PY'
