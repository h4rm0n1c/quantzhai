def run_cmd(args, timeout=2.0) -> str:
    try:
        return subprocess.check_output(
            args,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
        )
    except subprocess.CalledProcessError as exc:
        return (exc.output or str(exc)).strip()
    except Exception as exc:
        return str(exc)


def docker_cmd() -> List[str]:
    raw = os.environ.get("QZ_DOCKER_CMD", "docker")
    return shlex.split(raw)


def docker(args: List[str], timeout=3.0) -> str:
    return run_cmd(docker_cmd() + args, timeout=timeout)


def curl_health(host: str, port: str) -> bool:
    """Check /health over HTTP using urllib — works locally and remotely."""
    try:
        import urllib.request
        with urllib.request.urlopen(
            f"http://{host}:{port}/health", timeout=1.0
        ) as r:
            body = r.read().decode("utf-8", errors="replace")
            return r.status == 200 and ("status" in body or body.strip() in ("OK", "ok"))
    except Exception:
        return False


def fetch_vram_snapshot(cp: Optional[dict]) -> Optional[dict]:
    """Extract vram snapshot from control-plane, or return None."""
    if not isinstance(cp, dict):
        return None
    v = cp.get("vram")
    if isinstance(v, dict) and v.get("schema") == "qz.vram.snapshot.v1":
        return v
    return None


def _mib_str(mib) -> str:
    """Format MiB value as human string, or '?' if None."""
    if mib is None:
        return "?"
    try:
        return human_bytes_from_mib(float(mib), compact=True)
    except Exception:
        return "?"


def _vram_total_line(vram_snap: Optional[dict]) -> str:
    """Build compact VRAM totals string from qz.vram.snapshot.v1."""
    if not isinstance(vram_snap, dict):
        return ""
    totals = vram_snap.get("totals") or {}
    used  = totals.get("used_mib")
    avail = totals.get("available_mib")
    total = totals.get("total_mib")
    proc  = totals.get("backend_process_used_mib")
    conf  = vram_snap.get("confidence", "?")
    parts = [f"src={conf}"]
    if used is not None and total is not None:
        parts.append(f"used={_mib_str(used)} avail={_mib_str(avail)} tot={_mib_str(total)}")
    if proc is not None:
        parts.append(f"proc={_mib_str(proc)}")
    return "  ".join(parts)


def _vram_comp_line(vram_snap: Optional[dict]) -> str:
    """Build compact component line with confidence markers.

    Markers: ~ estimated  ✓ backend-confirmed  ? unknown
    Example: MODEL=20.3GiB~  KV_ALLOC=1.6GiB~  KV_USED=0.2GiB~  SCRATCH=?  OTHER=0.9GiB  CTX=1234/262144✓
    """
    if not isinstance(vram_snap, dict):
        return ""
    comps = vram_snap.get("components") or []
    ctx   = vram_snap.get("context") or {}
    parts = []
    for comp in comps:
        label = comp.get("label", comp.get("name", "?").upper())
        mib   = comp.get("mib")
        conf  = comp.get("confidence", "unknown")
        if mib is None:
            parts.append(f"{label}=?")
        else:
            val = _mib_str(mib)
            if conf == "backend-confirmed":
                val += "✓"
            elif conf not in ("unknown",):
                val += "~"
            parts.append(f"{label}={val}")
    ctx_limit = ctx.get("limit_tokens")
    if ctx_limit:
        ctx_used = ctx.get("used_tokens")
        ctx_pct  = ctx.get("used_pct")
        ctx_conf = ctx.get("confidence", "")
        used_str = str(ctx_used) if ctx_used is not None else "?"
        ctx_s    = f"CTX={used_str}/{ctx_limit}"
        if ctx_pct is not None:
            ctx_s += f"({ctx_pct}%)"
        if ctx_conf == "backend-confirmed":
            ctx_s += "✓"
        parts.append(ctx_s)
    # Consistency marker
    est = vram_snap.get("estimates") or {}
    cons = est.get("consistency") or {}
    if cons.get("status") == "overallocated" and cons.get("over_by_mib") is not None:
        parts.append(f"OVER={_mib_str(cons['over_by_mib'])}")
    return "  ".join(parts)


def _vram_confidence_colour(ui: "UI", confidence: str):
    """Return curses attribute for a vram confidence string."""
    if confidence in ("backend-confirmed",):
        return ui.green | ui.bold
    if confidence in ("host-observed",):
        return ui.white
    if confidence in ("host-observed-heuristic", "estimated"):
        return ui.yellow
    if confidence in ("host-observed-residual",):
        return ui.cyan
    return ui.dim  # unknown


def proxy_base_url() -> str:
    host = os.environ.get("QZ_PROXY_HOST", "127.0.0.1")
    port = os.environ.get("QZ_PROXY_PORT", "18180")
    return f"http://{host}:{port}"


def monitor_http_timeout() -> float:
    try:
        return max(0.1, float(os.environ.get("QZ_MONITOR_HTTP_TIMEOUT", "2.0")))
    except Exception:
        return 2.0


def fetch_json(url: str, timeout: Optional[float] = None) -> Optional[dict]:
    if timeout is None:
        timeout = monitor_http_timeout()
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None


def telemetry_recent(limit: int = 30) -> Optional[dict]:
    return fetch_json(f"{proxy_base_url()}/qz/telemetry/recent?limit={limit}")


def proxy_status() -> Optional[dict]:
    return fetch_json(f"{proxy_base_url()}/qz/status")


def control_plane_status() -> Optional[dict]:
    """Fetch /qz/control-plane — the primary proxy-owned status source."""
    return fetch_json(f"{proxy_base_url()}/qz/control-plane")


def model_status_from_control_plane(cp: Optional[dict]) -> "ModelStatus":
    """Build ModelStatus from a qz.control_plane.status.v1 payload.

    Fields not exposed by /qz/control-plane (prompt_files, reasoning_level,
    reasoning_policy, sampling, profile_symlink, context lengths) are left at
    their defaults. They can be filled by a future slice or from telemetry.
    """
    if not isinstance(cp, dict):
        return ModelStatus()
    r = cp.get("readiness") or {}
    m = cp.get("models") or {}
    b = cp.get("backend") or {}
    hints = cp.get("operator_hints") or []
    overall_status = cp.get("status") or ""

    selected_key = str(m.get("selected") or "")
    selected_backend_id = str(m.get("selected_backend_id") or selected_key)
    loaded_model = str(b.get("loaded_model") or "")
    loaded_count = int(b.get("loaded_count") or 0)
    backend_error = str(b.get("error") or "")

    # Derive a human-readable state label from the control-plane status string.
    _status_map = {
        "ready": "loaded",
        "backend_unavailable": "unavailable",
        "model_not_loaded": "not_loaded",
        "initializing": "initializing",
        "degraded": "degraded",
    }
    selected_state = _status_map.get(overall_status, overall_status)
    load_state = overall_status
    # Defensive: service_status.model_state is derived from the authoritative
    # model_status (direct-backend aware) and may be "loaded" even when the
    # top-level status string is stale ("model_not_loaded") due to a timing
    # race between the router probe and model_status evaluation.
    ss = cp.get("service_status") or {}
    if selected_state in ("not_loaded", "unknown") and ss.get("model_state") == "loaded":
        selected_state = "loaded"

    # Use backend error, or first backend-related hint, as the error field.
    error = backend_error
    if not error and not r.get("backend_reachable"):
        for hint in hints:
            h = str(hint)
            if "backend" in h.lower() or "llama" in h.lower():
                error = h[:120]
                break

    bm = cp.get("backend_manager") or {}
    pf = cp.get("profile") or {}

    # Prefer backend_reasoning_budget from control-plane; fallback to environment.
    budget = str(pf.get("backend_reasoning_budget") if pf.get("backend_reasoning_budget") is not None else os.environ.get("QZ_REASONING_BUDGET", ""))

    return ModelStatus(
        ready=bool(m.get("selected_model_ready") or r.get("backend_ready")),
        profile=selected_key,
        selected=str(selected_backend_id or selected_key),
        selected_key=selected_key,
        selected_backend_id=selected_backend_id,
        profile_symlink=bool(pf.get("profile_symlink")),
        prompt_files=list(pf.get("prompt_files") or []),
        reasoning_level=str(pf.get("reasoning_level") or ""),
        reasoning_policy=str(pf.get("reasoning_policy") or ""),
        sampling=dict(pf.get("sampling") or {}),
        backend_reasoning_budget=budget,
        selected_state=selected_state,
        selected_context_length=int(pf.get("selected_context_length") or 0),
        backend_context_length=int(pf.get("backend_context_length") or 0),
        loaded=loaded_model,
        loaded_count=loaded_count,
        load_state=load_state,
        error=error,
        # Post-cleanup polish surface from models + backend_manager.
        selected_model_ready=bool(m.get("selected_model_ready")),
        request_admission_state=str(m.get("request_admission_state") or ""),
        backend_model_mode=str(m.get("backend_model_mode") or ""),
        launch_model_key=str(m.get("launch_model_key") or ""),
        launch_model_backend_id=str(m.get("launch_model_backend_id") or ""),
        launch_model_path_basename=str(m.get("launch_model_path_basename") or ""),
        model_switch_state=str(m.get("model_switch_state") or ""),
        active_load_operation=str(m.get("active_load_operation") or ""),
        last_good_key=str(m.get("last_good_key") or ""),
        last_good_backend_id=str(m.get("last_good_backend_id") or ""),
        failed_candidate_key=str(m.get("failed_candidate_key") or ""),
        failed_candidate_backend_id=str(m.get("failed_candidate_backend_id") or ""),
        selected_loaded_mismatch=bool(m.get("selected_loaded_mismatch")),
        last_load_error=str(b.get("load_error") or ""),
        last_load_error_type=str(b.get("load_error_type") or ""),
        backend_gpu_state=str(bm.get("gpu_offload_state") or ""),
        runtime_failure_result=str(m.get("runtime_failure_result") or b.get("runtime_failure_result") or ""),
        runtime_failure_error=str(m.get("runtime_failure_error") or b.get("runtime_failure_error") or ""),
        runtime_failure_error_type=str(m.get("runtime_failure_error_type") or b.get("runtime_failure_error_type") or ""),
        runtime_failure_at=str(m.get("runtime_failure_at") or b.get("runtime_failure_at") or ""),
        backend_died_after_healthy=bool(m.get("backend_died_after_healthy") or b.get("backend_died_after_healthy")),
    )


def service_recovery_from_control_plane(cp: Optional[dict]) -> "ServiceRecoveryStatus":
    """Parse service_status and recovery fields from /qz/control-plane. Never raises."""
    if not isinstance(cp, dict):
        return ServiceRecoveryStatus()
    try:
        ss = cp.get("service_status") or {}
        recovery = cp.get("recovery") or {}
        runtime = recovery.get("runtime_state") or {}
        active_req_d = recovery.get("active_requests") or {}
        jobs_d = recovery.get("jobs") or {}
        backoff_d = recovery.get("backoff") or {}

        # Operator hint: prefer service_status, fall back to recovery or top-level
        hints = (
            list(ss.get("operator_hints") or [])
            or list(recovery.get("operator_hints") or [])
            or list(cp.get("operator_hints") or [])
        )
        operator_hint = str(hints[0])[:120] if hints else ""

        # Attempts dict for backoff info
        attempts = runtime.get("attempts") or {}
        backoff_action = str(backoff_d.get("action") or "")
        backoff_active = bool(backoff_d.get("active", False))
        manual_required = bool(backoff_d.get("manual_required", False))
        # Also check per-action backoff in attempts
        if not backoff_action:
            for act, ainfo in attempts.items():
                if isinstance(ainfo, dict) and ainfo.get("backoff_active"):
                    backoff_action = act
                    backoff_active = True
                    manual_required = bool(ainfo.get("manual_required", False))
                    break

        # Latest job
        jobs_list = jobs_d.get("jobs") or []
        latest_job = jobs_list[0] if jobs_list else {}

        return ServiceRecoveryStatus(
            proxy_state=str(ss.get("proxy_state") or ""),
            catalog_state=str(ss.get("catalog_state") or ""),
            backend_state=str(ss.get("backend_state") or ""),
            model_state=str(ss.get("model_state") or ""),
            request_admission=str(ss.get("request_admission") or ""),
            recovery_state=str(ss.get("recovery_state") or ""),
            operator_action=str(ss.get("operator_action") or ""),
            recoverable=bool(ss.get("recoverable", False)),
            retryable=bool(ss.get("retryable", False)),
            fatal=bool(ss.get("fatal", False)),
            last_error=str(ss.get("last_error") or ""),
            active_requests=int(active_req_d.get("count") or 0),
            current_recovery_action=str(runtime.get("current_action") or ""),
            current_recovery_request_id=str(runtime.get("current_request_id") or ""),
            last_recovery_action=str(runtime.get("last_recovery_action") or ""),
            last_recovery_error=str(runtime.get("last_recovery_error") or ""),
            backoff_action=backoff_action,
            backoff_active=backoff_active,
            manual_required=manual_required,
            job_count=int(jobs_d.get("count") or 0),
            latest_job_action=str(latest_job.get("action") or ""),
            latest_job_state=str(latest_job.get("state") or ""),
            latest_job_request_id=str(latest_job.get("request_id") or ""),
            latest_job_error=str(latest_job.get("error") or ""),
            operator_hint=operator_hint,
        )
    except Exception:
        return ServiceRecoveryStatus()


def _path_without_query(path: str) -> str:
    return str(path or "").split("?", 1)[0]


def _is_monitor_poll(path: str) -> bool:
    path = _path_without_query(path)
    return (
        path in {
            "/health", "/ready", "/qz/status",
            "/qz/control-plane", "/qz/control-plane/status",
            "/qz/recovery", "/qz/recovery/status",
        }
        or path.startswith("/qz/telemetry")
        or path.startswith("/qz/recovery/jobs")
    )


def _is_response_request(payload: dict) -> bool:
    return (
        payload.get("method") == "POST"
        and _path_without_query(payload.get("path", "")) in {"/responses", "/v1/responses"}
    )


def _compact_sampling(sampling: dict) -> str:
    if not isinstance(sampling, dict):
        return ""
    parts = []
    for key in (
        "temperature",
        "top_p",
        "top_k",
        "min_p",
        "presence_penalty",
        "repeat_penalty",
        "repeat_last_n",
        "dry_multiplier",
    ):
        value = sampling.get(key)
        if value is not None:
            parts.append(f"{key}={value}")
    return " ".join(parts)


def _prompt_files_from_overrides(overrides: dict) -> List[str]:
    if not isinstance(overrides, dict):
        return []
    files: List[str] = []
    for key in (
        "system_prompt_file",
        "codex_base_instructions_file",
        "base_instructions_file",
        "prompt_replace_file",
        "prompt_replace_files",
        "prompt_prepend_files",
        "prompt_append_files",
    ):
        value = overrides.get(key)
        if isinstance(value, str) and value and value not in files:
            files.append(value)
        elif isinstance(value, list):
            for item in value:
                if isinstance(item, str) and item and item not in files:
                    files.append(item)
    return files


def _runtime_contract_from_event(event: dict) -> dict:
    payload = event.get("payload") if isinstance(event, dict) else {}
    if not isinstance(payload, dict):
        return {}
    if event.get("type") == "prompt_contract":
        return payload
    if event.get("type") in ("request_completed", "throughput_sample"):
        runtime = payload.get("runtime_metrics") if isinstance(payload.get("runtime_metrics"), dict) else {}
        contract = runtime.get("prompt_contract") if isinstance(runtime.get("prompt_contract"), dict) else {}
        return contract
    return {}


def _positive_float(value) -> float:
    try:
        number = float(value)
    except Exception:
        return 0.0
    if not math.isfinite(number) or number <= 0:
        return 0.0
    return number


def _positive_int(value) -> int:
    try:
        number = int(value)
    except Exception:
        return 0
    return number if number > 0 else 0


def model_status_from_proxy(status: Optional[dict]) -> ModelStatus:
    if not isinstance(status, dict):
        return ModelStatus()
    selected_entry = status.get("selected") if isinstance(status.get("selected"), dict) else {}
    backend = status.get("backend") if isinstance(status.get("backend"), dict) else {}
    load = status.get("load") if isinstance(status.get("load"), dict) else {}
    loaded_model = backend.get("loaded_model") if isinstance(backend.get("loaded_model"), str) else ""
    loaded_models = backend.get("loaded_models") if isinstance(backend.get("loaded_models"), list) else []
    loaded_ids = [
        str(model.get("id"))
        for model in loaded_models
        if isinstance(model, dict) and model.get("id")
    ]
    if not loaded_ids:
        backend_models = backend.get("models") if isinstance(backend.get("models"), dict) else {}
        loaded_ids = [
            str(model_id)
            for model_id, entry in backend_models.items()
            if isinstance(entry, dict) and entry.get("state") == "loaded"
        ]
    if not loaded_model and loaded_ids:
        loaded_model = loaded_ids[0]
    selected_key = backend.get("selected_key") or selected_entry.get("key") or selected_entry.get("slug") or ""
    selected_backend_id = backend.get("selected_backend_id") or selected_entry.get("backend_id") or selected_key
    profile = selected_entry.get("label") or selected_entry.get("name") or selected_key
    prompt_files = _prompt_files_from_overrides(selected_entry.get("overrides") if isinstance(selected_entry.get("overrides"), dict) else {})
    sampling = backend.get("selected_sampling_params") if isinstance(backend.get("selected_sampling_params"), dict) else {}
    return ModelStatus(
        ready=bool(status.get("ready")),
        profile=str(profile or ""),
        selected=str(selected_backend_id or selected_key or ""),
        selected_key=str(selected_key or ""),
        selected_backend_id=str(selected_backend_id or ""),
        profile_symlink=bool(selected_entry.get("profile_symlink")),
        prompt_files=prompt_files,
        reasoning_level=str(backend.get("selected_reasoning_level") or ""),
        reasoning_policy=str(backend.get("selected_reasoning_policy") or ""),
        sampling=sampling,
        backend_reasoning_budget=str(backend.get("backend_reasoning_budget") or os.environ.get("QZ_REASONING_BUDGET", "")),
        selected_state=str(backend.get("selected_state") or ""),
        selected_context_length=int(backend.get("selected_context_length") or 0),
        backend_context_length=int(backend.get("backend_context_length") or 0),
        loaded=str(loaded_model or ""),
        loaded_count=int(backend.get("loaded_count") or len(loaded_ids) or 0),
        load_state=str(load.get("state") or ""),
        error=str(load.get("error") or ""),
    )


def parse_num(text: str) -> float:
    try:
        return float(str(text).strip())
    except Exception:
        return 0.0


def human_si(value: float, suffix: str = "", precision: int = 1) -> str:
    try:
        value = float(value)
    except Exception:
        value = 0.0
    sign = "-" if value < 0 else ""
    value = abs(value)
    if value == 0:
        return f"0{suffix}"
    units = ["", "k", "M", "G", "T", "P", "E"]
    idx = 0
    while value >= 1000.0 and idx < len(units) - 1:
        value /= 1000.0
        idx += 1
    if idx == 0:
        text = f"{value:.0f}" if value >= 100 else f"{value:.{precision}f}"
    else:
        text = f"{value:.{precision}f}"
    return f"{sign}{text}{units[idx]}{suffix}"


def tps_str(value: float) -> str:
    """Format a token-per-second rate as a plain number, never using SI prefixes.

    Keeps all TPS columns in the same unit so values are immediately comparable.
    Returns '--' when the rate is zero or unavailable.
    """
    if not value or value <= 0:
        return "--"
    if value >= 1000:
        return f"{int(round(value))}"
    if value >= 100:
        return f"{int(round(value))}"
    if value >= 10:
        return f"{value:.1f}"
    return f"{value:.2f}"


def human_bytes_from_mib(value: float, compact: bool = False) -> str:
    try:
        value = float(value)
    except Exception:
        value = 0.0
    units = ["MiB", "GiB", "TiB", "PiB"]
    idx = 0
    while value >= 1024.0 and idx < len(units) - 1:
        value /= 1024.0
        idx += 1
    text = f"{value:.0f}" if idx == 0 else f"{value:.1f}"
    sep = "" if compact else " "
    return f"{text}{sep}{units[idx]}"


def context_display(model_status: ModelStatus) -> str:
    if model_status.backend_context_length > 0:
        return str(model_status.backend_context_length)
    if model_status.selected_context_length > 0:
        return str(model_status.selected_context_length)
    return os.environ.get("QZ_CONTEXT", "?")


def human_duration_ms(ms: float) -> str:
    try:
        ms = float(ms)
    except Exception:
        ms = 0.0
    if ms < 1000.0:
        return f"{ms:.0f}ms"
    seconds = ms / 1000.0
    if seconds < 60.0:
        return f"{seconds:.1f}s"
    minutes = seconds / 60.0
    if minutes < 60.0:
        return f"{minutes:.1f}m"
    hours = minutes / 60.0
    return f"{hours:.1f}h"


def vram_summary(gpus: List[GpuRow]) -> Tuple[float, float, float]:
    used = sum(max(0.0, gpu.mem_used) for gpu in gpus)
    total = sum(max(0.0, gpu.mem_total) for gpu in gpus)
    available = max(0.0, total - used)
    return used, available, total


def gpu_summary(gpus: List[GpuRow]) -> Tuple[float, float, float, float, float, float]:
    used, available, total = vram_summary(gpus)
    util = sum(max(0.0, gpu.util) for gpu in gpus) / len(gpus) if gpus else 0.0
    power = sum(max(0.0, gpu.power) for gpu in gpus)
    temp = sum(max(0.0, gpu.temp) for gpu in gpus) / len(gpus) if gpus else 0.0
    return util, used, available, total, power, temp


def update_vram_baseline(gpus: List[GpuRow], baseline: dict) -> dict:
    for gpu in gpus:
        current = max(0.0, gpu.mem_used)
        previous = baseline.get(gpu.index)
        if previous is None or current < previous:
            baseline[gpu.index] = current
    return baseline


def vram_parts(gpu: GpuRow, baseline: dict) -> Tuple[float, float, float, float]:
    used = max(0.0, gpu.mem_used)
    base = max(0.0, baseline.get(gpu.index, used))
    delta = max(0.0, used - base)
    available = max(0.0, gpu.mem_total - used)
    return used, base, delta, available


def vram_split_summary(gpus: List[GpuRow], baseline: dict) -> Tuple[float, float, float, float, float]:
    used = base = delta = available = total = 0.0
    for gpu in gpus:
        row_used, row_base, row_delta, row_available = vram_parts(gpu, baseline)
        used += row_used
        base += row_base
        delta += row_delta
        available += row_available
        total += max(0.0, gpu.mem_total)
    return used, base, delta, available, total


def parse_gpus() -> List[GpuRow]:
    query = (
        "index,name,utilization.gpu,memory.used,memory.total,"
        "power.draw,temperature.gpu,pcie.link.gen.current,pcie.link.width.current"
    )
    out = run_cmd(
        [
            "nvidia-smi",
            f"--query-gpu={query}",
            "--format=csv,noheader,nounits",
        ],
        timeout=2.0,
    )
    rows = []
    for line in out.splitlines():
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 9:
            continue
        if not parts[0].isdigit():
            continue
        rows.append(
            GpuRow(
                index=parts[0],
                name=parts[1],
                util=parse_num(parts[2]),
                mem_used=parse_num(parts[3]),
                mem_total=parse_num(parts[4]),
                power=parse_num(parts[5]),
                temp=parse_num(parts[6]),
                gen=parts[7],
                width=parts[8],
            )
        )
    return rows


def gpus_from_vram_snap(vram_snap: Optional[dict]) -> List[GpuRow]:
    """Convert proxy vram_snapshot gpus list to GpuRow objects.

    The proxy already runs nvidia-smi server-side and exposes the result
    via /qz/status → vram → gpus.  Using this avoids a redundant local
    nvidia-smi call and makes qz-top work over HTTP without a local GPU.
    """
    if not isinstance(vram_snap, dict):
        return []
    raw = vram_snap.get("gpus") or []
    rows = []
    for g in raw:
        if not isinstance(g, dict):
            continue
        try:
            rows.append(GpuRow(
                index=str(g.get("index", "")),
                name=str(g.get("name", "")),
                util=float(g.get("util_pct") or 0),
                mem_used=float(g.get("used_mib") or 0),
                mem_total=float(g.get("total_mib") or 0),
                power=float(g.get("power_w") or 0),
                temp=float(g.get("temp_c") or 0),
                gen=str(g.get("pcie_gen") or ""),
                width=str(g.get("pcie_width") or ""),
            ))
        except (TypeError, ValueError):
            continue
    return rows


def telemetry_row(event: dict) -> Optional[Tuple[str, str]]:
    payload = event.get("payload") if isinstance(event, dict) else {}
    if not isinstance(payload, dict):
        payload = {}
    ev_type = str(event.get("type") or "event")
    if ev_type == "request_started":
        method = payload.get("method", "")
        path = payload.get("path", "")
        if _is_monitor_poll(path) or not _is_response_request(payload):
            return None
        return ("request", f"{method} {path}".strip())
    if ev_type == "deprecated_endpoint":
        path = payload.get("path", "")
        replacement = payload.get("replacement", "")
        return ("deprecated", f"{path} -> {replacement}".strip(" ->"))
    if ev_type == "prompt_contract":
        contract = _runtime_contract_from_event(event)
        profile = contract.get("profile") or contract.get("selected_key") or ""
        backend = contract.get("selected_backend_id") or ""
        prompt_files = contract.get("prompt_files") if isinstance(contract.get("prompt_files"), list) else []
        policy = contract.get("prompt_policy") if isinstance(contract.get("prompt_policy"), dict) else {}
        turn_harness = contract.get("turn_harness") if isinstance(contract.get("turn_harness"), dict) else {}
        bits = []
        if profile:
            bits.append(str(profile))
        if backend and backend != profile:
            bits.append(f"backend={backend}")
        if prompt_files:
            bits.append(f"prompt={prompt_files[0]}")
        if policy.get("mode"):
            bits.append(f"mode={policy.get('mode')}")
        if policy.get("replaced_client"):
            bits.append("replaced")
        if policy.get("synthesized_missing_client"):
            bits.append("synthesized")
        if turn_harness.get("applied"):
            bits.append("harness=applied")
        elif turn_harness.get("available"):
            bits.append(f"harness={turn_harness.get('skipped_reason') or 'skipped'}")
        return ("prompt", " ".join(bits).strip() or "prompt contract")
    if ev_type == "request_completed":
        path = payload.get("path", "")
        if _is_monitor_poll(path):
            return None
        status = payload.get("status", "")
        elapsed = payload.get("elapsed_ms")
        usage = payload.get("usage") if isinstance(payload.get("usage"), dict) else {}
        total_tokens = usage.get("total_tokens") or usage.get("output_tokens") or 0
        msg = f"{path}".strip()
        if status:
            msg += f" {status}"
        if elapsed:
            try:
                msg += f" {float(elapsed):.0f}ms"
            except Exception:
                pass
        if total_tokens:
            msg += f" {total_tokens}t"
        contract = _runtime_contract_from_event(event)
        if contract.get("profile") and contract.get("selected_backend_id"):
            msg += f" {contract.get('profile')}->{contract.get('selected_backend_id')}"
        return ("request", msg.strip())
    if ev_type == "throughput_sample":
        path = payload.get("path", "")
        prompt_rate = payload.get("prompt_rate")
        gen_rate = payload.get("gen_rate")
        total_rate = payload.get("total_rate")
        msg = f"{path}".strip()
        parts = []
        if prompt_rate:
            parts.append(f"prompt={tps_str(prompt_rate)} t/s")
        if gen_rate:
            parts.append(f"gen={tps_str(gen_rate)} t/s")
        if total_rate:
            parts.append(f"total={tps_str(total_rate)} t/s")
        if parts:
            msg = f"{msg} {' '.join(parts)}".strip()
        return ("throughput", msg.strip())
    if ev_type == "request_failed":
        path = payload.get("path", "")
        if _is_monitor_poll(path):
            return None
        error = payload.get("error", "")
        return ("error", f"{path} {error}".strip())
    if ev_type == "status_snapshot":
        return None
    if ev_type in {"model_selected", "model_load_started", "model_load_pending", "model_load_ready", "model_load_failed"}:
        requested = payload.get("requested") or payload.get("model") or ""
        selected = payload.get("selected") or payload.get("backend_id") or ""
        parts = [ev_type.replace("_", " ")]
        if requested or selected:
            parts.append(f"{requested}->{selected}".strip("->"))
        if ev_type.endswith("failed") and payload.get("error"):
            parts.append(str(payload.get("error")))
        return ("model", " ".join(part for part in parts if part).strip())
    if ev_type in {"tool_call_started", "tool_call_completed"}:
        tool = payload.get("tool") or payload.get("action") or ""
        status = payload.get("status") or ""
        result_count = payload.get("result_count")
        msg = f"{ev_type.replace('_', ' ')} {tool}".strip()
        if status:
            msg += f" {status}"
        if result_count is not None:
            msg += f" {result_count}"
        return ("tool", msg.strip())
    if ev_type in {"web_search_route", "upstream_request"}:
        return ("web", ev_type.replace("_", " "))
    if ev_type in {"stream_started", "stream_completed", "stream_failed"}:
        return ("stream", ev_type.replace("_", " "))
    if ev_type == "stream_event_timing":
        return None
    if ev_type == "sse_event":
        sse_type = str(payload.get("event_type") or "")
        if sse_type.endswith(".delta"):
            return None
        if sse_type in ("response.created", "response.completed"):
            return ("stream", sse_type.rsplit(".", 1)[-1])
    return None


def _window_avg(window) -> float:
    return sum(window) / len(window) if window else 0.0


def _apply_request_completed_telemetry(rates: Rates, payload: dict):
    if not isinstance(payload, dict):
        return rates

    elapsed = _positive_float(payload.get("elapsed_ms"))
    usage = payload.get("usage") if isinstance(payload.get("usage"), dict) else {}
    prompt_ms = _positive_float(payload.get("prompt_ms"))
    gen_ms = _positive_float(payload.get("gen_ms"))
    prompt_tokens = _positive_int(usage.get("input_tokens"))
    gen_tokens = _positive_int(usage.get("output_tokens"))
    # Use explicit total when available; fall back to input+output (not just output).
    total_tokens = _positive_int(usage.get("total_tokens"))
    if not total_tokens:
        total_tokens = prompt_tokens + gen_tokens
    _input_details = usage.get("input_tokens_details") if isinstance(usage.get("input_tokens_details"), dict) else {}
    _output_details = usage.get("output_tokens_details") if isinstance(usage.get("output_tokens_details"), dict) else {}
    cached_tokens = _positive_int(_input_details.get("cached_tokens"))
    reasoning_tokens = _positive_int(_output_details.get("reasoning_tokens"))

    if prompt_tokens and prompt_ms:
        prompt_rate = _positive_float(prompt_tokens * 1000.0 / prompt_ms)
        rates.prompt_window.append(prompt_rate)
        rates.prompt_latest = _window_avg(rates.prompt_window)
        rates.prompt_max = max(rates.prompt_max, prompt_rate)
        rates.prompt_tokens = prompt_tokens   # latest request, not all-time max
        rates.prompt_ms = prompt_ms
    if gen_tokens and gen_ms:
        gen_rate = _positive_float(gen_tokens * 1000.0 / gen_ms)
        rates.gen_window.append(gen_rate)
        rates.gen_latest = _window_avg(rates.gen_window)
        rates.gen_max = max(rates.gen_max, gen_rate)
        rates.gen_tokens = gen_tokens         # latest request
        rates.gen_ms = gen_ms
    if elapsed and total_tokens:
        total_rate = _positive_float(total_tokens * 1000.0 / elapsed)
        rates.total_window.append(total_rate)
        rates.total_latest = _window_avg(rates.total_window)
        rates.total_max = max(rates.total_max, total_rate)
        rates.total_tokens = total_tokens     # latest request
        rates.total_ms = elapsed
    if cached_tokens:
        rates.cached_tokens = cached_tokens
    if reasoning_tokens:
        rates.reasoning_tokens = reasoning_tokens
    return rates


def _apply_throughput_sample_telemetry(rates: Rates, payload: dict):
    if not isinstance(payload, dict):
        return rates

    prompt_rate = _positive_float(payload.get("prompt_rate"))
    gen_rate = _positive_float(payload.get("gen_rate"))
    total_rate = _positive_float(payload.get("total_rate"))
    prompt_tokens = _positive_int(payload.get("prompt_tokens"))
    gen_tokens = _positive_int(payload.get("gen_tokens"))
    total_tokens = _positive_int(payload.get("total_tokens"))
    prompt_ms = _positive_float(payload.get("prompt_ms"))
    gen_ms = _positive_float(payload.get("gen_ms"))
    elapsed_ms = _positive_float(payload.get("elapsed_ms"))

    if prompt_rate:
        rates.prompt_window.append(prompt_rate)
        rates.prompt_latest = _window_avg(rates.prompt_window)
        rates.prompt_max = max(rates.prompt_max, prompt_rate)
    if gen_rate:
        rates.gen_window.append(gen_rate)
        rates.gen_latest = _window_avg(rates.gen_window)
        rates.gen_max = max(rates.gen_max, gen_rate)
    if total_rate:
        rates.total_window.append(total_rate)
        rates.total_latest = _window_avg(rates.total_window)
        rates.total_max = max(rates.total_max, total_rate)
    if prompt_tokens:
        rates.prompt_tokens = max(rates.prompt_tokens, prompt_tokens)
    if gen_tokens:
        rates.gen_tokens = max(rates.gen_tokens, gen_tokens)
    if total_tokens:
        rates.total_tokens = max(rates.total_tokens, total_tokens)
    if prompt_ms:
        rates.prompt_ms = max(rates.prompt_ms, prompt_ms)
    if gen_ms:
        rates.gen_ms = max(rates.gen_ms, gen_ms)
    if elapsed_ms:
        rates.total_ms = max(rates.total_ms, elapsed_ms)
    return rates


def merge_telemetry(rates: Rates, telemetry: Optional[dict]) -> Rates:
    if not isinstance(telemetry, dict):
        return rates
    state = telemetry.get("state") or {}
    counters = state.get("counters") or {}
    try:
        rates.requests = max(
            rates.requests,
            int(counters.get("request_admitted") or counters.get("request_completed") or 0),
        )
    except Exception:
        pass

    latest_throughput = state.get("latest_throughput") if isinstance(state.get("latest_throughput"), dict) else None
    if latest_throughput:
        _apply_throughput_sample_telemetry(rates, latest_throughput.get("payload") if isinstance(latest_throughput.get("payload"), dict) else latest_throughput)

    rows = list(rates.recent or [])
    events = []
    seen_seq = set()
    for event in (state.get("latest_completed_events") or []) + (telemetry.get("events") or []):
        if not isinstance(event, dict):
            continue
        seq = event.get("seq")
        if seq is not None and seq in seen_seq:
            continue
        if seq is not None:
            seen_seq.add(seq)
        events.append(event)
    for event in events:
        row = telemetry_row(event)
        if row:
            rows.append(row)
        if event.get("type") == "throughput_sample":
            payload = event.get("payload") if isinstance(event.get("payload"), dict) else {}
            _apply_throughput_sample_telemetry(rates, payload)
        elif event.get("type") == "request_completed":
            payload = event.get("payload") if isinstance(event.get("payload"), dict) else {}
            _apply_request_completed_telemetry(rates, payload)
    rates.recent = rows[-9:]
    return rates


def latest_benchmark() -> Optional[BenchmarkSummary]:
    path = os.path.join(os.environ.get("QZ_VAR_DIR", "var"), "benchmarks", "latest-summary.json")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except Exception:
        return None

    aggregate = data.get("aggregate")
    if not isinstance(aggregate, dict) or not aggregate:
        return None

    best_profile = ""
    best_row = None
    for profile, row in aggregate.items():
        if not isinstance(row, dict):
            continue
        cases = int(row.get("cases") or 0)
        if cases <= 0:
            continue
        ratio = row.get("avg_input_ratio")
        if ratio is None:
            ratio = row.get("avg_output_ratio")
        if ratio is None:
            continue
        best_ratio = best_row.get("avg_input_ratio") if best_row else None
        if best_ratio is None and best_row:
            best_ratio = best_row.get("avg_output_ratio", 9999)
        if best_row is None or float(ratio) < float(best_ratio):
            best_profile = profile
            best_row = row

    if best_row is None:
        return None

    return BenchmarkSummary(
        run_id=str(data.get("run_id", "")),
        baseline=str(data.get("baseline_profile", "")),
        profiles=len(data.get("profiles") or []),
        cases=int(data.get("case_count") or 0),
        prompt_count=int(data.get("prompt_count") or 0),
        best_profile=best_profile,
        best_input_ratio=float(best_row.get("avg_input_ratio", best_row.get("avg_output_ratio")) or 0.0),
        best_input_savings=float(best_row.get("avg_input_savings", best_row.get("avg_output_savings")) or 0.0),
        best_instructions_ratio=float(best_row.get("avg_instructions_ratio") or 0.0),
        best_final_ratio=float(best_row.get("avg_final_ratio") or 0.0),
        best_total_ratio=float(best_row.get("avg_total_ratio") or 0.0),
        best_wall_ratio=float(best_row.get("avg_wall_ratio") or 0.0),
    )


def clip(text: str, width: int) -> str:
    text = str(text)
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    if width == 1:
        return "…"
    return text[: width - 1] + "…"


class UI:
    def __init__(self, stdscr, interval: float):
        self.stdscr = stdscr
        self.interval = interval
        self.running = True
        self.vram_baseline = {}
        self.setup_colours()

    def setup_colours(self):
        curses.start_color()
        curses.use_default_colors()
        pairs = [
            (1, curses.COLOR_GREEN),
            (2, curses.COLOR_YELLOW),
            (3, curses.COLOR_RED),
            (4, curses.COLOR_CYAN),
            (5, curses.COLOR_BLUE),
            (6, curses.COLOR_MAGENTA),
            (7, curses.COLOR_WHITE),
        ]
        for pair, colour in pairs:
            try:
                curses.init_pair(pair, colour, -1)
            except Exception:
                pass

        self.green = curses.color_pair(1)
        self.yellow = curses.color_pair(2)
        self.red = curses.color_pair(3)
        self.cyan = curses.color_pair(4)
        self.blue = curses.color_pair(5)
        self.magenta = curses.color_pair(6)
        self.white = curses.color_pair(7)
        self.bold = curses.A_BOLD
        self.dim = curses.A_DIM

    def colour_for_pct(self, pct: float):
        if pct >= 92:
            return self.red | self.bold
        if pct >= 82:
            return self.yellow | self.bold
        return self.green | self.bold

    def colour_for_util(self, util: float):
        if util >= 70:
            return self.red | self.bold
        if util >= 40:
            return self.yellow | self.bold
        return self.green | self.bold

    def add(self, y: int, x: int, text: str, attr=0):
        h, w = self.stdscr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return
        room = max(0, w - x - 1)
        try:
            self.stdscr.addstr(y, x, clip(text, room), attr)
        except curses.error:
            pass

    def box(self, y: int, x: int, h: int, w: int, title: str):
        max_h, max_w = self.stdscr.getmaxyx()
        if y >= max_h or x >= max_w:
            return
        h = min(h, max_h - y)
        w = min(w, max_w - x)
        if h < 3 or w < 8:
            return

        top = "┌" + "─" * (w - 2) + "┐"
        mid = "│" + " " * (w - 2) + "│"
        bot = "└" + "─" * (w - 2) + "┘"

        self.add(y, x, top, self.dim)
        for row in range(1, h - 1):
            self.add(y + row, x, mid, self.dim)
        self.add(y + h - 1, x, bot, self.dim)

        label = f" {title} "
        if len(label) < w - 4:
            self.add(y, x + 2, label, self.cyan | self.bold)

    def bar(self, used: float, total: float, width: int) -> Tuple[str, float]:
        if total <= 0:
            total = 1.0
        pct = used / total * 100.0
        filled = int((pct / 100.0) * width + 0.5)
        filled = max(0, min(width, filled))
        return "█" * filled + "░" * (width - filled), pct

    def draw_status_tile(self, y: int, x: int, label: str, ok: bool) -> int:
        light_attr = self.green | self.bold if ok else self.red | self.bold
        tile_attr = self.green if ok else self.red | self.bold
        text = f"╭─ {label} ● ─╮"
        light_x = x + len(f"╭─ {label} ")
        self.add(y, x, text, tile_attr)
        self.add(y, light_x, "●", light_attr)
        return len(text)

    def draw_status_bar(self, y: int, x: int, backend_ok: bool, proxy_ok: bool):
        cursor = x
        cursor += self.draw_status_tile(y, cursor, "BACKEND", backend_ok) + 2
        self.draw_status_tile(y, cursor, "PROXY", proxy_ok)

    def draw_header(
        self, backend_ok: bool, proxy_ok: bool,
        gpus: Optional[List[GpuRow]] = None,
        vram_snap: Optional[dict] = None,
    ):
        h, w = self.stdscr.getmaxyx()
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        self.add(0, 0, " QZ-TOP ", self.cyan | self.bold)
        self.add(0, 9, ts, self.bold)

        bx = 31
        self.add(0, bx, f"refresh={self.interval:g}s", self.dim)
        # Prefer proxy VRAM totals; fall back to local nvidia-smi summary
        if isinstance(vram_snap, dict):
            totals = vram_snap.get("totals") or {}
            used  = totals.get("used_mib")
            avail = totals.get("available_mib")
            total = totals.get("total_mib")
            conf  = vram_snap.get("confidence", "?")
            if used is not None and total is not None:
                vram_txt = (
                    f"vram={human_bytes_from_mib(used, compact=True)}/"
                    f"{human_bytes_from_mib(avail, compact=True)}/"
                    f"{human_bytes_from_mib(total, compact=True)} {conf}"
                )
                self.add(0, bx + 23, vram_txt, self.dim)
        elif gpus:
            used, available, total = vram_summary(gpus)
            self.add(
                0, bx + 23,
                f"vram={human_bytes_from_mib(used, compact=True)}/{human_bytes_from_mib(available, compact=True)}/{human_bytes_from_mib(total, compact=True)}",
                self.dim,
            )
        self.draw_status_bar(1, 1, backend_ok, proxy_ok)
        self.add(2, 0, "─" * max(1, w - 1), self.dim)

    def draw_profile(self, y: int, x: int, h: int, w: int, model_status: ModelStatus, srs: Optional["ServiceRecoveryStatus"] = None, cp_is_none: bool = False):
        self.box(y, x, h, w, "PROFILE")
        labels = ["CTX", "NP", "SPLIT", "BATCH", "UBATCH", "CACHE", "REUSE", "KV"]
        values = [
            context_display(model_status),
            os.environ.get("QZ_PARALLEL", "?"),
            os.environ.get("QZ_TENSOR_SPLIT", "?"),
            os.environ.get("QZ_BATCH", "?"),
            os.environ.get("QZ_UBATCH", "?"),
            human_bytes_from_mib(parse_num(os.environ.get("QZ_CACHE_RAM", "0"))),
            os.environ.get("QZ_CACHE_REUSE", "?"),
            os.environ.get("QZ_KV_KEY", "?") + "/" + os.environ.get("QZ_KV_VALUE", "?"),
        ]
        widths = [10, 5, 8, 8, 8, 9, 8, 16]

        cx = x + 2
        for label, width in zip(labels, widths):
            self.add(y + 1, cx, f"{label:<{width}}", self.dim | self.bold)
            cx += width + 1

        cx = x + 2
        for value, width in zip(values, widths):
            self.add(y + 2, cx, f"{clip(value, width):<{width}}", self.white)
            cx += width + 1

        # Detect proxy-offline: the fetch explicitly failed.
        _proxy_offline = cp_is_none
        loaded = model_status.loaded or ("PROXY OFFLINE" if _proxy_offline else "none")
        loaded_suffix = f" ({model_status.loaded_count})" if model_status.loaded_count > 1 else ""
        state = model_status.selected_state or model_status.load_state or ("offline" if _proxy_offline else "unknown")
        state_attr = self.green | self.bold if model_status.ready else self.yellow | self.bold
        if _proxy_offline:
            state_attr = self.red | self.bold
        elif model_status.error:
            state_attr = self.red | self.bold
        profile_bits = [model_status.profile or model_status.selected_key or ("?" if not _proxy_offline else "")]
        if model_status.selected_backend_id and model_status.selected_backend_id not in profile_bits:
            profile_bits.append(f"backend={model_status.selected_backend_id}")
        if model_status.profile_symlink:
            profile_bits.append("symlink")
        prompt_files = model_status.prompt_files or []
        reasoning = " ".join(
            bit for bit in (
                model_status.reasoning_level,
                f"policy={model_status.reasoning_policy}" if model_status.reasoning_policy else "",
                _compact_sampling(model_status.sampling or {}),
            ) if bit
        ) or "?"

        self.add(y + 3, x + 2, "RUNTIME", self.dim | self.bold)
        self.add(y + 4, x + 2, "PROFILE", self.dim | self.bold)
        self.add(y + 4, x + 12, clip(" ".join(profile_bits), w - 14), self.white)
        self.add(y + 5, x + 2, "PROMPT", self.dim | self.bold)
        self.add(y + 5, x + 12, clip(", ".join(prompt_files[:2]) if prompt_files else "default", w - 14), self.white)
        self.add(y + 6, x + 2, "REASON", self.dim | self.bold)
        self.add(y + 6, x + 12, clip(reasoning, w - 14), self.white)
        self.add(y + 7, x + 2, "LOADED", self.dim | self.bold)
        self.add(y + 7, x + 12, clip(f"{loaded}{loaded_suffix}", w - 14), self.white)
        self.add(y + 8, x + 2, "STATE", self.dim | self.bold)
        state_text = state
        if model_status.error:
            state_text += f" error={model_status.error}"
        self.add(y + 8, x + 12, clip(state_text, w - 14), state_attr)
        # Post-cleanup polish: one-line model lifecycle row when room.
        if h >= 11:
            mode_bits = []
            mode_bits.append(f"ready={str(model_status.selected_model_ready).lower()}")
            if model_status.request_admission_state:
                mode_bits.append(f"admission={model_status.request_admission_state}")
            if model_status.model_switch_state:
                mode_bits.append(f"switch={model_status.model_switch_state}")
            if (model_status.active_load_operation
                    and model_status.active_load_operation != "none"):
                mode_bits.append(f"op={model_status.active_load_operation}")
            if model_status.backend_gpu_state:
                mode_bits.append(f"gpu={model_status.backend_gpu_state}")
            if model_status.selected_loaded_mismatch:
                mode_bits.append("mismatch")
            if mode_bits:
                row_attr = self.white
                if model_status.last_load_error_type:
                    row_attr = self.red | self.bold
                elif model_status.model_switch_state in ("restarting", "loading"):
                    row_attr = self.yellow | self.bold
                self.add(y + 9, x + 2, "MODEL", self.dim | self.bold)
                self.add(y + 9, x + 12, clip(" ".join(mode_bits), w - 14), row_attr)
            if model_status.runtime_failure_error_type and h >= 12:
                runtime_bits = [f"runtime={model_status.runtime_failure_error_type}"]
                if model_status.backend_died_after_healthy:
                    runtime_bits.append("died_after_healthy")
                self.add(y + 11, x + 2, "DEATH", self.dim | self.bold)
                self.add(y + 11, x + 12, clip(" ".join(runtime_bits), w - 14),
                         self.red | self.bold)
            if model_status.failed_candidate_key and h >= 12:
                recovery_bits = [f"failed={model_status.failed_candidate_key}"]
                if model_status.last_good_key:
                    recovery_bits.append(f"last_good={model_status.last_good_key}")
                if model_status.last_load_error_type:
                    recovery_bits.append(model_status.last_load_error_type)
                self.add(y + 10, x + 2, "RCVRY", self.dim | self.bold)
                self.add(y + 10, x + 12, clip(" ".join(recovery_bits), w - 14),
                         self.red | self.bold)

        # Service/recovery rows (rows 9 and 10 of the extended profile box)
        if srs is not None and h >= 12:
            svc_parts = []
            if srs.proxy_state:
                svc_parts.append(f"proxy={srs.proxy_state}")
            if srs.catalog_state:
                svc_parts.append(f"catalog={srs.catalog_state}")
            if srs.backend_state:
                svc_parts.append(f"backend={srs.backend_state}")
            if srs.model_state:
                svc_parts.append(f"model={srs.model_state}")
            if srs.request_admission and srs.request_admission not in ("accepted", ""):
                svc_parts.append(f"admission={srs.request_admission}")
            svc_attr = self.white
            if srs.fatal:
                svc_attr = self.red | self.bold
            elif srs.backend_state in ("unreachable", "failed", "unhealthy"):
                svc_attr = self.yellow | self.bold
            elif srs.model_state in ("failed", "mismatch"):
                svc_attr = self.yellow | self.bold
            self.add(y + 9, x + 2, "SERVICE", self.dim | self.bold)
            self.add(y + 9, x + 12, clip("  ".join(svc_parts) or "—", w - 14), svc_attr)

            rec_parts = [f"state={srs.recovery_state or 'none'}"]
            if srs.operator_action:
                rec_parts.append(f"action={srs.operator_action}")
            if srs.current_recovery_action:
                rec_parts.append(f"running={srs.current_recovery_action}")
            rec_parts.append(f"active_req={srs.active_requests}")
            rec_parts.append(f"jobs={srs.job_count}")
            if srs.backoff_active:
                rec_parts.append(f"backoff={srs.backoff_action or 'active'}")
            if srs.manual_required:
                rec_parts.append("manual_required")
            rec_attr = self.white
            if srs.recovery_state in ("failed", "manual_required"):
                rec_attr = self.red | self.bold
            elif srs.recovery_state in ("available", "in_progress", "throttled"):
                rec_attr = self.yellow | self.bold
            self.add(y + 10, x + 2, "RECOVERY", self.dim | self.bold)
            self.add(y + 10, x + 12, clip("  ".join(rec_parts), w - 14), rec_attr)

    def draw_container(self, y: int, x: int, h: int, w: int, cp: Optional[dict] = None):
        self.box(y, x, h, w, "CONTAINER")
        self.add(y + 1, x + 2, f"{'NAME':<16} {'STATUS':<27} PORTS", self.dim | self.bold)

        # Prefer proxy backend_manager data (works over HTTP, no docker dependency).
        # Fall back to local docker ps only when proxy data is unavailable.
        bmgr = (cp or {}).get("backend_manager") if isinstance(cp, dict) else None
        if isinstance(bmgr, dict) and bmgr.get("container_name"):
            name = bmgr.get("container_name", "")
            running = bmgr.get("container_running")
            phase = bmgr.get("phase", "")
            healthy = bmgr.get("backend_health_ok")
            if running and healthy and phase == "healthy":
                status = "Up (healthy)"
            elif running:
                status = f"Up ({phase})" if phase else "Up"
            else:
                status = "Exited" if phase else "Not running"
            server_port = os.environ.get("QZ_SERVER_PORT", "18084")
            ports = f"0.0.0.0:{server_port}->8080/tcp"
            attr = self.green if running else self.red | self.bold
            self.add(y + 2, x + 2, f"{clip(name, 16):<16} ", self.white)
            self.add(y + 2, x + 19, f"{clip(status, 27):<27}", attr)
            self.add(y + 2, x + 47, clip(ports, w - 50), self.white)
            return

        # Fallback: local docker ps (only works when co-located with backend)
        out = docker(
            [
                "ps",
                "-a",
                "--filter",
                f"name=^/{os.environ.get('QZ_CONTAINER', 'qwen36turbo')}$",
                "--format={{.Names}}|{{.Status}}|{{.Ports}}",
            ],
            timeout=2.0,
        )
        line = out.splitlines()[0] if out.splitlines() else "no container found||"
        parts = line.split("|")
        if len(parts) >= 3:
            name, status, ports = parts[0], parts[1], parts[2]
            attr = self.green if status.startswith("Up") else self.red | self.bold
            self.add(y + 2, x + 2, f"{clip(name, 16):<16} ", self.white)
            self.add(y + 2, x + 19, f"{clip(status, 27):<27}", attr)
            self.add(y + 2, x + 47, clip(ports, w - 50), self.white)
        else:
            self.add(y + 2, x + 2, clip(line, w - 4), self.red | self.bold)

    def draw_gpu(self, y: int, x: int, h: int, w: int, gpus: List[GpuRow], vram_snap: Optional[dict] = None):
        have_snap = isinstance(vram_snap, dict)
        # Box title: show proxy confidence when snapshot is available
        src_label = ""
        if have_snap:
            conf = vram_snap.get("confidence", "?")
            bm_avail = (vram_snap.get("backend_metrics") or {}).get("available", False)
            src_label = f" proxy/{conf}" + (" metrics=ok" if bm_avail else "")
        self.box(y, x, h, w, f"GPU{src_label}")

        if have_snap:
            # --- Proxy-informed display: no BASE/DELTA ---
            self.add(
                y + 1, x + 2,
                f"{'ID':<5} {'NAME':<24} {'UTIL':>5}  {'USED':>8} {'FREE':>8} {'TOTAL':>8} {'POWER':>7} {'TEMP':>5} {'PCIE':>8}",
                self.dim | self.bold,
            )
            rows = gpus[: max(0, h - 5)]  # leave room for TOTAL+VRAM+COMP rows
            for i, gpu in enumerate(rows):
                row = y + 2 + i
                name = clip(gpu.name, 24)
                free = max(0.0, gpu.mem_total - gpu.mem_used)
                row_text = (
                    f"GPU{gpu.index:<2} {name:<24} {gpu.util:>4.0f}%  "
                    f"{human_bytes_from_mib(gpu.mem_used, compact=True):>8} "
                    f"{human_bytes_from_mib(free, compact=True):>8} "
                    f"{human_bytes_from_mib(gpu.mem_total, compact=True):>8} "
                    f"{gpu.power:>5.1f}W {gpu.temp:>4.0f}C g{gpu.gen}x{gpu.width}"
                )
                self.add(row, x + 2, row_text, self.colour_for_util(gpu.util))
            # Physical GPU TOTAL (from nvidia-smi, condensed)
            gpu_total_row = y + 2 + len(rows)
            if gpus and gpu_total_row < y + h - 3:
                util, used_l, avail_l, total_l, power, temp = gpu_summary(gpus)
                total_text = (
                    f"{'TOTAL':<5} {'':<24} {util:>4.0f}%  "
                    f"{human_bytes_from_mib(used_l, compact=True):>8} "
                    f"{human_bytes_from_mib(avail_l, compact=True):>8} "
                    f"{human_bytes_from_mib(total_l, compact=True):>8} "
                    f"{power:>5.1f}W {temp:>4.0f}C {'-':>8}"
                )
                self.add(gpu_total_row, x + 2, total_text, self.cyan | self.bold)
            # VRAM proxy line (process isolation + source)
            vram_row = y + h - 3
            vtotals = vram_snap.get("totals") or {}
            backend = vram_snap.get("backend") or {}
            proc    = vtotals.get("backend_process_used_mib")
            proc_conf = backend.get("confidence", "unknown")
            proc_meth = backend.get("match_method", "")
            proc_str  = _mib_str(proc) if proc is not None else "?"
            vram_line = f"proc={proc_str}"
            if proc_conf != "unknown":
                vram_line += f" ({proc_conf[:10]}"
                if proc_meth:
                    vram_line += f"/{proc_meth[:14]}"
                vram_line += ")"
            self.add(vram_row, x + 2, "VRAM", self.dim | self.bold)
            self.add(vram_row, x + 8, clip(vram_line, w - 10),
                     _vram_confidence_colour(self, proc_conf))
            # COMP line (component summary)
            comp_line = _vram_comp_line(vram_snap)
            self.add(y + h - 2, x + 2, "COMP", self.dim | self.bold)
            self.add(y + h - 2, x + 8, clip(comp_line, w - 10), self.white)
        else:
            # --- Fallback: old local baseline display with BASE/DELTA ---
            update_vram_baseline(gpus, self.vram_baseline)
            self.add(
                y + 1, x + 2,
                f"{'ID':<5} {'NAME':<24} {'UTIL':>5}  {'USED':>8} {'BASE':>8} {'DELTA':>8} {'FREE':>8} {'TOTAL':>8} {'POWER':>7} {'TEMP':>5} {'PCIE':>8}",
                self.dim | self.bold,
            )
            rows = gpus[: max(0, h - 4)]
            for i, gpu in enumerate(rows):
                row = y + 2 + i
                name = clip(gpu.name, 24)
                used, base, delta, available = vram_parts(gpu, self.vram_baseline)
                row_text = (
                    f"GPU{gpu.index:<2} {name:<24} {gpu.util:>4.0f}%  "
                    f"{human_bytes_from_mib(used, compact=True):>8} "
                    f"{human_bytes_from_mib(base, compact=True):>8} "
                    f"{human_bytes_from_mib(delta, compact=True):>8} "
                    f"{human_bytes_from_mib(available, compact=True):>8} "
                    f"{human_bytes_from_mib(gpu.mem_total, compact=True):>8} "
                    f"{gpu.power:>5.1f}W {gpu.temp:>4.0f}C g{gpu.gen}x{gpu.width}"
                )
                self.add(row, x + 2, row_text, self.colour_for_util(gpu.util))
            if gpus and len(rows) < h - 3:
                util, _, _, _, power, temp = gpu_summary(gpus)
                used, base, delta, available, total = vram_split_summary(gpus, self.vram_baseline)
                row = y + 2 + len(rows)
                total_text = (
                    f"{'TOTAL':<5} {'':<24} {util:>4.0f}%  "
                    f"{human_bytes_from_mib(used, compact=True):>8} "
                    f"{human_bytes_from_mib(base, compact=True):>8} "
                    f"{human_bytes_from_mib(delta, compact=True):>8} "
                    f"{human_bytes_from_mib(available, compact=True):>8} "
                    f"{human_bytes_from_mib(total, compact=True):>8} "
                    f"{power:>5.1f}W {temp:>4.0f}C {'-':>8}"
                )
                self.add(row, x + 2, total_text, self.cyan | self.bold)

    def draw_throughput(self, y: int, x: int, h: int, w: int, rates: Rates):
        self.box(y, x, h, w, "LIVE THROUGHPUT")
        self.add(y + 1, x + 2, f"{'METRIC':<12} {'LATEST t/s':>10} {'MAX t/s':>10} {'TOKENS':>10} {'TIME':>9}", self.dim | self.bold)

        rows = [
            ("prompt", rates.prompt_latest, rates.prompt_max, rates.prompt_tokens, rates.prompt_ms),
            ("generate", rates.gen_latest, rates.gen_max, rates.gen_tokens, rates.gen_ms),
            ("total", rates.total_latest, rates.total_max, rates.total_tokens, rates.total_ms),
        ]
        for idx, (name, latest, max_rate, tokens, ms) in enumerate(rows):
            row = y + 2 + idx
            attr = self.green | self.bold if latest > 0 else self.dim
            row_text = (
                f"{name:<12} "
                f"{tps_str(latest):>10} "
                f"{tps_str(max_rate):>10} "
                f"{human_si(tokens, precision=1):>10} "
                f"{human_duration_ms(ms):>9}"
            )
            self.add(row, x + 2, row_text, attr)

        self.add(
            y + 6,
            x + 2,
            f"requests={human_si(rates.requests, precision=1):<5} checkpoints={human_si(rates.checkpoints, precision=1):<5} restores={human_si(rates.restores, precision=1):<5} CUDA_OOM=",
            self.white,
        )
        oom_attr = self.green | self.bold if rates.oom == 0 else self.red | self.bold
        self.add(y + 6, x + 60, human_si(rates.oom, precision=1), oom_attr)

    def draw_benchmark(self, y: int, x: int, h: int, w: int, benchmark: Optional[BenchmarkSummary]):
        if benchmark is None:
            return
        self.box(y, x, h, w, "BENCHMARK")
        line1 = (
            f"run={clip(benchmark.run_id, 16)} base={benchmark.baseline} "
            f"prompts={benchmark.prompt_count} cases={benchmark.cases} profiles={benchmark.profiles}"
        )
        line2 = (
            f"best={benchmark.best_profile} input={benchmark.best_input_ratio:.2f} "
            f"save={benchmark.best_input_savings * 100:.0f}% instr={benchmark.best_instructions_ratio:.2f} "
            f"final={benchmark.best_final_ratio:.2f} total={benchmark.best_total_ratio:.2f} wall={benchmark.best_wall_ratio:.2f}"
        )
        self.add(y + 1, x + 2, clip(line1, w - 4), self.cyan | self.bold)
        self.add(y + 2, x + 2, clip(line2, w - 4), self.cyan | self.bold)

    def draw_recent(self, y: int, x: int, h: int, w: int, rates: Rates):
        self.box(y, x, h, w, "RECENT")
        self.add(y + 1, x + 2, f"{'TYPE':<11} MESSAGE", self.dim | self.bold)
        max_msg = max(10, w - 17)
        for idx, (kind, msg) in enumerate((rates.recent or [])[-(h - 3):]):
            row = y + 2 + idx
            attr = self.white
            if kind == "OOM":
                attr = self.red | self.bold
            elif kind in ("restore", "checkpoint"):
                attr = self.cyan
            elif kind in ("prompt", "gen", "total", "throughput"):
                attr = self.green
            self.add(row, x + 2, f"{kind:<11}", attr | self.bold)
            self.add(row, x + 14, clip(msg, max_msg), self.white)

    def draw(self):
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()

        backend_ok = curl_health(
            os.environ.get("QZ_SERVER_HOST", "127.0.0.1"),
            os.environ.get("QZ_SERVER_PORT", "18084"),
        )
        proxy_ok = curl_health(
            os.environ.get("QZ_PROXY_HOST", "127.0.0.1"),
            os.environ.get("QZ_PROXY_PORT", "18180"),
        )

        rates = Rates(recent=[])
        cp = None
        # Prefer /qz/control-plane (proxy-owned summary); fall back to /qz/status.
        if proxy_ok:
            cp = control_plane_status()
            if isinstance(cp, dict) and cp.get("schema") == "qz.control_plane.status.v1":
                model_status = model_status_from_control_plane(cp)
            else:
                status = proxy_status()
                model_status = model_status_from_proxy(status)
            rates = merge_telemetry(rates, telemetry_recent())
        else:
            model_status = ModelStatus()
        srs = service_recovery_from_control_plane(cp)
        vram_snap = fetch_vram_snapshot(cp)

        # GPU data: prefer proxy vram_snapshot (already sourced from nvidia-smi
        # server-side, works over HTTP).  Fall back to local nvidia-smi only when
        # the proxy hasn't provided per-GPU data.
        gpus = gpus_from_vram_snap(vram_snap)
        if not gpus:
            gpus = parse_gpus()

        benchmark = latest_benchmark()

        self.draw_header(backend_ok, proxy_ok, gpus, vram_snap=vram_snap)

        if h < 32 or w < 100:
            self.add(4, 2, "Terminal too small. Need roughly 100x32.", self.red | self.bold)
            self.stdscr.refresh()
            return

        full_w = w - 2
        gpu_h = 8 + min(2, len(gpus))  # +3 vs original: physical TOTAL + VRAM + COMP rows
        self.draw_profile(3, 0, 12, full_w, model_status, srs, cp_is_none=(cp is None))
        self.draw_container(15, 0, 5, full_w, cp=cp)
        self.draw_gpu(20, 0, gpu_h, full_w, gpus, vram_snap=vram_snap)
        throughput_y = 20 + gpu_h
        self.draw_throughput(throughput_y, 0, 9, full_w, rates)
        benchmark_h = 5 if benchmark is not None else 0
        if benchmark is not None:
            self.draw_benchmark(throughput_y + 9, 0, 5, full_w, benchmark)

        recent_y = throughput_y + 9 + benchmark_h
        recent_h = max(6, h - recent_y - 2)
        self.draw_recent(recent_y, 0, recent_h, full_w, rates)

        self.add(h - 1, 0, " q quit  Ctrl-C quit ", self.dim | self.bold)
        self.stdscr.refresh()

    def loop(self):
        self.stdscr.nodelay(True)
        curses.curs_set(0)
        while self.running:
            self.draw()
            deadline = time.time() + self.interval
            while time.time() < deadline:
                try:
                    key = self.stdscr.getch()
                except KeyboardInterrupt:
                    return
                if key in (ord("q"), ord("Q")):
                    return
                if key == 3:
                    return
                time.sleep(0.05)


def once():
    backend = curl_health(os.environ.get("QZ_SERVER_HOST", "127.0.0.1"), os.environ.get("QZ_SERVER_PORT", "18084"))
    proxy = curl_health(os.environ.get("QZ_PROXY_HOST", "127.0.0.1"), os.environ.get("QZ_PROXY_PORT", "18180"))
    gpus = parse_gpus()
    rates = Rates(recent=[])
    cp = None
    # Prefer /qz/control-plane (proxy-owned summary); fall back to /qz/status.
    if proxy:
        cp = control_plane_status()
        if isinstance(cp, dict) and cp.get("schema") == "qz.control_plane.status.v1":
            model_status = model_status_from_control_plane(cp)
        else:
            status = proxy_status()
            model_status = model_status_from_proxy(status)
        rates = merge_telemetry(rates, telemetry_recent())
    else:
        model_status = ModelStatus()
    srs = service_recovery_from_control_plane(cp)
    vram_snap = fetch_vram_snapshot(cp)
    benchmark = latest_benchmark()

    backend_light = "●" if backend else "○"
    proxy_light = "●" if proxy else "○"
    print(f"QZ-TOP {time.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  ╭─ BACKEND {backend_light} ─╮  ╭─ PROXY {proxy_light} ─╮")
    print()
    print("PROFILE")
    if not proxy:
        print("  [PROXY OFFLINE — status unavailable]")
    live_ctx = context_display(model_status)
    print(f"  ctx={live_ctx} np={os.environ.get('QZ_PARALLEL', '?')} split={os.environ.get('QZ_TENSOR_SPLIT', '?')} batch={os.environ.get('QZ_BATCH', '?')} ubatch={os.environ.get('QZ_UBATCH', '?')} cache={human_bytes_from_mib(parse_num(os.environ.get('QZ_CACHE_RAM', '0')))} reuse={os.environ.get('QZ_CACHE_REUSE', '?')} kv={os.environ.get('QZ_KV_KEY', '?')}/{os.environ.get('QZ_KV_VALUE', '?')} rbudget={model_status.backend_reasoning_budget or '?'}")
    loaded_suffix = f" ({model_status.loaded_count})" if model_status.loaded_count > 1 else ""
    state = model_status.selected_state or model_status.load_state or "unknown"
    profile_bits = [model_status.profile or model_status.selected_key or "?"]
    if model_status.selected_backend_id and model_status.selected_backend_id not in profile_bits:
        profile_bits.append(f"backend={model_status.selected_backend_id}")
    if model_status.profile_symlink:
        profile_bits.append("symlink")
    print(f"  profile  : {' '.join(profile_bits)}")
    print(f"  prompt   : {', '.join((model_status.prompt_files or [])[:2]) or 'default'}")
    reasoning = " ".join(
        bit for bit in (
            model_status.reasoning_level,
            f"policy={model_status.reasoning_policy}" if model_status.reasoning_policy else "",
            _compact_sampling(model_status.sampling or {}),
        ) if bit
    )
    print(f"  reasoning: {reasoning or '?'}")
    print(f"  loaded   : {model_status.loaded or 'none'}{loaded_suffix}")
    print(f"  state    : {state}")
    if model_status.error:
        print(f"  error    : {model_status.error}")
    # Post-cleanup polish: model selection/lifecycle/recovery panel.
    if (model_status.request_admission_state or model_status.model_switch_state
            or model_status.failed_candidate_key or model_status.last_good_key):
        print()
        print("MODEL")
        line_bits = []
        line_bits.append(f"ready={str(model_status.selected_model_ready).lower()}")
        if model_status.request_admission_state:
            line_bits.append(f"admission={model_status.request_admission_state}")
        if model_status.model_switch_state:
            line_bits.append(f"switch={model_status.model_switch_state}")
        if model_status.active_load_operation and model_status.active_load_operation != "none":
            line_bits.append(f"op={model_status.active_load_operation}")
        if model_status.backend_gpu_state:
            line_bits.append(f"gpu={model_status.backend_gpu_state}")
        if model_status.selected_loaded_mismatch:
            line_bits.append("mismatch")
        if line_bits:
            print(f"  status   : {' '.join(line_bits)}")
        if model_status.launch_model_path_basename:
            print(f"  launch   : {model_status.launch_model_path_basename}")
        if model_status.last_good_key:
            print(f"  last_good: {model_status.last_good_key}")
        if model_status.failed_candidate_key:
            print(f"  failed   : {model_status.failed_candidate_key}")
        if model_status.last_load_error_type:
            err_brief = (model_status.last_load_error or "")[:80]
            print(f"  load_err : {model_status.last_load_error_type}: {err_brief}")
        if model_status.runtime_failure_error_type:
            err_brief = (model_status.runtime_failure_error or "")[:80]
            print(f"  runtime  : {model_status.runtime_failure_error_type}: {err_brief}")
    # Service/recovery state (from /qz/control-plane service_status + recovery)
    if srs.proxy_state or srs.backend_state or srs.model_state:
        svc_parts = []
        if srs.proxy_state:
            svc_parts.append(f"proxy={srs.proxy_state}")
        if srs.catalog_state:
            svc_parts.append(f"catalog={srs.catalog_state}")
        if srs.backend_state:
            svc_parts.append(f"backend={srs.backend_state}")
        if srs.model_state:
            svc_parts.append(f"model={srs.model_state}")
        if srs.request_admission:
            svc_parts.append(f"admission={srs.request_admission}")
        print(f"SERVICE  {'  '.join(svc_parts)}")
    rec_parts = [f"state={srs.recovery_state or 'none'}"]
    if srs.operator_action:
        rec_parts.append(f"action={srs.operator_action}")
    if srs.current_recovery_action:
        rec_parts.append(f"running={srs.current_recovery_action}")
    rec_parts.append(f"active_req={srs.active_requests}")
    rec_parts.append(f"jobs={srs.job_count}")
    if srs.backoff_active:
        rec_parts.append(f"backoff={srs.backoff_action or 'active'}")
    if srs.manual_required:
        rec_parts.append("manual_required")
    print(f"RECOVERY  {'  '.join(rec_parts)}")
    if srs.operator_action and srs.operator_hint:
        print(f"OPERATOR  action={srs.operator_action}  hint={srs.operator_hint}")
    if srs.job_count > 0 and srs.latest_job_action:
        job_line = f"JOB  latest={srs.latest_job_action}  {srs.latest_job_state}  {srs.latest_job_request_id}"
        if srs.latest_job_error:
            job_line += f"  error={srs.latest_job_error[:60]}"
        print(job_line)
    if srs.fatal and srs.last_error:
        print(f"FATAL  {srs.last_error[:120]}")
    print()
    print("GPU")
    for gpu in gpus:
        free = max(0.0, gpu.mem_total - gpu.mem_used)
        print(
            f"  GPU{gpu.index} {gpu.name:<26} util={gpu.util:3.0f}% "
            f"used={human_bytes_from_mib(gpu.mem_used)} free={human_bytes_from_mib(free)} "
            f"total={human_bytes_from_mib(gpu.mem_total)} "
            f"pwr={gpu.power:.1f}W temp={gpu.temp:.0f}C PCIe=g{gpu.gen}x{gpu.width}"
        )
    if gpus:
        util, used_l, avail_l, total_l, power, temp = gpu_summary(gpus)
        print(
            f"  TOTAL {'':<26} util={util:3.0f}% "
            f"used={human_bytes_from_mib(used_l)} free={human_bytes_from_mib(avail_l)} "
            f"total={human_bytes_from_mib(total_l)} "
            f"pwr={power:.1f}W temp={temp:.0f}C PCIe=-"
        )
    print()
    # VRAM SNAPSHOT section (proxy-owned, authoritative source labelling)
    print("VRAM SNAPSHOT")
    if isinstance(vram_snap, dict) and vram_snap.get("schema") == "qz.vram.snapshot.v1":
        vs = vram_snap
        totals = vs.get("totals") or {}
        ctx    = vs.get("context") or {}
        comps  = vs.get("components") or []
        print(
            f"  source={vs.get('source','?')}  "
            f"confidence={vs.get('confidence','?')}  "
            f"backend_confirmed={vs.get('backend_confirmed',False)}  "
            f"host_observed={vs.get('host_observed',False)}"
        )
        u_str = _mib_str(totals.get("used_mib"))
        a_str = _mib_str(totals.get("available_mib"))
        t_str = _mib_str(totals.get("total_mib"))
        bp_str = _mib_str(totals.get("backend_process_used_mib"))
        print(f"  TOTAL  used={u_str}  avail={a_str}  total={t_str}  backend_proc={bp_str}")
        # Context window
        ctx_lim  = ctx.get("limit_tokens")
        ctx_used = ctx.get("used_tokens")
        ctx_pct  = ctx.get("used_pct")
        ctx_src  = ctx.get("source", "unknown")
        ctx_str  = f"{ctx_used if ctx_used is not None else '?'}/{ctx_lim if ctx_lim else '?'}"
        if ctx_pct is not None:
            ctx_str += f" ({ctx_pct}%)"
        print(f"  CTX    {ctx_str}  source={ctx_src}")
        # Components table
        for comp in comps:
            mib_s = _mib_str(comp.get("mib"))
            conf  = comp.get("confidence", "unknown")
            src_s = comp.get("source", "unknown")
            label = comp.get("label", comp.get("name", "?")).upper()
            extra = ""
            if comp.get("context_used_pct") is not None:
                extra = f"  kv_used_pct={comp['context_used_pct']}%"
            elif comp.get("context_used_tokens") is not None:
                extra = f"  ctx_used={comp['context_used_tokens']}"
            elif comp.get("context_limit"):
                extra = f"  ctx_limit={comp['context_limit']}"
            est_marker = ""
            if comp.get("backend_confirmed"):
                est_marker = "✓"
            elif comp.get("estimated") and comp.get("mib") is not None:
                est_marker = "~"
            print(f"  {label:<10} {mib_s+est_marker:<14} conf={conf}  src={src_s}{extra}")
            # Brief note for model_file (provenance-only, not subtractive)
            if comp.get("name") == "model_file":
                print(f"    provenance-only  subtractive=False")
            # Diagnostics for unknown KV_ALLOC
            if comp.get("name") == "kv_alloc" and comp.get("mib") is None:
                if comp.get("architecture") or comp.get("missing_logical_fields"):
                    arch_s   = comp.get("architecture", "?")
                    missing  = comp.get("missing_logical_fields", [])
                    sample   = comp.get("available_metadata_keys_sample", [])[:6]
                    print(f"    arch={arch_s}  missing={missing}  meta_keys(sample)={sample}")
                for note in (comp.get("notes") or [])[:1]:
                    print(f"    note: {note[:140]}")
        # Backend metrics discovery
        bm = vs.get("backend_metrics") or {}
        if bm:
            bm_model = (bm.get("model") or "")[:55]
            bm_avail = bm.get("available", False)
            bm_src   = bm.get("model_source", "?")
            print(f"  METRICS available={bm_avail}  model={bm_model}  model_src={bm_src}")
            for ep, info in list((bm.get("endpoints") or {}).items())[:4]:
                kind = info.get("kind", "?")
                n    = info.get("metric_count", info.get("slot_count", ""))
                n_ctx = info.get("n_ctx", "")
                err  = info.get("error", "")
                ep_line = f"    {ep}: kind={kind}"
                if n != "":
                    ep_line += f" count={n}"
                if n_ctx:
                    ep_line += f" n_ctx={n_ctx}"
                if err:
                    ep_line += f" err={err[:60]}"
                print(ep_line)
        # Estimates/provenance block
        est = vs.get("estimates") or {}
        if est:
            cal = est.get("model_is_calibrated", False)
            mf_mib = est.get("model_file_mib")
            mf_str = f"  model_file={_mib_str(mf_mib)}~" if mf_mib else ""
            print(f"  ESTIMATES entry_src={est.get('model_entry_source','?')}  model_calibrated={cal}{mf_str}  kv_alloc_src={est.get('kv_alloc_source','?')}")
            if est.get("known_allocated_mib") is not None:
                print(f"  ALLOCATED {_mib_str(est['known_allocated_mib'])}~  conf={est.get('known_allocated_confidence','?')}")
            # Cache budget
            cb = est.get("cache_budget") or {}
            if cb.get("mib") is not None:
                print(f"  CACHE_BDG {_mib_str(cb['mib'])}  src={cb.get('source','?')}  raw={cb.get('raw','?')}")
            # KV dtype with bit widths
            kv_dt = est.get("kv_dtype") or {}
            if kv_dt:
                k_info = kv_dt.get("key_info") or {}
                v_info = kv_dt.get("value_info") or {}
                k_bits = k_info.get("nominal_bits")
                v_bits = v_info.get("nominal_bits")
                k_bpe  = kv_dt.get("key_bytes")
                v_bpe  = kv_dt.get("value_bytes")
                k_str = f"{kv_dt.get('key_type','?')}" + (f" {k_bits}b" if k_bits else "") + (f"/{k_bpe:.3f}B" if k_bpe else "/?B")
                v_str = f"{kv_dt.get('value_type','?')}" + (f" {v_bits}b" if v_bits else "") + (f"/{v_bpe:.3f}B" if v_bpe else "/?B")
                fs = "✓" if kv_dt.get("formula_safe") else "✗"
                print(f"  KV_DTYPE  key={k_str}  val={v_str}  formula_safe={fs}  src={kv_dt.get('source','?')}")
            # Consistency
            cons = est.get("consistency") or {}
            c_status = cons.get("status", "unknown")
            c_attr = f"  proc={_mib_str(cons.get('backend_process_used_mib'))}  est_alloc={_mib_str(cons.get('estimated_allocated_mib'))}  residual={_mib_str(cons.get('residual_mib'))}"
            if c_status == "overallocated":
                c_attr += f"  OVER_BY={_mib_str(cons.get('over_by_mib'))}"
            print(f"  CONSIST   {c_status}{c_attr}")
        # Notes
        for note in (vs.get("notes") or []):
            print(f"  note: {note}")
    else:
        print(f"  vram snapshot unavailable (proxy not reachable or no data)")
    print("LIVE THROUGHPUT")
    print(f"  prompt   latest={tps_str(rates.prompt_latest)} t/s  max={tps_str(rates.prompt_max)} t/s  tokens={human_si(rates.prompt_tokens, precision=1)}  time={human_duration_ms(rates.prompt_ms)}")
    print(f"  generate latest={tps_str(rates.gen_latest)} t/s  max={tps_str(rates.gen_max)} t/s  tokens={human_si(rates.gen_tokens, precision=1)}  time={human_duration_ms(rates.gen_ms)}")
    print(f"  total    latest={tps_str(rates.total_latest)} t/s  max={tps_str(rates.total_max)} t/s  tokens={human_si(rates.total_tokens, precision=1)}  time={human_duration_ms(rates.total_ms)}")
    _token_detail_parts = []
    if rates.cached_tokens:
        _token_detail_parts.append(f"cached={human_si(rates.cached_tokens, precision=1)}")
    if rates.reasoning_tokens:
        _token_detail_parts.append(f"reasoning={human_si(rates.reasoning_tokens, precision=1)}")
    if _token_detail_parts:
        print(f"  details  {' '.join(_token_detail_parts)}")
    print(f"  requests={human_si(rates.requests, precision=1)} checkpoints={human_si(rates.checkpoints, precision=1)} restores={human_si(rates.restores, precision=1)} CUDA_OOM={human_si(rates.oom, precision=1)}")
    if benchmark is not None:
        print()
        print("BENCHMARK")
        print(f"  run={benchmark.run_id} baseline={benchmark.baseline} prompts={benchmark.prompt_count} cases={benchmark.cases} profiles={benchmark.profiles}")
        print(f"  best={benchmark.best_profile} input_ratio={benchmark.best_input_ratio:.2f} input_savings={benchmark.best_input_savings * 100:.0f}% instr_ratio={benchmark.best_instructions_ratio:.2f} final_ratio={benchmark.best_final_ratio:.2f} total_ratio={benchmark.best_total_ratio:.2f} wall_ratio={benchmark.best_wall_ratio:.2f}")


def main():
    parser = argparse.ArgumentParser(description="QuantZhai top-style monitor")
    parser.add_argument("--once", "-1", action="store_true", help="print one snapshot and exit")
    parser.add_argument("-i", "--interval", type=float, default=1.0, help="refresh interval in seconds")
    args = parser.parse_args()

    if args.once:
        once()
        return

    def handle_signal(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    try:
        curses.wrapper(lambda stdscr: UI(stdscr, args.interval).loop())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
