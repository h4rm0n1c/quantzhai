#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/qz-env"

usage() {
  cat <<'EOF'
Usage: scripts/qz-up [options]

Start the QuantZhai proxy. The proxy autostarts the backend container.

Options:
  --hold                Keep the terminal open by attaching qz-top after startup.
  --codex-model MODEL   Start the stack, then open interactive Codex with MODEL selected.
  --codex MODEL         Alias for --codex-model MODEL.
  -h, --help            Show this help.

Environment:
  QZ_BACKEND_AUTOSTART  Set to 0 to disable automatic backend start (default: 1).
  QZ_PROXY_START_TIMEOUT  Seconds to wait for proxy /health (default: 20).

Backend lifecycle is managed by the proxy. Use these to inspect or control it:
  GET  http://QZ_PROXY_HOST:QZ_PROXY_PORT/qz/backend/status
  POST http://QZ_PROXY_HOST:QZ_PROXY_PORT/qz/backend/start
  POST http://QZ_PROXY_HOST:QZ_PROXY_PORT/qz/backend/stop
  POST http://QZ_PROXY_HOST:QZ_PROXY_PORT/qz/backend/restart
  scripts/qz-backend status|start|stop|restart
EOF
}

# write_runtime_state records a startup phase event to the OperationalStore
# (when QZ_OPERATIONAL_DB_ENABLED=1). Live status: /qz/control-plane.
# Event history: /qz/config/effective (operational_store section).
write_runtime_state() {
  python3 "$QZ_ROOT/scripts/qz-write-runtime-state" "$@" >/dev/null || true
}

hold=0
codex_model=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --hold)
      hold=1
      shift
      ;;
    --codex-model)
      codex_model="${2:-}"
      if [[ -z "$codex_model" ]]; then
        printf 'qz-up: --codex-model requires a MODEL argument\n' >&2
        exit 2
      fi
      shift 2
      ;;
    --codex)
      codex_model="${2:-}"
      if [[ -z "$codex_model" ]]; then
        printf 'qz-up: --codex requires a MODEL argument\n' >&2
        exit 2
      fi
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Reject old positional aliases that qz-codex also rejects.
case "${codex_model,,}" in
  low|medium|high|max|caveman)
    printf 'qz-up: "%s" is a deprecated profile alias and is no longer accepted.\n' "$codex_model" >&2
    printf '  Use a real model ID from /v1/models, for example:\n' >&2
    printf '    scripts/qz-codex exec -m kuato\n' >&2
    exit 64
    ;;
esac

mkdir -p "$QZ_VAR_DIR/logs" "$QZ_VAR_DIR/run" "$QZ_VAR_DIR/captures"
mkdir -p "$QZ_MODEL_DIR"

write_runtime_state --phase requested --source env

# -------------------------------------------------------------------------
# Start proxy. The proxy autostarts the backend container asynchronously
# (QZ_BACKEND_AUTOSTART=1 by default).
# -------------------------------------------------------------------------
"$QZ_ROOT/scripts/qz-proxy"
write_runtime_state --phase proxy-started --source env

printf 'QuantZhai proxy ready: http://%s:%s\n' "$QZ_PROXY_HOST" "$QZ_PROXY_PORT"
printf 'Backend starting asynchronously under proxy control.\n'
printf 'Check status:  GET  http://%s:%s/qz/backend/status\n' "$QZ_PROXY_HOST" "$QZ_PROXY_PORT"
printf 'Full status:   GET  http://%s:%s/qz/control-plane\n' "$QZ_PROXY_HOST" "$QZ_PROXY_PORT"
printf 'Stop stack:    scripts/qz-down\n'

# -------------------------------------------------------------------------
# --hold: attach qz-top now that the proxy is up.
# -------------------------------------------------------------------------
if [[ "$hold" == "1" ]]; then
  printf 'Attaching qz-top. Ctrl-C closes the monitor only.\n'
  printf 'Stop the stack with scripts/qz-down.\n'
  exec "$QZ_ROOT/scripts/qz-top"
fi

# -------------------------------------------------------------------------
# --codex-model: open interactive Codex with the named model pre-selected.
# -------------------------------------------------------------------------
if [[ -n "$codex_model" ]]; then
  write_runtime_state --phase codex-start --source model
  exec "$QZ_ROOT/scripts/qz-codex" -m "$codex_model"
fi
