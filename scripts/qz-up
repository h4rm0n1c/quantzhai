#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/qz-env"

usage() {
  cat <<'EOF'
Usage: scripts/qz-up [options]

Start the QuantZhai backend container and proxy.

Options:
  --hold                Keep the terminal open by attaching qz-top after startup.
  --codex-model MODEL   Start the stack, then open interactive Codex with MODEL selected.
  --codex MODEL         Alias for --codex-model MODEL.
  -h, --help            Show this help.

Environment:
  QZ_PROXY_READY_TIMEOUT   Seconds to wait for proxy catalog readiness (default: 60).
  QZ_MODEL_LOAD_TIMEOUT    Seconds to wait for llama.cpp backend /health (default: 120).
EOF
}

# write_runtime_state records a startup phase event to the OperationalStore
# (when QZ_OPERATIONAL_DB_ENABLED=1). Live status: /qz/control-plane.
# Event history: /qz/config/effective (operational_store section).
write_runtime_state() {
  python3 "$QZ_ROOT/scripts/qz-write-runtime-state" "$@" >/dev/null || true
}

hold=0
codex_model=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --hold)
      hold=1
      shift
      ;;
    --codex-model)
      codex_model="${2:-}"
      if [[ -z "$codex_model" ]]; then
        printf 'qz-up: --codex-model requires a MODEL argument\n' >&2
        exit 2
      fi
      shift 2
      ;;
    --codex)
      # Alias for --codex-model; help text was updated to say MODEL not PROFILE.
      codex_model="${2:-}"
      if [[ -z "$codex_model" ]]; then
        printf 'qz-up: --codex requires a MODEL argument\n' >&2
        exit 2
      fi
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Reject old positional aliases that qz-codex also rejects.
case "${codex_model,,}" in
  low|medium|high|max|caveman)
    printf 'qz-up: "%s" is a deprecated profile alias and is no longer accepted.\n' "$codex_model" >&2
    printf '  Use a real model ID from /v1/models, for example:\n' >&2
    printf '    scripts/qz-codex exec -m kuato\n' >&2
    exit 64
    ;;
esac

mkdir -p "$QZ_VAR_DIR/logs" "$QZ_VAR_DIR/run" "$QZ_VAR_DIR/captures"
mkdir -p "$QZ_MODEL_DIR"

write_runtime_state --phase requested --source env

if qz_docker ps -a --format '{{.Names}}' | grep -qx "$QZ_CONTAINER"; then
  qz_docker rm -f "$QZ_CONTAINER" >/dev/null
fi

backend_args=(
  --host 0.0.0.0
  --port 8080
  -ngl 999
  -c "$QZ_CONTEXT"
  -np "$QZ_PARALLEL"
  -b "$QZ_BATCH"
  -ub "$QZ_UBATCH"
  -t "$QZ_THREADS"
  -tb "$QZ_THREAD_BATCH"
  -fa on
  --split-mode layer
  --tensor-split "$QZ_TENSOR_SPLIT"
  --main-gpu "$QZ_MAIN_GPU"
  --kv-unified
  --reasoning on
  --reasoning-budget "$QZ_REASONING_BUDGET"
  --reasoning-budget-message "$QZ_REASONING_BUDGET_MESSAGE"
  --cache-ram "$QZ_CACHE_RAM"
  --cache-reuse "$QZ_CACHE_REUSE"
  --mlock
  -ctk "$QZ_KV_KEY"
  -ctv "$QZ_KV_VALUE"
  --metrics
  --reasoning-format deepseek
)

case "${QZ_SPEC_DEFAULT,,}" in
  1|true|yes|on)
    backend_args+=(--spec-default)
    ;;
esac

qz_docker run -d \
  --name "$QZ_CONTAINER" \
  --gpus all \
  --cap-add IPC_LOCK \
  --ulimit memlock=-1:-1 \
  -p "$QZ_SERVER_PORT:8080" \
  --mount "type=bind,src=$QZ_MODEL_DIR,dst=/models,readonly" \
  "$QZ_IMAGE" \
  --models-dir /models \
  "${backend_args[@]}"

write_runtime_state --phase backend-started --source env

# -------------------------------------------------------------------------
# Start proxy (waits for HTTP /health only).
# -------------------------------------------------------------------------
"$QZ_ROOT/scripts/qz-proxy"
write_runtime_state --phase proxy-started --source env --proxy-healthy --merge-proxy

# -------------------------------------------------------------------------
# Wait for proxy catalog readiness (levels 2-3: proxy ready + catalog ready).
# qz-proxy only verifies HTTP responsiveness; background catalog init may
# still be running. Use qz-wait-ready to gate on catalog_ready before
# announcing a usable stack.
# -------------------------------------------------------------------------
proxy_ready_timeout="${QZ_PROXY_READY_TIMEOUT:-60}"
if ! [[ "$proxy_ready_timeout" =~ ^[0-9]+$ ]] || [[ "$proxy_ready_timeout" -lt 1 ]]; then
  proxy_ready_timeout=60
fi
printf 'waiting for proxy catalog readiness (timeout %ss)...\n' "$proxy_ready_timeout"

if ! "$QZ_ROOT/scripts/qz-wait-ready" \
     --catalog \
     --wait-secs "$proxy_ready_timeout" 2>&1; then
  write_runtime_state --phase proxy-catalog-timeout --source env --proxy-healthy --merge-proxy
  printf 'proxy remains available at http://%s:%s for diagnostics.\n' \
    "$QZ_PROXY_HOST" "$QZ_PROXY_PORT" >&2
  exit 1
fi
write_runtime_state --phase proxy-ready --source env --proxy-healthy --merge-proxy
printf 'proxy catalog ready: http://%s:%s\n' "$QZ_PROXY_HOST" "$QZ_PROXY_PORT"

# -------------------------------------------------------------------------
# Wait for llama.cpp backend /health.
# This is the backend process, not the loaded model. Do not require model
# loading here; that happens on the first /v1/responses request or via
# /qz/models/refresh.
# -------------------------------------------------------------------------
printf 'waiting for backend: http://%s:%s/health\n' "$QZ_SERVER_HOST" "$QZ_SERVER_PORT"

backend_ok=0
backend_failed=0
backend_wait_seconds="${QZ_MODEL_LOAD_TIMEOUT%.*}"
if ! [[ "$backend_wait_seconds" =~ ^[0-9]+$ ]] || [[ "$backend_wait_seconds" -lt 1 ]]; then
  backend_wait_seconds=120
fi

for i in $(seq 1 "$backend_wait_seconds"); do
  if curl -fsS "http://$QZ_SERVER_HOST:$QZ_SERVER_PORT/health" >/dev/null 2>&1; then
    backend_ok=1
    break
  fi

  if ! qz_docker ps --format '{{.Names}}' | grep -qx "$QZ_CONTAINER"; then
    echo "backend container exited before becoming healthy" >&2
    qz_docker logs --tail=160 "$QZ_CONTAINER" >&2 || true
    backend_failed=1
    break
  fi

  sleep 1
done

if [[ "$backend_ok" != 1 ]]; then
  if [[ "$backend_failed" == 1 ]]; then
    write_runtime_state --phase backend-exited --source env --proxy-healthy --merge-proxy
    echo "proxy remains available at http://$QZ_PROXY_HOST:$QZ_PROXY_PORT for diagnostics." >&2
    exit 1
  fi
  echo "backend did not become healthy on http://$QZ_SERVER_HOST:$QZ_SERVER_PORT within ${backend_wait_seconds}s" >&2
  qz_docker ps -a --filter "name=^/${QZ_CONTAINER}$" >&2 || true
  qz_docker logs --tail=160 "$QZ_CONTAINER" >&2 || true
  write_runtime_state --phase backend-timeout --source env --proxy-healthy --merge-proxy
  echo "proxy remains available at http://$QZ_PROXY_HOST:$QZ_PROXY_PORT for diagnostics." >&2
  exit 1
fi

printf 'backend healthy: http://%s:%s\n' "$QZ_SERVER_HOST" "$QZ_SERVER_PORT"
write_runtime_state --phase backend-healthy --source env --backend-healthy --proxy-healthy --merge-proxy

# -------------------------------------------------------------------------
# --hold: attach qz-top now that proxy catalog and backend are both confirmed.
# -------------------------------------------------------------------------
if [[ "$hold" == "1" ]]; then
  printf 'QuantZhai stack is up. Attaching qz-top; Ctrl-C closes the monitor only.\n'
  printf 'Stop the stack with scripts/qz-down.\n'
  exec "$QZ_ROOT/scripts/qz-top"
fi

# -------------------------------------------------------------------------
# --codex-model: open interactive Codex with the named model pre-selected.
# Uses the interactive (non-exec) path so no prompt is required.
# -------------------------------------------------------------------------
if [[ -n "$codex_model" ]]; then
  write_runtime_state --phase codex-start --source model --backend-healthy --proxy-healthy --merge-proxy
  exec "$QZ_ROOT/scripts/qz-codex" -m "$codex_model"
fi
