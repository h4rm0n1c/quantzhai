#!/usr/bin/env python3
"""
Benchmark models via quantzhai router API, append to existing results.
Generates a single combined-score ranking table at the end.

Usage:
  qz-bench-all                              # new models not in results
  qz-bench-all --models Falcon-H1-7B ...    # specific models
  qz-bench-all --force                      # re-run everything
  qz-bench-all --models Nemotron-3 --force  # re-run one
  qz-bench-all --report                     # just print the report from existing data
"""
import json, time, os, sys, subprocess, urllib.request, argparse, re
from datetime import datetime, timezone
from pathlib import Path

sys.stdout.reconfigure(line_buffering=True)
sys.stderr.reconfigure(line_buffering=True)

ROUTER = "http://127.0.0.1:18084"
PROXY = "http://127.0.0.1:18180"
ROOT = Path(__file__).resolve().parent if __file__ else Path.cwd()
MODEL_DIR = os.environ.get("QZ_MODEL_DIR", str(Path.home() / "turboquant/quantzhai/var/models"))
VAR_DIR = os.environ.get("QZ_VAR_DIR", str(Path.home() / "turboquant/quantzhai/var"))
DOCKER_IMAGE = os.environ.get("QZ_IMAGE", "thetom-llama-cpp-turboquant:cuda-server") + "-build"
PPL_CORPUS = os.environ.get("QZ_PPL_CORPUS", str(ROOT.parent / "toolbox-ppl" / "macvox68.txt"))
SAVE_PATH = "/tmp/bench_all.json"
SKIP_MODELS = ("amber", "caveman", "kuato", "prompt-compiler", "qwen-blank")

def api(method, path, body=None, timeout=60, base=None):
    base = base or ROUTER
    url = f"{base}{path}"
    data = json.dumps(body).encode() if body else None
    req = urllib.request.Request(url, data=data,
        headers={"Content-Type": "application/json"} if body else {}, method=method)
    try:
        r = urllib.request.urlopen(req, timeout=timeout)
        return json.loads(r.read())
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}: {e.read().decode()[:200]}"}
    except Exception as e:
        return {"error": str(e)}

def proxy_api(method, path, body=None, timeout=120):
    return api(method, path, body, timeout, base=PROXY)

def get_models():
    inv_path = os.environ.get("QZ_MODEL_INVENTORY_CACHE",
        str(Path(os.environ.get("QZ_VAR_DIR", "")) / "generated" / "model-inventory.json"))
    with open(inv_path) as f:
        data = json.load(f)
    models = []
    for m in data.get("models", []):
        mid = m.get("key", m.get("filename", ""))
        stem = m.get("stem", mid.replace(".gguf", ""))
        if any(mid.startswith(s) or stem.startswith(s) for s in SKIP_MODELS):
            continue
        for ext in ("", ".gguf"):
            path = Path(MODEL_DIR) / f"{stem}{ext}"
            if path.is_symlink():
                break
        else:
            size = m.get("size_bytes", 0)
            if size > 0:
                models.append(stem)
    return models

def get_vram():
    r = api("GET", "/v1/models", timeout=30)
    if "error" in r: return []
    for m in r.get("data", []):
        s = m.get("status", {})
        if isinstance(s, dict) and s.get("value") == "loaded":
            return m.get("memory", {}).get("gpus", [])
    return []

def run_bench(prompt="The meaning of life is", model_id=""):
    timing = {"cold": {}, "warm": {}}
    body = json.dumps({"model": model_id, "input": prompt,
        "max_output_tokens": 50, "temperature": 0, "stream": False})
    for phase, label in [("cold", "C"), ("warm", "W")]:
        start = time.time()
        try:
            req = urllib.request.Request(f"{PROXY}/v1/responses",
                data=body.encode(), headers={"Content-Type": "application/json"}, method="POST")
            resp = json.loads(urllib.request.urlopen(req, timeout=120).read())
            elapsed = (time.time() - start) * 1000
            usage = resp.get("usage", {})
            ptok = usage.get("input_tokens", 0) or 0
            gtok = usage.get("output_tokens", 0) or 0
            timing[phase] = {
                "gen_tps": str(round(gtok / (elapsed / 1000), 1)) if elapsed > 0 else "0",
                "ttft_ms": str(round(elapsed, 0)),
                "cached_tokens": str(usage.get("input_tokens_details", {}).get("cached_tokens", 0)),
            }
        except Exception as e:
            timing[phase] = {"gen_tps": "?", "ttft_ms": f"error:{e}", "cached_tokens": "0"}
        if phase == "warm":
            time.sleep(2)
    c = timing["cold"].get("gen_tps")
    w = timing["warm"].get("gen_tps")
    if c and w and c != "?" and w != "?" and float(c) > 0:
        timing["speedup"] = round(float(w) / float(c), 1)
    return timing

def ensure_ppl_corpus():
    path = Path(PPL_CORPUS)
    if path.exists() and path.stat().st_size > 50000:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    import tempfile, shutil
    tmp = tempfile.mkdtemp()
    try:
        subprocess.run(["git", "clone", "--depth", "1",
            "https://github.com/h4rm0n1c/macvox68", f"{tmp}/macvox68"],
            capture_output=True, timeout=30, check=True)
        sources = []
        for root, dirs, files in os.walk(f"{tmp}/macvox68"):
            for f in files:
                if f.endswith((".c", ".h")):
                    try: sources.append(open(os.path.join(root, f)).read())
                    except: pass
        path.write_text("\n\n".join(sources), encoding="utf-8")
        print(f"  ToolboxPPL corpus: {path} ({path.stat().st_size} bytes, {len(sources)} files)")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

def run_ppl(model_gguf, cache_k="q8_0", cache_v="turbo3", ctx_size=2048):
    ensure_ppl_corpus()
    kill_stale_docker()
    try:
        r = subprocess.run(
            ["sudo", "-n", "docker", "run", "--rm", "--gpus", "all",
             "-v", f"{MODEL_DIR}:/models",
             "-v", f"{PPL_CORPUS}:/corpus.txt",
             "--entrypoint", "", DOCKER_IMAGE,
             "/app/build/bin/llama-perplexity",
             "--model", f"/models/{model_gguf}",
             "-f", "/corpus.txt",
             "--ppl-stride", "512",
             "-c", str(ctx_size),
             "--cache-type-v", cache_v,
             "--cache-type-k", cache_k,
             "--flash-attn", "1",
             "-ngl", "99",
             "-b", "512",
             "-t", "12"],
            capture_output=True, text=True, timeout=900)
        output = r.stdout + "\n" + (r.stderr or "")
        for line in output.split("\n"):
            line = line.strip()
            if re.match(r"^\[[0-9]+\]", line):
                chunks = [float(x.split("]")[1]) for x in line.split(",") if "]" in x]
                if chunks:
                    cold = chunks[0]
                    warm = sum(chunks[1:]) / len(chunks[1:]) if len(chunks) > 1 else cold
                    return (round(cold, 4), round(warm, 4))
        return (None, None)
    except subprocess.TimeoutExpired:
        return (None, None)
    except Exception as e:
        print(f"  PPL error: {e}")

def get_git_hash():
    candidates = [os.environ.get("QZ_BUILD_DIR", ""),
                  str(Path.home() / "turboquant-work/llama-cpp-turboquant")]
    for d in candidates:
        if not d: continue
        try:
            r = subprocess.run(["git", "rev-parse", "HEAD"],
                capture_output=True, text=True, timeout=5, cwd=d)
            if r.returncode == 0: return r.stdout.strip()[:12]
        except: pass
    return ""

def _get_ini_val(model_stem, key):
    ini_path = os.environ.get("QZ_MODEL_DIR", "") + "/models-preset.ini"
    if not os.path.isfile(ini_path): return None
    try:
        import configparser
        cp = configparser.ConfigParser()
        cp.optionxform = str
        cp.read(ini_path)
        for sec in (model_stem, "*"):
            if cp.has_section(sec):
                for k, v in cp.items(sec):
                    if k.lower() == key.lower() or k.lower().replace("_", "-") == key.lower():
                        return v
        return None
    except: return None

def get_preset_cache_k(model_stem): return _get_ini_val(model_stem, "cache-type-k")
def get_preset_cache_v(model_stem): return _get_ini_val(model_stem, "cache-type-v")

def select_model_via_proxy(model):
    print(f"  Selecting via proxy...")
    r = proxy_api("POST", "/qz/model/select-and-restart", {"model": model}, timeout=300)
    if r.get("failed_candidate_key") == model or r.get("last_load_error"):
        print(f"  Failed: {r.get('last_load_error','')[:80]}")
        return False
    if r.get("selected_model_ready"):
        return True
    for _ in range(10):
        time.sleep(3)
        r = proxy_api("GET", "/qz/model/status", timeout=10)
        if r.get("selected_model_ready") and r.get("selected_key") == model:
            return True
        if r.get("failed_candidate_key") == model:
            print(f"  Failed (rollback): {r.get('last_load_error','')[:80]}")
            return False
    print(f"  Timed out after 30s")
    return False

def kill_stale_docker(patterns=None):
    if patterns is None:
        patterns = ["perplexity", "llama-cli", "llama-server"]
    for pat in patterns:
        r = subprocess.run(["sudo", "-n", "docker", "ps", "-q", "--filter", f"name={pat}"],
            capture_output=True, text=True, timeout=10)
        for cid in r.stdout.strip().split("\n"):
            if cid:
                subprocess.run(["sudo", "-n", "docker", "kill", cid],
                    capture_output=True, timeout=5)
                subprocess.run(["sudo", "-n", "docker", "rm", "-f", cid],
                    capture_output=True, timeout=5)

def stop_backend_for_ppl():
    print(f"  Stopping backend for PPL...", flush=True)
    proxy_api("POST", "/qz/backend/stop", timeout=15)
    subprocess.run(["sudo", "-n", "docker", "rm", "-f", "qwen36turbo"],
        capture_output=True, timeout=15)
    kill_stale_docker()

def start_backend_after_ppl():
    print(f"  Cleaning up after PPL...", flush=True)
    kill_stale_docker()

def wait_for_proxy_ready(timeout=60):
    for _ in range(timeout // 3):
        try:
            r = proxy_api("GET", "/qz/model/status", timeout=5)
            if "configured_env_model" in r: return True
        except: pass
        time.sleep(3)
    return False

def load_existing_results():
    try: return json.load(open(SAVE_PATH))
    except: return []

def bench_one_model(model, force=False, existing_map=None):
    existing_map = existing_map or {}
    if model in existing_map and not force:
        print(f"  Skipping (already in results)")
        return existing_map[model]

    kill_stale_docker()
    if not select_model_via_proxy(model):
        print(f"  FAILED to select model, skipping")
        return {"model": str(model), "size": "?", "vram": "",
                "cold_gen_tps": "?", "warm_gen_tps": "?",
                "cold_ttft": "?", "warm_ttft": "?", "speedup": "",
                "cached": "?", "cache_k": "?", "cache_v": "?",
                "ppl_cold": "?", "ppl_warm": "?"}
    time.sleep(5)

    cache_k = get_preset_cache_k(model) or "q8_0"
    cache_v = get_preset_cache_v(model) or "turbo3"
    print(f"  K cache: {cache_k}  V cache: {cache_v}")

    gpus = get_vram()
    vram_str = ""
    for g in gpus:
        u = (g["total_bytes"] - g["free_bytes"]) / 1e9
        k = g["kv_bytes"] / 1e9
        m = g["model_bytes"] / 1e9
        f = g["free_bytes"] / 1e9
        vram_str += f" {g['name'].split()[-1]}:{u:.1f}G(m={m:.1f},kv={k:.1f},f={f:.1f})"
        print(f"  GPU: {g['name']}  used={u:.1f}G  model={m:.1f}G  kv={k:.1f}G  free={f:.1f}G")

    print(f"  Benchmarking...")
    timing = run_bench(model_id=model)
    cold = timing.get("cold", {})
    warm = timing.get("warm", {})
    print(f"  Cold: G:{cold.get('gen_tps','?')} TTFT:{cold.get('ttft_ms','?')}ms")
    print(f"  Warm: G:{warm.get('gen_tps','?')} TTFT:{warm.get('ttft_ms','?')}ms")

    stop_backend_for_ppl()
    model_file = model + ".gguf" if not model.endswith(".gguf") else model
    ppl_cold, ppl_warm = run_ppl(model_file, cache_k=cache_k, cache_v=cache_v, ctx_size=4096)
    ppl_cold_str = f"{ppl_cold:.4f}" if ppl_cold else "?"
    ppl_warm_str = f"{ppl_warm:.4f}" if ppl_warm else "?"
    print(f"  PPL: cold={ppl_cold_str} warm={ppl_warm_str}")
    start_backend_after_ppl()
    wait_for_proxy_ready()

    size_g = ""
    try:
        r2 = urllib.request.urlopen("http://127.0.0.1:18084/v1/models", timeout=10)
        for m2 in json.loads(r2.read()).get("data", []):
            if m2.get("id") == model:
                meta = m2.get("meta", {})
                size_g = f"{meta.get('size',0)/1e9:.1f}G" if meta.get('size') else ""
                break
    except: pass

    return {
        "model": model,
        "size": size_g if size_g else vram_str.split()[0] if vram_str else "",
        "cold_gen_tps": str(cold.get("gen_tps", "?")),
        "warm_gen_tps": str(warm.get("gen_tps", "?")),
        "cold_ttft": str(cold.get("ttft_ms", "?")),
        "warm_ttft": str(warm.get("ttft_ms", "?")),
        "speedup": str(timing.get("speedup", "")),
        "cached": str(warm.get("cached_tokens", "?")),
        "cache_k": str(cache_k),
        "cache_v": str(cache_v),
        "ppl_cold": str(ppl_cold_str),
        "ppl_warm": str(ppl_warm_str),
        "vram": str(vram_str),
    }

def generate_report(results, var_dir=None):
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    gh = get_git_hash()
    n = len(results)
    var_dir = var_dir or os.environ.get("QZ_VAR_DIR", str(Path.home() / "turboquant/quantzhai/var"))

    # Compute combined score (three equal dimensions):
    #   TPS         = throughput (cold×warm product, 90th percentile capped)
    #   PPL         = warm (hot) PPL (10th percentile capped)
    #   Convergence = cold_ppl / warm_ppl (>1 means PPL drops = model learns, 90th cap)
    #   Final       = (TPS + PPL + Conv) / 3 * 100 — each dimension equal weight
    # Three dimensions give "cool" models with unique strengths (fast convergence,
    # innovative architecture, tiny size) a fair shot against absolute-PPL champs.
    def percentile(values, p):
        s = sorted(values)
        idx = max(0, min(len(s) - 1, int(len(s) * p / 100)))
        return s[idx]

    tps_mags = []
    warm_ppls = []
    conv_ratios = []
    for r in results:
        try:
            ct = float(r.get("cold_gen_tps", 0) or 0)
            wt = float(r.get("warm_gen_tps", 0) or 0)
            pc = float(r.get("ppl_cold", 0) or 0)
            pw = float(r.get("ppl_warm", 0) or 0)
            if ct > 0 and wt > 0 and pc > 0 and pw > 0:
                tps_mags.append(ct * wt)
                warm_ppls.append(pw)
                conv_ratios.append(pc / pw)  # >1 = PPL drops = learns
        except: pass
    tps_cap = percentile(tps_mags, 90) if tps_mags else 1
    ppl_cap = percentile(warm_ppls, 10) if warm_ppls else 1
    conv_cap = percentile(conv_ratios, 90) if conv_ratios else 1

    def combined_score(r):
        try:
            ct = float(r.get("cold_gen_tps", 0) or 0)
            wt = float(r.get("warm_gen_tps", 0) or 0)
            pc = float(r.get("ppl_cold", 0) or 0)
            pw = float(r.get("ppl_warm", 0) or 0)
            if ct > 0 and wt > 0 and pc > 0 and pw > 0:
                tps_score = min(1.0, ct * wt / tps_cap)
                ppl_score = min(1.0, ppl_cap / pw)
                conv_score = min(1.0, (pc / pw) / conv_cap)
                return round((tps_score + ppl_score + conv_score) / 3 * 100, 1)
        except: pass
        return 0.0

    results_sorted = sorted(results, key=lambda r: combined_score(r), reverse=True)

    def parse_vram(s):
        g = []
        for p in s.split():
            if ":" not in p: continue
            m = re.search(r'm=([\d.]+)', p)
            kv = re.search(r'kv=([\d.]+)', p)
            g.append({"m": m.group(1) if m else "?", "kv": kv.group(1) if kv else "?"})
        return g

    # Look up file sizes from inventory
    size_map = {}
    try:
        inv_path = os.environ.get("QZ_MODEL_INVENTORY_CACHE",
            str(Path(var_dir) / "generated" / "model-inventory.json"))
        inv = json.load(open(inv_path))
        for m in inv.get("models", []):
            stem = m.get("stem", "")
            sz = m.get("size_bytes", 0)
            if stem and sz:
                size_map[stem] = f"{sz/1e9:.1f}G"
    except: pass

    # Report
    print(f"# QuantZhai Benchmark — Combined Ranking\n")
    print(f"*{n} models · {ts} UTC*\n")
    print("| # | Model | Size | PPL❄️ | PPL🔥 | ❄️TPS | 🔥TPS | **Score** | K | V | GPU0 M/KV | GPU1 M/KV |")
    print("|---:|------|---:|---:|---:|---:|---:|---:|:---:|:---:|---:|---:|")
    for idx, r in enumerate(results_sorted, 1):
        model = r["model"]
        # Use file size from inventory if available, fall back to vram
        fsize = "?"
        for stem in (model, model.replace(".gguf", "")):
            if stem in size_map:
                fsize = size_map[stem]
                break
        if fsize == "?":
            fsize = r.get("size", "?")
        gpus = parse_vram(r.get("vram", ""))
        g0 = f"{gpus[0]['m']}/{gpus[0]['kv']}" if len(gpus) > 0 else "?/?"
        g1 = f"{gpus[1]['m']}/{gpus[1]['kv']}" if len(gpus) > 1 else "?/?"
        mdl = model[:55] if len(model) > 55 else model
        sc = combined_score(r)
        sc_str = f"**{sc}**" if sc > 0 else "-"
        print(f"| {idx} | `{mdl}` | {fsize} | {r.get('ppl_cold','?')} | {r.get('ppl_warm','?')} | {r.get('cold_gen_tps','?')} | {r.get('warm_gen_tps','?')} | {sc_str} | {r.get('cache_k','?')} | {r.get('cache_v','?')} | {g0} | {g1} |")

    print(f"\n### Score Formula")
    print(f"Three equal dimensions (TPS, PPL, Convergence) averaged to 0–100.")
    print(f"Each scored 0–1 against a percentile cap (90th for TPS & convergence,")
    print(f"10th for warm PPL). Three dimensions give architecture diversity a fair")
    print(f"shot — fast learners (convergence) and innovative architectures can")
    print(f"compete with absolute-PPL champs.")
    print(f"TPS = `min(1, cold_tps * warm_tps / cap_90)`")
    print(f"PPL = `cap_10 / warm_ppl`")
    print(f"Conv = `min(1, (cold_ppl / warm_ppl) / cap_90)` — >1 means PPL drops")
    print(f"Final = `(TPS + PPL + Conv) / 3 * 100`\n")

    print("### Hardware & Engine")
    print(f"| GPU 0 | GPU 1 | Total VRAM | Engine |")
    print("|---|---|---|---|")
    print(f"| RTX 3080 10GB | V100-SXM2 16GB | 26 GB | llama.cpp @ {gh} |\n")

    print("### ToolboxPPL")
    print(f"Code perplexity on [`macvox68`](https://github.com/h4rm0n1c/macvox68) (32 C/H files, 125KB, Mac OS 7 TTS).")
    print(f"Ctx=4096, stride=512, K/V cache types match inference config.\n")

    print("### Key Takeaways\n")
    top3 = results_sorted[:3]
    print(f"**1st: {top3[0]['model'][:50]}** — Score {combined_score(top3[0]):.1f}")
    print(f"   PPL🔥={top3[0].get('ppl_warm','?')} TPS={top3[0].get('warm_gen_tps','?')}")
    print(f"**2nd: {top3[1]['model'][:50]}** — Score {combined_score(top3[1]):.1f}")
    print(f"   PPL🔥={top3[1].get('ppl_warm','?')} TPS={top3[1].get('warm_gen_tps','?')}")
    print(f"**3rd: {top3[2]['model'][:50]}** — Score {combined_score(top3[2]):.1f}")
    print(f"   PPL🔥={top3[2].get('ppl_warm','?')} TPS={top3[2].get('warm_gen_tps','?')}")

def main():
    parser = argparse.ArgumentParser(description="Benchmark models and generate combined ranking")
    parser.add_argument("--models", nargs="+", default=None,
        help="Specific models to benchmark (default: all new models not in existing results)")
    parser.add_argument("--force", action="store_true",
        help="Re-run benchmark even if results already exist")
    parser.add_argument("--report", action="store_true",
        help="Just print report from existing results, don't benchmark")
    args = parser.parse_args()

    # Load existing results
    existing = load_existing_results()
    existing_map = {r["model"]: r for r in existing}
    print(f"Loaded {len(existing)} existing results from {SAVE_PATH}")

    if args.report:
        generate_report(existing, var_dir=VAR_DIR)
        return

    # Determine which models to benchmark
    if args.models:
        models_to_bench = args.models
    else:
        all_models = get_models()
        models_to_bench = [m for m in all_models if m not in existing_map or args.force]

    if not models_to_bench:
        print("No models to benchmark. Use --force to re-run existing, or --models to specify.")
        generate_report(existing, var_dir=VAR_DIR)
        return

    print(f"Benchmarking {len(models_to_bench)} models\n")

    # Re-use existing results, updating any that get re-run
    results = list(existing)

    for idx, model in enumerate(models_to_bench):
        print(f"\n{'='*60}")
        print(f"[{idx+1}/{len(models_to_bench)}] {model}")
        result = bench_one_model(model, force=args.force, existing_map=existing_map)
        # Update or append
        for i, r in enumerate(results):
            if r["model"] == model:
                results[i] = result
                break
        else:
            results.append(result)
        json.dump(results, open(SAVE_PATH, "w"), indent=2)

    print(f"\n\n")
    generate_report(results, var_dir=VAR_DIR)
    json.dump(results, open(SAVE_PATH, "w"), indent=2)
    print(f"\nSaved {SAVE_PATH} ({len(results)} models)")

if __name__ == "__main__":
    main()
