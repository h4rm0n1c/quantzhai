#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/qz-env"

mkdir -p "$QZ_VAR_DIR/logs" "$QZ_VAR_DIR/run" "$QZ_VAR_DIR/captures"

pid_file="$QZ_VAR_DIR/run/qz-proxy.pid"

if [[ -f "$pid_file" ]]; then
  old_pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    kill "$old_pid"
  fi
fi

pkill -f "[q]uantzhai_proxy.py" 2>/dev/null || true
pkill -f "[q]wen36turbo_proxy.py" 2>/dev/null || true

proxy_cmd=(
  python3 "$QZ_ROOT/proxy/quantzhai_proxy.py"
  --listen "$QZ_PROXY_HOST" \
  --port "$QZ_PROXY_PORT" \
  --upstream "http://$QZ_SERVER_HOST:$QZ_SERVER_PORT" \
  --reasoning-stream-format summary
)

if command -v setsid >/dev/null 2>&1; then
  nohup setsid "${proxy_cmd[@]}" > "$QZ_VAR_DIR/logs/qz-proxy.log" 2>&1 &
else
  nohup "${proxy_cmd[@]}" > "$QZ_VAR_DIR/logs/qz-proxy.log" 2>&1 &
fi

echo "$!" > "$pid_file"
proxy_pid="$(cat "$pid_file")"
proxy_start_timeout="${QZ_PROXY_START_TIMEOUT:-20}"
if ! [[ "$proxy_start_timeout" =~ ^[0-9]+$ ]] || [[ "$proxy_start_timeout" -lt 1 ]]; then
  proxy_start_timeout=20
fi
deadline=$((SECONDS + proxy_start_timeout))
proxy_ready=0

while (( SECONDS < deadline )); do
  if ! kill -0 "$proxy_pid" 2>/dev/null; then
    break
  fi
  if curl -fsS --max-time 1 "http://$QZ_PROXY_HOST:$QZ_PROXY_PORT/health" >/dev/null 2>&1; then
    proxy_ready=1
    break
  fi
  sleep 0.2
done

if ! kill -0 "$proxy_pid" 2>/dev/null; then
  echo "proxy failed to start; see $QZ_VAR_DIR/logs/qz-proxy.log" >&2
  exit 1
fi

if [[ "$proxy_ready" != 1 ]]; then
  echo "proxy did not answer /health on http://$QZ_PROXY_HOST:$QZ_PROXY_PORT within ${proxy_start_timeout}s; see $QZ_VAR_DIR/logs/qz-proxy.log" >&2
  exit 1
fi

printf 'proxy listening: http://%s:%s\n' "$QZ_PROXY_HOST" "$QZ_PROXY_PORT"
