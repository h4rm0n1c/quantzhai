#!/usr/bin/env python3
"""
Benchmark via qz-codex exec.  All metrics from user-facing sources:
  - nvidia-smi for GPU telemetry
  - docker logs for server slot timing  
  - router /v1/models for model config, VRAM, KV cache
  - qz-codex exec for prompt execution
  - git for engine version

Usage:
  scripts/qz-bench-telemetry --prompt "text" [--output dir]
  scripts/qz-bench-telemetry --list-prompts
  scripts/qz-bench-telemetry --prompt-id readme-summary
"""
import json, time, os, sys, subprocess, argparse, re, urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROXY = "http://127.0.0.1:18180"
ROUTER = "http://127.0.0.1:18084"
DOCKER_CONTAINER = "qwen36turbo"

def nvidia_smi():
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=index,name,temperature.gpu,power.draw,utilization.gpu,memory.used,memory.total",
            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=10)
        gpus = []
        for line in r.stdout.strip().split("\n"):
            p = [x.strip() for x in line.split(",")]
            if len(p) >= 7:
                gpus.append({"index": int(p[0]), "name": p[1], "temp_c": float(p[2]),
                             "power_w": float(p[3]), "util_pct": float(p[4]),
                             "mem_used_mib": float(p[5]), "mem_total_mib": float(p[6])})
        return gpus
    except Exception as e:
        return [{"error": str(e)}]

def router_models():
    """Get loaded model info from the router."""
    try:
        r = urllib.request.urlopen(f"{ROUTER}/v1/models", timeout=10)
        data = json.loads(r.read())
        for m in data.get("data", []):
            s = m.get("status", {})
            if isinstance(s, dict) and s.get("value") == "loaded":
                return m
    except: pass
    return {}

def router_all_models():
    """Get all model entries (for unloaded model metadata)."""
    try:
        r = urllib.request.urlopen(f"{ROUTER}/v1/models", timeout=10)
        return json.loads(r.read()).get("data", [])
    except: return []

def telemetry_recent():
    """Get latest completed request timing from the proxy's telemetry."""
    try:
        r = urllib.request.urlopen(f"{PROXY}/qz/telemetry/recent", timeout=10)
        data = json.loads(r.read())
        events = data.get("events", [])
        # Find the newest request_completed event
        for ev in reversed(events):
            if ev.get("type") != "request_completed":
                continue
            p = ev.get("payload", {})
            usage = p.get("usage", {})
            input_details = usage.get("input_tokens_details", {})
            output_details = usage.get("output_tokens_details", {})
            pt_ms = p.get("prompt_ms", 0) or 0
            ge_ms = p.get("gen_ms", 0) or 0
            ptok = usage.get("input_tokens", 0) or 0
            gtok = usage.get("output_tokens", 0) or 0
            runtime = p.get("runtime_metrics", {}) or {}
            sampling = runtime.get("active_sampling", {}) or {}

            result = {
                "prefill_ms": round(pt_ms, 1),
                "prefill_tokens": ptok,
                "prefill_tps": round(ptok / (pt_ms / 1000), 1) if pt_ms > 0 else 0,
                "gen_ms": round(ge_ms, 1),
                "gen_tokens": gtok,
                "gen_tps": round(gtok / (ge_ms / 1000), 1) if ge_ms > 0 else 0,
                "ttft_ms": round(pt_ms, 1),
                "latency_between_tokens_ms": round(ge_ms / gtok, 2) if ge_ms > 0 and gtok > 0 else 0,
                "total_tokens": usage.get("total_tokens", 0),
                "elapsed_ms": round(p.get("elapsed_ms", 0), 1),
                "cached_tokens": input_details.get("cached_tokens", 0),
                "reasoning_tokens": output_details.get("reasoning_tokens", 0),
                "sampling": sampling,
                "reasoning_level": runtime.get("active_reasoning_level", ""),
                "reasoning_policy": runtime.get("active_reasoning_policy", ""),
                "thinking_budget": runtime.get("active_thinking_budget_tokens"),
                "context_length": runtime.get("selected_context_length"),
                "backend_context_length": runtime.get("backend_context_length"),
            }
            return result
    except Exception as e:
        return {"error": str(e)}
    return {}

def extract_child_args(model_info):
    """Extract key=value pairs from child process args."""
    args = {}
    if not model_info: return args
    status = model_info.get("status", {})
    if not isinstance(status, dict): return args
    raw = status.get("args", [])
    for i in range(len(raw) - 1):
        if raw[i].startswith("--"):
            args[raw[i].lstrip("-")] = raw[i + 1]
    return args

def extract_chat_template():
    """Extract chat template from container startup logs (one-time)."""
    try:
        r = subprocess.run(["sudo", "docker", "logs", DOCKER_CONTAINER, "--tail", "500"],
            capture_output=True, text=True, timeout=10)
        for line in r.stdout.split("\n"):
            if "chat template" in line:
                m = re.search(r"chat template, example_format: '(.*)'", line)
                if m: return m.group(1)[:200]
    except: pass
    return ""

def get_git_hash():
    candidates = [
        os.environ.get("QZ_BUILD_DIR", ""),
        str(ROOT.parent / "llama-cpp-turboquant"),
        "/home/harri/turboquant-work/llama-cpp-turboquant",
    ]
    for d in candidates:
        if not d: continue
        try:
            g = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, timeout=5, cwd=d)
            if g.returncode == 0: return g.stdout.strip()[:12]
        except: pass
    return ""

def get_model_source():
    try:
        r = urllib.request.urlopen(f"{PROXY}/qz/model/status", timeout=5)
        d = json.loads(r.read())
        return d.get("backend_loaded_model_source", "unknown")
    except: return "unknown"

def load_prompts():
    path = ROOT / "config" / "default" / "benchmark-prompts.json"
    if path.exists(): return json.loads(path.read_text()).get("prompts", [])
    return []

def run_codex(prompt, timeout_sec=300):
    result = subprocess.run(
        [str(ROOT / "scripts" / "qz-codex"), "exec", "--", prompt],
        capture_output=True, text=True, timeout=timeout_sec)
    return result

def main():
    parser = argparse.ArgumentParser(description="QuantZhai benchmark via qz-codex")
    parser.add_argument("--prompt", help="Prompt text")
    parser.add_argument("--prompt-id", help="Benchmark fixture id")
    parser.add_argument("--output", help="Output directory")
    parser.add_argument("--list-prompts", action="store_true")
    args = parser.parse_args()

    if args.list_prompts:
        for p in load_prompts():
            print(f"  {p['id']:30s} [{p['category']}] {p['goal'][:60]}")
        return

    prompt = args.prompt
    fixture = {}
    if args.prompt_id:
        for p in load_prompts():
            if p["id"] == args.prompt_id:
                prompt = p["prompt"]; fixture = p; break
        if not prompt: print(f"Prompt '{args.prompt_id}' not found"); sys.exit(1)
    if not prompt: prompt = "The meaning of life is"

    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    out_dir = Path(args.output) if args.output else ROOT / "var" / "benchmarks" / ts
    out_dir.mkdir(parents=True, exist_ok=True)

    git_hash = get_git_hash()
    chat_template = extract_chat_template()
    model_source = get_model_source()

    # Model config and VRAM before
    model_info = router_models()
    child_args = extract_child_args(model_info)
    meta = model_info.get("meta", {})
    mem = model_info.get("memory", {})
    kv_before = sum(g.get("kv_bytes", 0) for g in mem.get("gpus", []))
    gpu_before = nvidia_smi()

    def run_one(pass_name, prompt_text, timeout_s=300):
        """Run a single benchmark pass (cold or warm)."""
        print(f"  [{pass_name}] Running...")
        codex_result = run_codex(prompt_text, timeout_s)
        timing = telemetry_recent()
        if "error" in timing:
            print(f"  Telemetry error: {timing['error']}")
        return codex_result, timing

    # Cold pass
    cold_result, cold_timing = run_one("cold", prompt)

    # Warm pass — same prompt again (prompt cache should hit)
    warm_result, warm_timing = run_one("warm", prompt)

    # GPU telemetry after both passes
    gpu_after = nvidia_smi()

    # KV cache after
    model_info_after = router_models()
    mem_after = model_info_after.get("memory", {})
    kv_after = sum(g.get("kv_bytes", 0) for g in mem_after.get("gpus", []))
    peak_mem = max(g.get("mem_used_mib", 0) for g in gpu_before + gpu_after)

    def parse_think(output_text):
        think_tokens = 0
        m = re.search(r"<thought>(.*?)</thought>", output_text, re.DOTALL)
        if m: think_tokens = len(m.group(1).split())
        gen_text = re.sub(r"<thought>.*?</thought>", "", output_text, flags=re.DOTALL).strip()
        return think_tokens, len(gen_text.split())

    def build_timing(t, output_text):
        think_tok, gen_est = parse_think(output_text)
        return {
            "prefill_tps": t.get("prefill_tps"),
            "gen_tps": t.get("gen_tps"),
            "ttft_ms": t.get("ttft_ms"),
            "prefill_tokens": t.get("prefill_tokens"),
            "gen_tokens": t.get("gen_tokens"),
            "prefill_ms": t.get("prefill_ms"),
            "gen_ms": t.get("gen_ms"),
            "latency_between_tokens_ms": t.get("latency_between_tokens_ms"),
            "think_tokens": think_tok,
            "think_tps": round(think_tok / (t.get("gen_ms", 1) / 1000), 1) if t.get("gen_ms") and think_tok > 0 else 0,
            "time_thinking_ms": None,
            "output_tokens_est": gen_est,
            "cached_tokens": t.get("cached_tokens"),
            "reasoning_tokens": t.get("reasoning_tokens"),
            "elapsed_ms": t.get("elapsed_ms"),
        }

    # Common engine/model/config sections
    engine = {
        "name": "llama.cpp (turboquant fork)",
        "git_commit": git_hash,
        "hardware": "RTX 3080 10GB + V100-SXM2 32GB (no NVLink)",
        "tensor_split": child_args.get("tensor-split", "10,32"),
        "split_mode": child_args.get("split-mode", "layer"),
        "kv_cache_k": child_args.get("cache-type-k", "q8_0"),
        "kv_cache_v": child_args.get("cache-type-v", "turbo3"),
        "flash_attn": child_args.get("flash-attn", "on"),
        "context_size": int(child_args.get("ctx-size", 0) or meta.get("n_ctx", 0)),
        "batch_size": int(child_args.get("batch-size", 0)),
        "ubatch_size": int(child_args.get("ubatch-size", 0)),
        "threads": int(child_args.get("threads", 0)),
        "threads_batch": int(child_args.get("threads-batch", 0)),
        "n_gpu_layers": int(child_args.get("n-gpu-layers", 0)),
        "main_gpu": int(child_args.get("main-gpu", 0)),
        "cache_ram_mib": int(child_args.get("cache-ram", 0)),
        "cache_reuse": int(child_args.get("cache-reuse", 0)),
        "mlock": "--mlock" in str(child_args),
        "kv_unified": "--kv-unified" in str(child_args),
        "parallel": int(child_args.get("parallel", 1)),
        "tensor_split_raw": child_args.get("tensor-split", ""),
    }
    model_info_section = {
        "name": model_info.get("id", ""),
        "source": model_source,
        "n_params": meta.get("n_params", 0),
        "size_bytes": meta.get("size", 0),
        "n_ctx": meta.get("n_ctx", 0),
        "n_ctx_train": meta.get("n_ctx_train", 0),
        "n_embd": meta.get("n_embd", 0),
        "chat_template": chat_template,
        "reasoning": child_args.get("reasoning", "off"),
        "reasoning_budget": child_args.get("reasoning-budget", ""),
        "reasoning_format": child_args.get("reasoning-format", "raw"),
        "spec_decode": "draft-mtp" if child_args.get("spec-type") == "draft-mtp" else ("default" if "--spec-default" in str(child_args) else "none"),
    }
    config_section = {
        "prompt": prompt,
        "prompt_id": args.prompt_id or fixture.get("id", ""),
        "prompt_category": fixture.get("category", ""),
        "expected_tools": fixture.get("expected_tools", []),
        "via": "qz-codex exec",
    }
    memory_section = {
        "gpu_before": [{"name": g.get("name"), "total_bytes": g.get("total_bytes"),
                         "free_bytes": g.get("free_bytes"), "model_bytes": g.get("model_bytes"),
                         "kv_bytes": g.get("kv_bytes")} for g in mem.get("gpus", [])],
        "gpu_after": [{"name": g.get("name"), "total_bytes": g.get("total_bytes"),
                        "free_bytes": g.get("free_bytes"), "model_bytes": g.get("model_bytes"),
                        "kv_bytes": g.get("kv_bytes")} for g in mem_after.get("gpus", [])],
        "kv_cache_bytes_before": kv_before,
        "kv_cache_bytes_after": kv_after,
        "kv_cache_delta": kv_after - kv_before if kv_after and kv_before else None,
        "peak_gpu_mib": peak_mem,
        "requested_memory": {"cache_ram_mib": child_args.get("cache-ram", "8192"),
                             "n_gpu_layers": child_args.get("n-gpu-layers", "999")},
    }
    gpu_telemetry_section = {
        "before": [{"index": g["index"], "name": g["name"], "temp_c": g["temp_c"], "power_w": g["power_w"],
                    "util_pct": g["util_pct"], "mem_used_mib": g["mem_used_mib"], "mem_total_mib": g.get("mem_total_mib", 0)}
                   for g in gpu_before if "error" not in g],
        "after": [{"index": g["index"], "name": g["name"], "temp_c": g["temp_c"], "power_w": g["power_w"],
                   "util_pct": g["util_pct"], "mem_used_mib": g["mem_used_mib"], "mem_total_mib": g.get("mem_total_mib", 0)}
                  for g in gpu_after if "error" not in g],
    }

    ts = datetime.now(timezone.utc).isoformat()
    cold_out = cold_result.stdout or ""
    warm_out = warm_result.stdout or ""

    result = {
        "timestamp": ts,
        "engine": engine,
        "model": model_info_section,
        "config": config_section,
        "cold": {
            "timing": build_timing(cold_timing, cold_out),
            "codex": {
                "exit_code": cold_result.returncode,
                "stdout_len": len(cold_out),
                "stderr_len": len(cold_result.stderr or ""),
                "output": cold_out[-2000:] if cold_out else "",
            },
        },
        "warm": {
            "timing": build_timing(warm_timing, warm_out),
            "codex": {
                "exit_code": warm_result.returncode,
                "stdout_len": len(warm_out),
                "stderr_len": len(warm_result.stderr or ""),
                "output": warm_out[-2000:] if warm_out else "",
            },
        },
        "timing": build_timing(warm_timing, warm_out),  # canonical = warm
        "memory": memory_section,
        "gpu_telemetry": gpu_telemetry_section,
    }

    (out_dir / "result.json").write_text(json.dumps(result, indent=2, default=str))
    (out_dir / "prompt.txt").write_text(prompt)

    print(f"\n{'='*60}")
    for label, t_key in [("Cold", cold_timing), ("Warm", warm_timing)]:
        ct = build_timing(t_key, cold_out if label == "Cold" else warm_out)
        if ct.get("gen_tps"):
            print(f"  [{label}] P:{ct['prefill_tokens']}t@{ct['prefill_tps']:.0f}t/s  "
                  f"G:{ct['gen_tokens']}t@{ct['gen_tps']:.0f}t/s  "
                  f"TTFT:{ct['ttft_ms']:.0f}ms  Cached:{ct['cached_tokens']}tok")
    if gpu_before and gpu_after and len(gpu_before) > 0 and len(gpu_after) > 0:
        dt = gpu_after[0]['temp_c'] - gpu_before[0]['temp_c']
        dw = gpu_after[0]['power_w'] - gpu_before[0]['power_w']
        print(f"  GPU gain: +{dt:.0f}C, +{dw:.0f}W")
    print(f"  Saved: {out_dir / 'result.json'}")

if __name__ == "__main__":
    main()
