#!/usr/bin/env bash

# This file is sourced by both QuantZhai scripts and humans during diagnostics.
# Do not set -e/-u/-o pipefail here: shell options leak into the caller when a
# file is sourced, and can make an interactive terminal exit after later benign
# command failures. Entrypoint scripts should set their own strict mode.

_qz_env_names=(
  QZ_IMAGE QZ_DOCKER_CMD QZ_CONTAINER QZ_BUILD_DIR QZ_TQ_REPO QZ_TQ_BRANCH
  QZ_CUDA_ARCH QZ_MODEL_DIR QZ_MODEL_KEY QZ_MODEL_OVERRIDES
  QZ_MODEL_INVENTORY_CACHE QZ_MODEL_STATE_PATH QZ_BACKEND_STATE_PATH
  QZ_CAPTURE_MODE QZ_SERVER_HOST
  QZ_SERVER_PORT QZ_PROXY_HOST QZ_PROXY_PORT QZ_CONTEXT QZ_PARALLEL QZ_BATCH
  QZ_UBATCH QZ_THREADS QZ_THREAD_BATCH QZ_TENSOR_SPLIT QZ_MAIN_GPU
  QZ_CACHE_RAM QZ_CACHE_REUSE QZ_KV_KEY QZ_KV_VALUE QZ_MODEL_LOAD_TIMEOUT
  QZ_REASONING_BUDGET QZ_SPEC_DEFAULT
  QZ_SEARCHENGINES_BASE_URL SEARXNG_AGENT_API_BASE
  SEARXNG_BASE_URL SEARXNG_TIMEOUT SEARXNG_POLICY
  SEARXNG_CAPABILITIES QZ_SEARCH_CONFIG_PATH
  QZ_REQUIRE_GPU QZ_GPU_LOG_TAIL
)

for _qz_name in "${_qz_env_names[@]}"; do
  if [[ -v $_qz_name ]]; then
    printf -v "_qz_env_override_${_qz_name}" '%s' "${!_qz_name}"
    printf -v "_qz_env_override_set_${_qz_name}" '%s' "1"
  fi
done

QZ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export QZ_ROOT
export QZ_VAR_DIR="$QZ_ROOT/var"

if [[ -f "$QZ_ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$QZ_ROOT/.env"
  set +a
fi

for _qz_name in "${_qz_env_names[@]}"; do
  _qz_set_var="_qz_env_override_set_${_qz_name}"
  _qz_value_var="_qz_env_override_${_qz_name}"
  if [[ -v $_qz_set_var ]]; then
    printf -v "$_qz_name" '%s' "${!_qz_value_var}"
    export "$_qz_name"
    unset "$_qz_set_var" "$_qz_value_var"
  fi
done
unset _qz_env_names _qz_name _qz_set_var _qz_value_var

export QZ_IMAGE="${QZ_IMAGE:-thetom-llama-cpp-turboquant:cuda-server}"
export QZ_DOCKER_CMD="${QZ_DOCKER_CMD:-docker}"
export QZ_CONTAINER="${QZ_CONTAINER:-qwen36turbo}"
export QZ_BUILD_DIR="${QZ_BUILD_DIR:-$HOME/turboquant-work}"
export QZ_TQ_REPO="${QZ_TQ_REPO:-https://github.com/h4rm0n1c/llama-cpp-turboquant.git}"
export QZ_TQ_BRANCH="${QZ_TQ_BRANCH:-feature/vram-http-metrics}"
export QZ_CUDA_ARCH="${QZ_CUDA_ARCH:-70;86}"
export QZ_MODEL_DIR="${QZ_MODEL_DIR:-$QZ_ROOT/var/models}"
export QZ_MODEL_KEY="${QZ_MODEL_KEY:-}"
if [[ -z "${QZ_MODEL_OVERRIDES:-}" ]]; then
  export QZ_MODEL_OVERRIDES="$QZ_ROOT/config/user/model-overrides.json"
else
  export QZ_MODEL_OVERRIDES
fi
export QZ_MODEL_INVENTORY_CACHE="${QZ_MODEL_INVENTORY_CACHE:-$QZ_ROOT/var/generated/model-inventory.json}"
export QZ_MODEL_STATE_PATH="${QZ_MODEL_STATE_PATH:-$QZ_ROOT/var/model-state.json}"
export QZ_BACKEND_STATE_PATH="${QZ_BACKEND_STATE_PATH:-$QZ_ROOT/var/backend-state.json}"
export QZ_CAPTURE_MODE="${QZ_CAPTURE_MODE:-off}"
export QZ_CAPTURE_RETAIN_DAYS="${QZ_CAPTURE_RETAIN_DAYS:-7}"
export QZ_SERVER_HOST="${QZ_SERVER_HOST:-127.0.0.1}"
export QZ_SERVER_PORT="${QZ_SERVER_PORT:-18084}"
export QZ_PROXY_HOST="${QZ_PROXY_HOST:-127.0.0.1}"
export QZ_PROXY_PORT="${QZ_PROXY_PORT:-18180}"
export QZ_CONTEXT="${QZ_CONTEXT:-262144}"
export QZ_PARALLEL="${QZ_PARALLEL:-1}"
export QZ_BATCH="${QZ_BATCH:-4096}"
export QZ_UBATCH="${QZ_UBATCH:-512}"
export QZ_THREADS="${QZ_THREADS:-12}"
export QZ_THREAD_BATCH="${QZ_THREAD_BATCH:-12}"
export QZ_TENSOR_SPLIT="${QZ_TENSOR_SPLIT:-10,16}"
export QZ_MAIN_GPU="${QZ_MAIN_GPU:-0}"
export QZ_CACHE_RAM="${QZ_CACHE_RAM:-8192}"
export QZ_CACHE_REUSE="${QZ_CACHE_REUSE:-256}"
export QZ_KV_KEY="${QZ_KV_KEY:-q8_0}"
export QZ_KV_VALUE="${QZ_KV_VALUE:-turbo3}"
export QZ_MODEL_LOAD_TIMEOUT="${QZ_MODEL_LOAD_TIMEOUT:-120}"
export QZ_REASONING_BUDGET="${QZ_REASONING_BUDGET:--1}"
export QZ_REASONING_BUDGET_MESSAGE="${QZ_REASONING_BUDGET_MESSAGE:-I have reasoned long enough. Let me now produce my final answer.}"
export QZ_REASONING_CARRY_FORWARD="${QZ_REASONING_CARRY_FORWARD:-0}"
export QZ_SPEC_DEFAULT="${QZ_SPEC_DEFAULT:-0}"
export QZ_REQUIRE_GPU="${QZ_REQUIRE_GPU:-1}"
export QZ_GPU_LOG_TAIL="${QZ_GPU_LOG_TAIL:-1000}"

# searchengines Agent API facade base URL.
# The canonical variable is QZ_SEARCHENGINES_BASE_URL. SEARXNG_AGENT_API_BASE is
# an accepted alias. SEARXNG_BASE_URL is a legacy alias that QuantZhai treats as the
# Agent API facade base (not raw SearXNG).
# Resolution priority: QZ_SEARCHENGINES_BASE_URL > SEARXNG_AGENT_API_BASE > SEARXNG_BASE_URL > http://127.0.0.1:8890
export QZ_SEARCHENGINES_BASE_URL="${QZ_SEARCHENGINES_BASE_URL:-http://127.0.0.1:8890}"
export SEARXNG_AGENT_API_BASE="${SEARXNG_AGENT_API_BASE:-${QZ_SEARCHENGINES_BASE_URL}}"
# Primary search config: config/default/search.json (qz.search.v1).
# User overrides: config/user/search.json. QZ_SEARCH_CONFIG_PATH for explicit path.
# SEARXNG_POLICY is legacy fallback; search.json takes precedence when present.
# SEARXNG_BASE_URL defaults to QZ_SEARCHENGINES_BASE_URL (Agent API facade).
export SEARXNG_BASE_URL="${SEARXNG_BASE_URL:-${QZ_SEARCHENGINES_BASE_URL}}"
export SEARXNG_TIMEOUT="${SEARXNG_TIMEOUT:-15}"
export SEARXNG_POLICY="${SEARXNG_POLICY:-$QZ_ROOT/config/default/search-policy.json}"
if [[ "$SEARXNG_POLICY" == "$QZ_ROOT/docs/searxng-agent-policy-profiled.json" && ! -f "$SEARXNG_POLICY" ]]; then
  export SEARXNG_POLICY="$QZ_ROOT/config/default/search-policy.json"
fi
export SEARXNG_CAPABILITIES="${SEARXNG_CAPABILITIES:-}"
export QZ_SEARCH_CONFIG_PATH="${QZ_SEARCH_CONFIG_PATH:-}"

qz_docker() {
  $QZ_DOCKER_CMD "$@"
}
