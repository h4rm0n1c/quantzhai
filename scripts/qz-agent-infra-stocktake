#!/usr/bin/env python3
"""Print detected QuantZhai agent infrastructure and feature-grade evidence."""
import os
import sys
import json
import urllib.request
import urllib.error

# Add proxy to path
sys.path.append(os.path.join(os.path.dirname(os.path.dirname(__file__)), "proxy"))

try:
    from qz_tools import CODEX_NATIVE_TOOL_NAMES, synthesize_tool_error_result
    from qz_proxy_tools import DEFAULT_TOOL_REGISTRY, make_proxy_local_tool_registry
    from qz_feedback import FeedbackVisibility, FeedbackChannel, render_coercion_error
    from qz_native_tool_output import CLASSIFIERS
    from qz_stream_watchdog import STREAM_NO_OUTPUT_TIMEOUT_S, STREAM_TERMINAL_TIMEOUT_S
except ImportError as exc:
    print(f"Error importing proxy modules: {exc}")
    sys.exit(1)

def print_section(title):
    print(f"\n=== {title} ===")

def report(label, status, msg=""):
    color = {
        "PASS": "\033[92m",
        "WARN": "\033[93m",
        "FAIL": "\033[91m",
        "UNKNOWN": "\033[94m",
    }.get(status, "")
    reset = "\033[0m" if color else ""
    print(f"{label:35} : {color}{status}{reset} {msg}")

def check_file_contains(path, pattern):
    if not os.path.exists(path):
        return False
    with open(path, 'r') as f:
        return pattern in f.read()

def main():
    print("QuantZhai Agent Infrastructure Stocktake (Evidence-Grade)")
    
    print_section("Feature Flags (Environment)")
    flags = [
        "QZ_BRAINCASE_TOOLS_ENABLED",
        "QZ_BRAINCASE_WRITE_CANDIDATE_ENABLED",
        "QZ_STREAM_NO_OUTPUT_TIMEOUT_S",
        "QZ_STREAM_TERMINAL_TIMEOUT_S",
        "SEARXNG_AGENT_API_BASE",
    ]
    for flag in flags:
        val = os.environ.get(flag, "(unset)")
        print(f"{flag:35} : {val}")

    print_section("Code Wiring Evidence")
    
    # 1. Native Classifier Wiring
    router_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "proxy", "qz_request_router.py")
    uses_signals = check_file_contains(router_path, "classify_native_tool_output_signals")
    if uses_signals:
        report("Native Classifier (SignalDecision)", "PASS", "qz_request_router wires structured signals")
    else:
        report("Native Classifier (SignalDecision)", "WARN", "qz_request_router uses legacy tuples")

    # 1b. Sandbox Advisory (model-visible)
    has_advisory_helper = check_file_contains(router_path, "_model_visible_native_advisories")
    has_advisory_text = check_file_contains(router_path, "_SANDBOX_READONLY_ADVISORY_TEXT")
    advisory_tests_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "tests", "test_qz_request_router.py")
    has_advisory_tests = check_file_contains(advisory_tests_path, "SandboxAdvisoryHelperTests")
    if has_advisory_helper and has_advisory_text and has_advisory_tests:
        report("Sandbox Advisory (model-visible)", "PASS",
               "_model_visible_native_advisories wired + tests present")
    elif has_advisory_helper:
        report("Sandbox Advisory (model-visible)", "WARN",
               "advisory helper present but tests or text constant missing")
    else:
        report("Sandbox Advisory (model-visible)", "WARN",
               "native classifier is telemetry-only; model-visible advisory not yet wired")

    # 2. Tool Error Delegation
    # synthesize_tool_error_result() must import render_coercion_error from qz_feedback.
    tools_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "proxy", "qz_tools.py")
    delegates = check_file_contains(tools_path, "render_coercion_error")
    if delegates:
        report("Tool Error Delegation", "PASS", "qz_tools delegates to qz_feedback")
    else:
        report("Tool Error Delegation", "WARN", "qz_tools contains duplicate error logic")

    # 2b. Coercion Telemetry Enrichment
    # coercion_succeeded/coercion_failed events must carry source="tool_adapter".
    router_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "proxy", "qz_request_router.py")
    stream_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "proxy", "qz_responses_stream.py")
    test_stream_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "tests", "test_qz_responses_stream.py")
    has_source_router = check_file_contains(router_path, '"source": "tool_adapter"')
    has_source_stream = check_file_contains(stream_path, '"source": "tool_adapter"')
    has_coercion_tests = check_file_contains(test_stream_path, "coercion_succeeded") and \
                         check_file_contains(test_stream_path, "source.*tool_adapter") or \
                         check_file_contains(test_stream_path, "\"source\"")
    if has_source_router and has_source_stream:
        report("Coercion Telemetry", "PASS",
               "source=tool_adapter in coercion_succeeded/coercion_failed (router + stream)")
    elif has_source_router or has_source_stream:
        report("Coercion Telemetry", "WARN",
               "source=tool_adapter in one path only (router={} stream={})".format(
                   has_source_router, has_source_stream))
    else:
        report("Coercion Telemetry", "WARN", "coercion telemetry missing source field")

    # 3. Watchdog Defaults
    if STREAM_NO_OUTPUT_TIMEOUT_S > 0:
        report("Stream Watchdog (No-Output)", "PASS", f"Enabled ({STREAM_NO_OUTPUT_TIMEOUT_S}s)")
    else:
        report("Stream Watchdog (No-Output)", "WARN", "Disabled by default (0s)")

    if STREAM_TERMINAL_TIMEOUT_S > 0:
        report("Stream Watchdog (Terminal)", "PASS", f"Enabled ({STREAM_TERMINAL_TIMEOUT_S}s)")
    else:
        report("Stream Watchdog (Terminal)", "WARN", "Disabled by default (0s)")

    # 4. BrainCase Gating
    bc_enabled = os.environ.get("QZ_BRAINCASE_TOOLS_ENABLED", "0") == "1"
    if bc_enabled:
        report("BrainCase Tools", "PASS", "Active (Enabled via ENV)")
    else:
        report("BrainCase Tools", "PASS", "Inactive (Gated as expected)")

    print_section("Live Capability Checks")
    proxy_url = f"http://{os.environ.get('QZ_PROXY_HOST', '127.0.0.1')}:{os.environ.get('QZ_PROXY_PORT', '18180')}"
    
    # Try web-search capabilities
    try:
        with urllib.request.urlopen(f"{proxy_url}/qz/web-search/capabilities", timeout=2) as r:
            body = r.read().decode('utf-8')
            try:
                data = json.loads(body)
            except json.JSONDecodeError:
                report("Web Search Capabilities", "FAIL", "Invalid JSON returned")
                return

            # Tolerate either:
            # - top-level provider_guidance
            # - nested capabilities.provider_guidance
            # - raw capabilities object without ok=true
            has_guidance = "provider_guidance" in data or ("capabilities" in data and isinstance(data["capabilities"], dict) and "provider_guidance" in data["capabilities"])
            
            # If it's a valid JSON and reachable, it's at least PASS/WARN
            # We don't strictly require data.get("ok") if the schema is correct
            is_valid_schema = data.get("schema") == "qz.web_search.capabilities.v1"
            
            status = "PASS" if (is_valid_schema and has_guidance) else "WARN"
            msg = "Live and reachable"
            if has_guidance: msg += " (w/ guidance)"
            if not is_valid_schema: msg += f" (unexpected schema: {data.get('schema', 'none')})"
            
            report("Web Search Capabilities", status, msg)
    except urllib.error.URLError:
        report("Web Search Capabilities", "UNKNOWN", f"Proxy unreachable at {proxy_url}")
    except Exception as e:
        report("Web Search Capabilities", "FAIL", str(e))

    # Try SearxNG guidance if configured
    searx_base = os.environ.get("SEARXNG_AGENT_API_BASE")
    if searx_base:
        try:
            with urllib.request.urlopen(f"{searx_base}/guidance", timeout=2) as r:
                report("SearxNG Guidance Endpoint", "PASS", "Reachable")
        except urllib.error.URLError:
            report("SearxNG Guidance Endpoint", "FAIL", f"Unreachable at {searx_base}")
        except Exception as e:
            report("SearxNG Guidance Endpoint", "FAIL", str(e))
    else:
        report("SearxNG Guidance Endpoint", "UNKNOWN", "SEARXNG_AGENT_API_BASE not set")

    print("\nStocktake complete.")

if __name__ == "__main__":
    main()
