#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/qz-codex-common"

case "${1:-}" in
  low|medium|high|max|caveman)
    printf 'qz-codex: profile argument %s is deprecated; select a model from the Codex model picker or pass Codex CLI arguments directly\n' "$1" >&2
    exit 64
    ;;
esac

qz_prepare_codex_home

QZ_CODEX_ARGS=("$@")
QZ_CODEX_EXTRA_ARGS=()
if [[ -n "${QZ_CODEX_MODEL_PROVIDER:-}" ]]; then
  QZ_CODEX_EXTRA_ARGS+=(-c "model_provider=\"$QZ_CODEX_MODEL_PROVIDER\"")
fi

# --- Effective model resolution: A, B, or C ---
#
# A. User explicitly passed -m / --model → use that exact model (strict).
# B. No explicit model + QuantZhai already has a selected model →
#    use the selected model; no hardcoded fallback, no config.toml guess.
# C. No explicit model + no selected model (fresh install) →
#    POST /qz/model/select-and-restart with no "model" field so the proxy
#    picks its catalog default (source=qz_codex); then wait/poll until ready.
#
# For exec mode without an explicit -m, the resolved model is injected as -m
# so Codex does not fall back to a stale config.toml selection.
#
# See docs/qz-codex-wrapper-contract.md for the full behavior contract.

_explicit_model_arg="$(qz_exec_model_from_args "${QZ_CODEX_ARGS[@]}")"

if [[ -n "$_explicit_model_arg" ]]; then
  # A: user explicitly passed -m / --model
  _preflight_model="$_explicit_model_arg"
elif [[ "${QZ_CODEX_ARGS[0]:-}" == "exec" && -n "${QZ_CODEX_EXEC_DEFAULT_MODEL:-}" ]]; then
  # exec + operator-set env-var override (treated as explicit)
  _preflight_model="$QZ_CODEX_EXEC_DEFAULT_MODEL"
  QZ_CODEX_ARGS=(exec -m "$QZ_CODEX_EXEC_DEFAULT_MODEL" "${QZ_CODEX_ARGS[@]:1}")
else
  # B / C: no explicit model — resolve from QuantZhai's selected model (or
  # bootstrap the first catalog entry on a fresh install).
  _preflight_model="$(qz_resolve_effective_model)" || exit $?
  # For exec mode: inject the resolved model so Codex does not use a stale
  # config.toml selection from a previous interactive session.
  if [[ "${QZ_CODEX_ARGS[0]:-}" == "exec" && -n "$_preflight_model" ]]; then
    QZ_CODEX_ARGS=(exec -m "$_preflight_model" "${QZ_CODEX_ARGS[@]:1}")
  fi
fi

# Preflight: verify the effective model is active (or wait while it loads).
# Distinguishes: ready / loading (wait) / failed (abort) / mismatch (error or auto-select).
# QZ_CODEX_AUTO_SELECT_MODEL=1 enables auto-select for explicit-model mismatches only.
if [[ -n "$_preflight_model" ]]; then
  qz_codex_exec_preflight "$_preflight_model" || exit $?
fi

exec codex "${QZ_CODEX_EXTRA_ARGS[@]}" "${QZ_CODEX_ARGS[@]}"
