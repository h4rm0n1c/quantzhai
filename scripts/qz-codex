#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/qz-codex-common"

case "${1:-}" in
  low|medium|high|max|caveman)
    printf 'qz-codex: profile argument %s is deprecated; select a model from the Codex model picker or pass Codex CLI arguments directly\n' "$1" >&2
    exit 64
    ;;
esac

qz_prepare_codex_home

qz_exec_has_model_selector() {
  local arg
  for arg in "${@:2}"; do
    case "$arg" in
      -m|--model|-p|--profile|--model=*|--profile=*)
        return 0
        ;;
      --)
        break
        ;;
    esac
  done
  return 1
}

QZ_CODEX_ARGS=("$@")
if [[ "${1:-}" == "exec" ]]; then
  case "${2:-}" in
    resume|review|help|-h|--help)
      ;;
    *)
      if ! qz_exec_has_model_selector "$@"; then
        if [[ -n "${QZ_CODEX_EXEC_DEFAULT_MODEL:-}" ]]; then
          QZ_CODEX_ARGS=(exec -m "$QZ_CODEX_EXEC_DEFAULT_MODEL" "${@:2}")
        else
          cat >&2 <<'EOF'
qz-codex: exec requires an explicit -m/--model or -p/--profile.

Reason: Codex persists the last selected model in $CODEX_HOME/config.toml,
so non-interactive captures can silently run under a roleplay profile instead
of the intended coding/compiler profile.

Example:
  ./scripts/qz-codex exec -m prompt-compiler --json --ephemeral 'Say done.'

To set a wrapper default for exec runs:
  QZ_CODEX_EXEC_DEFAULT_MODEL=prompt-compiler ./scripts/qz-codex exec --json --ephemeral 'Say done.'
EOF
          exit 64
        fi
      fi
      ;;
  esac
fi

QZ_CODEX_EXTRA_ARGS=()
if [[ -n "${QZ_CODEX_MODEL_PROVIDER:-}" ]]; then
  QZ_CODEX_EXTRA_ARGS+=(-c "model_provider=\"$QZ_CODEX_MODEL_PROVIDER\"")
fi

# Model preflight: verify the requested model is the active selected/loaded
# backend model via GET /qz/model/status.  Visibility in /v1/models is no
# longer sufficient.
#
# When QZ_CODEX_AUTO_SELECT_MODEL=1, a mismatch triggers a POST to
# /qz/model/select-and-restart (source=qz_codex).  Otherwise mismatch fails
# with a literal curl command the operator can paste.
#
# See docs/proxy-model-selection-authority.md §8.

_preflight_model="$(qz_exec_model_from_args "${QZ_CODEX_ARGS[@]}")"
if [[ -z "$_preflight_model" ]]; then
  if [[ "${QZ_CODEX_ARGS[0]:-}" == "exec" ]]; then
    _preflight_model="${QZ_CODEX_EXEC_DEFAULT_MODEL:-}"
  else
    # In interactive mode, check if we have a persisted selection in config.toml
    # that Codex will use on startup.
    _preflight_model=$(grep -E '^\s*model\s*=' "$CODEX_HOME/config.toml" 2>/dev/null | cut -d'"' -f2 || true)
    if [[ -z "$_preflight_model" ]]; then
       # Fall back to proxy's currently selected model so we at least verify it is READY.
       _preflight_model=$(qz_proxy_loaded_model)
    fi
  fi
fi

if [[ -n "$_preflight_model" ]]; then
  # Preflight distinguishes: visibility vs selection vs readiness.
  qz_codex_exec_preflight "$_preflight_model" || exit $?
fi

exec codex "${QZ_CODEX_EXTRA_ARGS[@]}" "${QZ_CODEX_ARGS[@]}"
