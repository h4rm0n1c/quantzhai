#!/usr/bin/env python3
"""
qz-extract-session-corpus — Extract coding agent sessions into a compaction corpus.

Sources:
  - Codex JSONL rollouts (var/codex-home/sessions/, ~/.codex/sessions/)
  - Claude Code JSONL projects (~/.claude/projects/)

Curation strategy: domain diversity over volume.
  - Keeps up to MAX_PER_PROJECT sessions per cwd to avoid domain over-fitting.
  - Always keeps non-quantzhai projects (game, search, etc.) for generalization.
  - Prioritises sessions with compaction events (ground truth pairs).

Output: var/session-corpus/<session-id>/
  - input.json           — full conversation as /v1/responses input array
  - meta.json            — token counts, compaction events, source, domain
  - compact_N.json       — each compaction event's pre-blob items (ground truth)
  - pre-compact.json     — items before first compaction
  - post-compact.json    — items after first compaction

Usage:
  scripts/qz-extract-session-corpus [--dry-run] [--min-tokens N]
"""
import argparse
import json
import os
import re
import sys
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_OUTPUT = ROOT / "var" / "session-corpus"

# Curation knobs
MAX_PER_PROJECT = 3          # max sessions extracted per cwd slug
QUANTZHAI_MAX = 3            # QuantZhai is over-represented; cap harder
MIN_TOKENS = 8_000           # skip very short sessions
THINKING_BLOCK_MIN = 5       # Claude sessions: must have at least N thinking blocks

# Harness noise to strip
_HARNESS_PREFIXES = (
    "<permissions instructions>",
    "<collaboration_mode>",
    "<skills_instructions>",
    "<environment_context>",
    "you are qwen3.6turbo running locally",
    "<local-command-caveat>",
)


def _is_harness(text: str) -> bool:
    if not isinstance(text, str):
        return False
    low = text.strip().lower()
    return any(low.startswith(p.lower()) for p in _HARNESS_PREFIXES)


def _flatten_content(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if not isinstance(item, dict):
                parts.append(str(item))
                continue
            for key in ("text", "input_text", "output_text"):
                val = item.get(key)
                if isinstance(val, str) and val.strip():
                    parts.append(val)
                    break
        return "\n".join(parts)
    return ""


# ---------------------------------------------------------------------------
# Codex JSONL extractor
# ---------------------------------------------------------------------------

def extract_codex_session(path: Path) -> dict | None:
    """Parse one Codex rollout JSONL into a normalised corpus entry."""
    events = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        events.append(json.loads(line))
                    except json.JSONDecodeError:
                        pass
    except OSError:
        return None
    if not events:
        return None

    meta_evt = next((e for e in events if e.get("type") == "session_meta"), {})
    meta_pl = meta_evt.get("payload", {})
    session_id = meta_pl.get("id", path.stem)
    cwd = meta_pl.get("cwd", "")
    model_provider = meta_pl.get("model_provider", "")

    input_items = []
    compaction_points = []   # list of (item_index, token_count_at_compact)
    peak_tokens = 0

    for event in events:
        etype = event.get("type")
        payload = event.get("payload") or {}

        if etype == "event_msg":
            msg_type = payload.get("type")
            if msg_type == "token_count":
                tok = payload.get("token_count") or payload.get("count") or 0
                if isinstance(tok, (int, float)):
                    peak_tokens = max(peak_tokens, int(tok))
            elif msg_type == "task_started":
                ctx = payload.get("model_context_window")
                if isinstance(ctx, (int, float)):
                    peak_tokens = max(peak_tokens, int(ctx))
            elif msg_type == "user_message":
                text = _flatten_content(payload.get("content") or payload.get("text") or "")
                if text.strip() and not _is_harness(text):
                    input_items.append({"type": "message", "role": "user", "content": text.strip()})
            elif msg_type == "agent_message":
                text = _flatten_content(payload.get("content") or payload.get("text") or "")
                if text.strip() and not _is_harness(text):
                    input_items.append({"type": "message", "role": "assistant", "content": text.strip()})
            elif msg_type in ("context_compacted", "compacted"):
                compaction_points.append((len(input_items), peak_tokens))

        elif etype == "response_item":
            item_type = payload.get("type")
            if item_type == "message":
                role = payload.get("role", "assistant")
                if role in ("developer", "system"):
                    continue
                text = _flatten_content(payload.get("content") or "")
                if text.strip() and not _is_harness(text):
                    input_items.append({"type": "message", "role": role, "content": text.strip()})
            elif item_type == "reasoning":
                text = _flatten_content(payload.get("content") or payload.get("summary") or "")
                if text.strip():
                    input_items.append({"type": "message", "role": "assistant",
                                        "content": f"<think>\n{text.strip()}\n</think>"})
            elif item_type == "function_call":
                name = payload.get("name") or ""
                args = payload.get("arguments") or payload.get("input") or ""
                if isinstance(args, dict):
                    args = json.dumps(args)
                if name:
                    input_items.append({"type": "function_call", "name": name,
                                        "arguments": args,
                                        "call_id": payload.get("call_id") or payload.get("id") or ""})
            elif item_type == "function_call_output":
                output = payload.get("output") or ""
                if isinstance(output, dict):
                    output = json.dumps(output)
                if isinstance(output, str) and len(output) > 4000:
                    output = output[:2000] + "\n…[truncated]…\n" + output[-500:]
                input_items.append({"type": "function_call_output",
                                     "call_id": payload.get("call_id") or payload.get("id") or "",
                                     "output": output})

        elif etype == "compacted":
            compaction_points.append((len(input_items), peak_tokens))

    if len(input_items) < 4:
        return None
    est_tokens = sum(len(json.dumps(i)) // 4 for i in input_items)
    if est_tokens < MIN_TOKENS:
        return None

    return {
        "session_id": session_id,
        "source": "codex",
        "source_path": str(path),
        "cwd": cwd,
        "model_provider": model_provider,
        "item_count": len(input_items),
        "estimated_tokens": est_tokens,
        "peak_tokens": peak_tokens,
        "compaction_count": len(compaction_points),
        "compaction_points": compaction_points,
        "input_items": input_items,
    }


# ---------------------------------------------------------------------------
# Claude Code JSONL extractor
# ---------------------------------------------------------------------------

def extract_claude_session(path: Path) -> dict | None:
    """Parse one Claude Code project JSONL into a normalised corpus entry."""
    events = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        events.append(json.loads(line))
                    except json.JSONDecodeError:
                        pass
    except OSError:
        return None
    if not events:
        return None

    # Claude Code format: {"type": "user"/"assistant", "message": {"role":..., "content": [...]}}
    input_items = []
    thinking_count = 0
    tool_use_count = 0

    for event in events:
        etype = event.get("type")
        if etype not in ("user", "assistant"):
            continue
        msg = event.get("message") or {}
        role = msg.get("role") or etype
        content = msg.get("content") or []
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]

        for block in content:
            if not isinstance(block, dict):
                continue
            btype = block.get("type", "")

            if btype == "text":
                text = block.get("text", "")
                if text.strip() and not _is_harness(text):
                    input_items.append({"type": "message", "role": role, "content": text.strip()})

            elif btype == "thinking":
                thinking = block.get("thinking", "") or block.get("text", "")
                if thinking.strip():
                    thinking_count += 1
                    input_items.append({"type": "message", "role": "assistant",
                                        "content": f"<think>\n{thinking.strip()}\n</think>"})

            elif btype == "tool_use":
                name = block.get("name", "")
                inp = block.get("input", {})
                if isinstance(inp, dict):
                    inp = json.dumps(inp)
                tool_use_count += 1
                if name:
                    input_items.append({"type": "function_call", "name": name,
                                        "arguments": inp,
                                        "call_id": block.get("id", "")})

            elif btype == "tool_result":
                output = block.get("content", "") or ""
                if isinstance(output, list):
                    output = " ".join(p.get("text", "") for p in output if isinstance(p, dict))
                if isinstance(output, str) and len(output) > 4000:
                    output = output[:2000] + "\n…[truncated]…\n" + output[-500:]
                input_items.append({"type": "function_call_output",
                                     "call_id": block.get("tool_use_id", ""),
                                     "output": output})

    if len(input_items) < 4:
        return None
    if thinking_count < THINKING_BLOCK_MIN:
        return None  # Claude sessions without meaningful thinking aren't useful for concept analysis
    est_tokens = sum(len(json.dumps(i)) // 4 for i in input_items)
    if est_tokens < MIN_TOKENS:
        return None

    session_id = path.stem

    return {
        "session_id": session_id,
        "source": "claude",
        "source_path": str(path),
        "cwd": str(path.parent.name),  # project dir name
        "model_provider": "claude",
        "item_count": len(input_items),
        "estimated_tokens": est_tokens,
        "peak_tokens": 0,
        "thinking_block_count": thinking_count,
        "tool_use_count": tool_use_count,
        "compaction_count": 0,
        "compaction_points": [],
        "input_items": input_items,
    }


# ---------------------------------------------------------------------------
# Opencode SQLite extractor
# ---------------------------------------------------------------------------

def extract_opencode_sessions(db_path: Path) -> list[dict]:
    """
    Extract all qualifying sessions from an opencode SQLite database.

    Opencode stores conversation as typed parts linked to messages:
      text      → user or assistant prose
      reasoning → assistant thinking (ACTUAL content, not empty like Claude)
      tool      → tool invocation (name + state with input/output)
      patch     → code patch (treated as assistant message)
      compaction → marks where context was compacted; tail_start_id gives split point
      step-start/step-finish → lifecycle markers, skipped

    Returns a list of normalised session dicts (same schema as Codex extractor).
    """
    import sqlite3

    if not db_path.exists():
        return []

    results = []
    try:
        con = sqlite3.connect(str(db_path))
    except Exception:
        return []

    # Fetch all sessions with their directory
    sessions = con.execute(
        "SELECT id, directory, title FROM session"
    ).fetchall()

    for sess_id, directory, title in sessions:
        cwd = directory or ""

        # Fetch parts joined to messages for role info, ordered by creation time
        rows = con.execute("""
            SELECT p.id, m.id as msg_id, m.data as msg_data, p.data as part_data,
                   p.time_created
            FROM part p
            JOIN message m ON m.id = p.message_id
            WHERE p.session_id = ?
            ORDER BY p.time_created ASC
        """, (sess_id,)).fetchall()

        if not rows:
            continue

        input_items = []
        compaction_points = []  # list of (item_index, msg_id_at_tail)
        reasoning_count = 0
        peak_tokens = 0

        # Track the last user message text to avoid duplicating tool-call inputs
        for part_id, msg_id, msg_data_raw, part_data_raw, ts in rows:
            try:
                msg_data = json.loads(msg_data_raw) if msg_data_raw else {}
                part_data = json.loads(part_data_raw) if part_data_raw else {}
            except Exception:
                continue

            role = msg_data.get("role", "assistant")
            ptype = part_data.get("type", "")

            if ptype in ("step-start", "step-finish"):
                continue

            elif ptype == "text":
                text = part_data.get("text", "")
                if isinstance(text, str) and text.strip() and not _is_harness(text):
                    input_items.append({
                        "type": "message",
                        "role": role,
                        "content": text.strip(),
                    })

            elif ptype == "reasoning":
                text = part_data.get("text", "")
                if isinstance(text, str) and text.strip():
                    reasoning_count += 1
                    input_items.append({
                        "type": "message",
                        "role": "assistant",
                        "content": f"<think>\n{text.strip()}\n</think>",
                    })

            elif ptype == "tool":
                name = part_data.get("tool", "")
                state_raw = part_data.get("state", {})
                if isinstance(state_raw, str):
                    try:
                        state = json.loads(state_raw)
                    except Exception:
                        state = {"raw": state_raw}
                else:
                    state = state_raw or {}
                call_id = part_data.get("callID", "")
                inp = state.get("input", {})
                output = state.get("output", "")
                if isinstance(inp, dict):
                    inp = json.dumps(inp)
                if isinstance(output, str) and len(output) > 4000:
                    output = output[:2000] + "\n…[truncated]…\n" + output[-500:]
                if name:
                    input_items.append({
                        "type": "function_call",
                        "name": name,
                        "arguments": inp,
                        "call_id": call_id,
                    })
                if output:
                    input_items.append({
                        "type": "function_call_output",
                        "call_id": call_id,
                        "output": output,
                    })

            elif ptype == "patch":
                text = part_data.get("text", "") or part_data.get("patch", "")
                if isinstance(text, str) and text.strip():
                    input_items.append({
                        "type": "message",
                        "role": "assistant",
                        "content": f"[patch]\n{text.strip()}",
                    })

            elif ptype == "compaction":
                tail_msg_id = part_data.get("tail_start_id", "")
                compaction_points.append((len(input_items), tail_msg_id))

        if len(input_items) < 4:
            continue
        est_tokens = sum(len(json.dumps(i)) // 4 for i in input_items)
        if est_tokens < MIN_TOKENS:
            continue

        results.append({
            "session_id": str(sess_id),
            "source": "opencode",
            "source_path": str(db_path),
            "cwd": cwd,
            "title": title or "",
            "model_provider": "opencode",
            "item_count": len(input_items),
            "estimated_tokens": est_tokens,
            "peak_tokens": peak_tokens,
            "reasoning_count": reasoning_count,
            "compaction_count": len(compaction_points),
            "compaction_points": compaction_points,
            "input_items": input_items,
        })

    con.close()
    return results


# ---------------------------------------------------------------------------
# Curation filter
# ---------------------------------------------------------------------------

def cwd_slug(cwd: str) -> str:
    """Normalise cwd to a project slug for per-project caps."""
    # Strip home prefix; handle absolute paths outside home (e.g. /var/www/...)
    path = cwd.replace("/home/harri/", "").strip("/")
    # QuantZhai variants all count as one project
    if "turboquant" in path.lower() or "quantzhai" in path.lower():
        return "quantzhai"
    # Web server paths (/var/www/...) — use the site name, not "var"
    if path.startswith("var/www/"):
        parts = path.split("/")
        return parts[-1] if len(parts) > 3 else "web"
    parts = path.split("/")
    first = parts[0] if parts else "unknown"
    # Single-char dirs (~/h, etc.) are scratch — skip
    if len(first) <= 1:
        return "scratch"
    return first


def is_quantzhai(slug: str) -> bool:
    return slug == "quantzhai"


_SKIP_SLUGS = {"scratch", "tmp"}


def select_sessions(candidates: list[dict]) -> list[dict]:
    """
    Apply curation: diversity over volume.

    Priority order within each project (per source):
      1. Sessions with most reasoning content (reasoning_count desc) — opencode
      2. Sessions with most compaction events (ground truth pairs)
      3. Largest estimated token count (longest context)

    Caps per slug×source:
      - QUANTZHAI_MAX per source for quantzhai (already represented)
      - MAX_PER_PROJECT per source for other slugs
    """
    # Group by slug×source so caps apply per source independently
    by_slug_source = defaultdict(list)
    for c in candidates:
        slug = cwd_slug(c.get("cwd", ""))
        source = c.get("source", "codex")
        by_slug_source[(slug, source)].append(c)

    selected = []
    for (slug, source), sessions in sorted(by_slug_source.items()):
        if slug in _SKIP_SLUGS:
            print(f"  {slug:35s} [{source}]  {len(sessions):3d} → skipped (scratch/tmp)")
            continue
        cap = QUANTZHAI_MAX if is_quantzhai(slug) else MAX_PER_PROJECT
        # Sort priority: reasoning_count (opencode), then compactions, then size
        ranked = sorted(sessions, key=lambda s: (
            s.get("reasoning_count", 0),
            s.get("compaction_count", 0),
            s.get("estimated_tokens", 0),
        ), reverse=True)
        taken = ranked[:cap]
        rc_total = sum(s.get("reasoning_count", 0) for s in taken)
        rc_str = f" [🧠{rc_total}]" if rc_total else ""
        print(f"  {slug:30s} [{source:8s}] {len(sessions):3d} → {len(taken)}{rc_str}")
        selected.extend(taken)

    return selected


# ---------------------------------------------------------------------------
# Write output
# ---------------------------------------------------------------------------

def write_session(result: dict, output_dir: Path) -> None:
    session_id = result["session_id"]
    out = output_dir / session_id
    out.mkdir(parents=True, exist_ok=True)

    input_items = result.pop("input_items")
    compaction_points = result.get("compaction_points", [])

    with open(out / "input.json", "w") as f:
        json.dump(input_items, f, indent=2)
    with open(out / "meta.json", "w") as f:
        json.dump(result, f, indent=2)

    # First compaction split
    if compaction_points:
        first_ci, _ = compaction_points[0]
        with open(out / "pre-compact.json", "w") as f:
            json.dump(input_items[:first_ci], f, indent=2)
        with open(out / "post-compact.json", "w") as f:
            json.dump(input_items[first_ci:], f, indent=2)

    # Each compaction window (for multi-compaction sessions)
    for idx, (ci, tok) in enumerate(compaction_points):
        # Window: 50 items before this compaction point
        window_start = max(0, ci - 50)
        with open(out / f"compact_{idx:03d}.json", "w") as f:
            json.dump(input_items[window_start:ci], f, indent=2)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", default=str(DEFAULT_OUTPUT))
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    output_dir = Path(args.output)
    existing = {d.name for d in output_dir.iterdir()} if output_dir.exists() else set()

    # Discover session files from all sources.
    # Claude Code excluded: thinking blocks are empty strings.
    # Antigravity excluded: encrypted .pb format, no accessible schema.
    # Gemini history excluded: only .project_root marker files, no conversation.
    codex_sources = [
        ROOT / "var" / "codex-home" / "sessions",
        Path.home() / ".codex" / "sessions",
    ]
    opencode_dbs = [
        Path.home() / ".local" / "share" / "opencode" / "opencode.db",
    ]

    print("Scanning sources...")
    candidates = []

    for source_dir in codex_sources:
        if not source_dir.exists():
            continue
        files = sorted(source_dir.rglob("*.jsonl"))
        print(f"  {source_dir}: {len(files)} files (codex)")
        for path in files:
            if path.stem in existing and not args.dry_run:
                continue
            result = extract_codex_session(path)
            if result:
                candidates.append(result)

    for db_path in opencode_dbs:
        if not db_path.exists():
            continue
        print(f"  {db_path} (opencode SQLite)")
        oc_sessions = extract_opencode_sessions(db_path)
        # Skip already-extracted opencode sessions
        oc_sessions = [s for s in oc_sessions
                       if s["session_id"] not in existing or args.dry_run]
        print(f"    {len(oc_sessions)} qualifying opencode sessions")
        candidates.extend(oc_sessions)

    print(f"\n{len(candidates)} qualifying sessions before curation\n")
    print("Curation (per-project×source caps):")
    selected = select_sessions(candidates)

    print(f"\n{len(selected)} sessions selected\n")
    print(f"{'SOURCE':10} {'SLUG':28} {'EST_TOK':>9} {'COMPACT':>7} {'REASON':>7} {'ITEMS':>6}")
    print("-" * 75)
    for s in sorted(selected, key=lambda x: (cwd_slug(x['cwd']), x['source'],
                                              -x.get('estimated_tokens', 0))):
        slug = cwd_slug(s['cwd'])
        src = s['source']
        est = s.get('estimated_tokens', 0)
        compacts = s.get('compaction_count', 0)
        reasoning = s.get('reasoning_count', 0)
        items = s.get('item_count', 0)
        print(f"{src:10} {slug:28} {est:>9,} {compacts:>7} {reasoning:>7} {items:>6}")

    if not args.dry_run:
        print(f"\nWriting to {output_dir}...")
        for s in selected:
            write_session(s, output_dir)
        total_size = sum(
            f.stat().st_size
            for f in output_dir.rglob("*")
            if f.is_file()
        )
        print(f"Done. {len(selected)} sessions, {total_size // 1024 // 1024} MB total")


if __name__ == "__main__":
    main()
