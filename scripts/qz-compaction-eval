#!/usr/bin/env python3
"""
CLI script for running QuantZhai compaction evaluation.
"""

import sys
import os
import json
import argparse
from typing import List

# Ensure we can import from proxy
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from proxy.qz_compaction_eval import load_fixtures, run_eval, EvalResult

def render_table(results: List[EvalResult]):
    headers = ["Fixture", "Strategy", "Atoms", "Path", "Cmd", "Err", "Neg", "EvDec", "Stale", "Halluc", "Recov", "TknR"]
    print(f"{headers[0]:<25} {headers[1]:<18} {headers[2]:>6} {headers[3]:>6} {headers[4]:>6} {headers[5]:>6} {headers[6]:>6} {headers[7]:>6} {headers[8]:>6} {headers[9]:>7} {headers[10]:>6} {headers[11]:>6}")
    print("-" * 125)
    
    for r in results:
        m = r.metrics
        print(f"{r.fixture_name[:25]:<25} {r.strategy:<18} "
              f"{m['exact_atom_retention']:>6.2f} "
              f"{m['exact_path_retention']:>6.2f} "
              f"{m['exact_command_retention']:>6.2f} "
              f"{m['error_retention']:>6.2f} "
              f"{m['negation_retention']:>6.2f} "
              f"{m['evidence_decision_chain']:>6.2f} "
              f"{m['stale_fact_correction']:>6.2f} "
              f"{m['hallucinated_fact_rate']:>7.2f} "
              f"{m['downstream_recovery']:>6.2f} "
              f"{m['token_budget_ratio']:>6.2f}")

def render_aggregates(results: List[EvalResult]):
    print("\nAggregate Averages per Strategy:")
    headers = ["Strategy", "Atoms", "Path", "Cmd", "Err", "Neg", "EvDec", "Stale", "Halluc", "Recov", "TknR"]
    print(f"{headers[0]:<18} {headers[1]:>6} {headers[2]:>6} {headers[3]:>6} {headers[4]:>6} {headers[5]:>6} {headers[6]:>6} {headers[7]:>6} {headers[8]:>7} {headers[9]:>6} {headers[10]:>6}")
    print("-" * 90)
    
    strategy_metrics = {}
    for r in results:
        if r.strategy not in strategy_metrics:
            strategy_metrics[r.strategy] = []
        strategy_metrics[r.strategy].append(r.metrics)
        
    for strategy, metrics_list in sorted(strategy_metrics.items()):
        def avg(key):
            return sum(m[key] for m in metrics_list) / len(metrics_list)
        
        print(f"{strategy:<18} "
              f"{avg('exact_atom_retention'):>6.2f} "
              f"{avg('exact_path_retention'):>6.2f} "
              f"{avg('exact_command_retention'):>6.2f} "
              f"{avg('error_retention'):>6.2f} "
              f"{avg('negation_retention'):>6.2f} "
              f"{avg('evidence_decision_chain'):>6.2f} "
              f"{avg('stale_fact_correction'):>6.2f} "
              f"{avg('hallucinated_fact_rate'):>7.2f} "
              f"{avg('downstream_recovery'):>6.2f} "
              f"{avg('token_budget_ratio'):>6.2f}")

def main():
    parser = argparse.ArgumentParser(description="Run QuantZhai compaction evaluation.")
    parser.add_argument("--json", action="store_true", help="Output results as JSON")
    parser.add_argument("--fixtures", default="docs/fixtures/compaction", help="Path to fixtures directory")
    args = parser.parse_args()

    fixtures_dir = args.fixtures
    if not os.path.isabs(fixtures_dir):
        fixtures_dir = os.path.join(os.getcwd(), fixtures_dir)

    specs = load_fixtures(fixtures_dir)
    if not specs:
        print(f"No fixtures found in {fixtures_dir}")
        sys.exit(1)

    results = run_eval(specs)

    if args.json:
        # Convert to serializable format
        serializable_results = []
        for r in results:
            serializable_results.append({
                "fixture": r.fixture_name,
                "strategy": r.strategy,
                "metrics": r.metrics,
                "output_text": r.output_text
            })
        print(json.dumps(serializable_results, indent=2))
    else:
        print(f"QuantZhai Compaction Strategy Evaluation (n={len(specs)} fixtures)")
        print("=" * 125)
        render_table(results)
        render_aggregates(results)

if __name__ == "__main__":
    main()
